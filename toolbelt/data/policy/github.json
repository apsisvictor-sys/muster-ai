{
  "schemaVersion": 1,
  "provider": "github",
  "dryRunFlag": null,
  "read": [
    "^(browse|status|api-docs)(\\s|$)",
    "^(pr (checks|diff|view|list|status))(\\s|$)",
    "^(run (view|list|watch|download))(\\s|$)"
  ],
  "destructive": [
    "^(repo delete|release delete|gist delete|secret delete|variable delete|ssh-key delete|gpg-key delete|label delete|ruleset delete|cache delete)(\\s|$)"
  ],
  "blocked": [
    "^(auth|alias|config|extension)(\\s|$)"
  ],
  "secretReturning": [],
  "exact": {
    "repo clone": "mutate",
    "pr checkout": "mutate",
    "run download": "mutate",
    "actions": "read",
    "co": "mutate",
    "codespace code": "read",
    "codespace cp": "mutate",
    "codespace create": "mutate",
    "codespace edit": "mutate",
    "codespace jupyter": "read",
    "codespace ports forward": "mutate",
    "codespace ports visibility": "mutate",
    "codespace rebuild": "mutate",
    "codespace ssh": "mutate",
    "codespace stop": "mutate",
    "exit-codes": "mutate",
    "formatting": "mutate",
    "gist clone": "mutate",
    "gist create": "mutate",
    "gist edit": "mutate",
    "gist rename": "mutate",
    "gpg-key add": "sensitive",
    "issue close": "mutate",
    "issue comment": "mutate",
    "issue create": "mutate",
    "issue develop": "mutate",
    "issue edit": "mutate",
    "issue lock": "mutate",
    "issue pin": "mutate",
    "issue reopen": "mutate",
    "issue transfer": "mutate",
    "issue unlock": "mutate",
    "issue unpin": "mutate",
    "label clone": "mutate",
    "label create": "mutate",
    "label edit": "mutate",
    "mintty": "mutate",
    "pr close": "mutate",
    "pr comment": "mutate",
    "pr create": "mutate",
    "pr edit": "mutate",
    "pr lock": "mutate",
    "pr merge": "mutate",
    "pr ready": "mutate",
    "pr reopen": "mutate",
    "pr review": "mutate",
    "pr unlock": "mutate",
    "project close": "mutate",
    "project copy": "mutate",
    "project create": "mutate",
    "project edit": "mutate",
    "project item-add": "mutate",
    "project item-edit": "mutate",
    "project link": "mutate",
    "project unlink": "mutate",
    "reference": "mutate",
    "release create": "mutate",
    "release download": "read",
    "release edit": "mutate",
    "release upload": "mutate",
    "repo archive": "mutate",
    "repo create": "mutate",
    "repo deploy-key add": "mutate",
    "repo edit": "mutate",
    "repo fork": "mutate",
    "repo rename": "mutate",
    "repo sync": "mutate",
    "repo unarchive": "mutate",
    "run rerun": "mutate",
    "secret set": "sensitive",
    "ssh-key add": "sensitive",
    "variable set": "mutate",
    "workflow disable": "mutate",
    "workflow enable": "mutate",
    "workflow run": "mutate"
  },
  "httpMethodCommands": [
    "api"
  ]
}
