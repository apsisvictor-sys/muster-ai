#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawnSync } = require("node:child_process");
const { createHash } = require("node:crypto");
const surfaceLib = require("../lib/surface.js");
const policyLib = require("../lib/policy.js");
const mediaHub = require("../lib/media-hub.js");

// RS1 (§7 S9): code and data no longer share one root.
//   Code — this CLI's own package folder, so the `generated/` CLIs, the tracked
//   catalogs and the installed `node_modules/` below stay relative to this file
//   (RS2b moved `data/providers.json`, `data/links.json`, `data/policy/` and
//   `data/surface/` here with the code; RD3).
//   Data — PI_TOOLBELT_HOME, else the toolbelt folder in the agent folder:
//   `.env`, `data/accounts.json`, `data/ledger.jsonl`,
//   `data/identity-cache.json` and `state/` are personal data that stays put (RD3).
// The agent folder is `~/.pi/agent`, as before this seam: this entry point is a
// plain CommonJS CLI run by `node` (its shebang), and the `agentDir` port (S10)
// is a TypeScript module this process cannot load — Node's strip-only loader
// rejects `core/pi-ports.ts`, and a CommonJS require of the adapter fails even
// under tsx. The value is byte-identical for a checkout at `~/.pi/agent`, and
// RD4 leaves the toolbelt's own entry points without a port.
const CODE_ROOT = path.resolve(__dirname, "..");
const DATA_ROOT = process.env.PI_TOOLBELT_HOME || path.join(os.homedir(), ".pi", "agent", "toolbelt");
const DATA_DIR = path.join(DATA_ROOT, "data");
// RS2b: the tracked catalogs live with the code, so they are read from this
// package's own `data/`. A home that brings its own catalog directory — the
// fixture homes the fixture-isolated tests build under PI_TOOLBELT_HOME — still
// wins, so a run reads the catalog that home was seeded with.
const CATALOG_DIR = fs.existsSync(path.join(DATA_DIR, "policy")) ? DATA_DIR : path.join(CODE_ROOT, "data");
// Findings and the `scanned` list name files relative to the root that owns
// them, so the policy files stay recognisable wherever they are read from.
const relTo = (file) => path.relative(file.startsWith(path.join(CODE_ROOT, "data") + path.sep) ? CODE_ROOT : DATA_ROOT, file);
const LINKS_FILE = path.join(CATALOG_DIR, "links.json");
const ACCOUNTS_FILE = path.join(DATA_DIR, "accounts.json");
const PROVIDERS_FILE = path.join(CATALOG_DIR, "providers.json");
const LEDGER_FILE = path.join(DATA_DIR, "ledger.jsonl");
// SK6: while the vault supplies this process's keys (SK1's `run-as toolbelt`,
// which marks the child with `PI_SECRETS_CONSUMER`), the local `.env` is not a
// source at all. Before the section 13 cutover it is loaded exactly as before.
if (process.env.PI_SECRETS_CONSUMER !== "toolbelt") loadEnvFile(path.join(DATA_ROOT, ".env"));

const COMMANDS = ["discover", "refresh", "status", "call", "operation-meta", "accounts", "links", "link", "unlink", "ledger", "audit-secrets", "catalog-check", "inventory", "generate", "providers", "menu", "run", "refresh-surface", "find"];
