		resourceType: "railway_operation",
		adapter: "official_cli",
		operationClass: "mutating_network",
		mutating: true,
		required: ["--confirm-mutating", "--reason <non-empty>"],
		command: "railway",
		argv: redactArgv(cliArgs),
		message: reason || "Railway mutating/runtime operation is represented but not executed without explicit Toolbelt approval.",
	});
}

