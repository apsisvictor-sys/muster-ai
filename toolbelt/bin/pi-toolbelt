const SECRET_NAME_RE = /(api[_-]?key|private[_-]?key|signing[_-]?key|secret|token|password|passwd|authorization|bearer|credential)/i;
const SECRET_INPUT_KEY_RE = /^(?:(?:[a-z0-9]+[_-])*(?:api[_-]?key|private[_-]?key|signing[_-]?key|secret(?:[_-]?key)?|token|(?:access|auth|refresh|session|id)[_-]?token|password|passwd|passphrase|pass|pwd|authorization|bearer|credential(?:s)?))$/i;
const SECRET_PAIR_RE = /(?:^|[\s,{\[(&;?])["']?(?:api[_-]?key|private[_-]?key|signing[_-]?key|secret(?:[_-]?key)?|token|(?:access|auth|refresh|session|id)[_-]?token|password|passwd|authorization|bearer|credential(?:s)?)["']?\s*[:=]\s*["']?[^\s,;)}\]"']+/i;
const SECRET_PREFIX_RE = /(?:^|[^A-Za-z0-9])(?:sk-(?:test_|live_)?|sk_(?:test_|live_)?|rk_(?:test_|live_)?|whsec_|gh[pousr]_|github_pat_|glpat-|xox[baprs]-|AIza|ya29\.|AKIA|ASIA|re_|rw_|sntrys_|npm_|pypi-|hf_)[A-Za-z0-9_+./=-]*/;
const PRIVATE_KEY_RE = /-----BEGIN [A-Z ]*PRIVATE KEY-----/;
const SECRET_VALUE_RE = new RegExp(`${SECRET_PREFIX_RE.source}|${PRIVATE_KEY_RE.source}`);
const STORED_SECRET_VALUE_RE = /(sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9_]{16,}|xox[baprs]-[A-Za-z0-9-]{16,}|AIza[0-9A-Za-z_-]{16,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----)/;
const MIN_OPERATION_TIMEOUT_MS = 5_000;
const MAX_OPERATION_TIMEOUT_MS = 43_200_000;
const OPERATION_TIMEOUT_GRACE_MS = 15_000;
// Owner-level SQL goes over the Supabase Management API (the CLI has no such
// command), so it is named here rather than in the adapter's argv maps.
const SUPABASE_OWNER_SQL = "db-owner-sql";
const SUPABASE_OWNER_SQL_TIMEOUT_MS = 300_000;
let ACTIVE_DEADLINE_MS = null;
let ACTIVE_OPERATION_META = null;
let ACTIVE_ACCOUNT_CONTEXT = null;
let DRIFT_AT_STARTUP = false;

function canonicalProviderId(provider) {
	const value = String(provider || "").trim().toLowerCase();
	const aliases = {
		gh: "github", gws: "google-workspace", workspace: "google-workspace", ts: "tailscale",
		"audible-cli": "audible", "notebook-lm": "notebooklm", notebook: "notebooklm",
		"pixellab.ai": "pixellab", "pixel-lab": "pixellab", "runware.ai": "runware",
		"youtube-data": "youtube", "youtube-data-api": "youtube", "google-stitch": "stitch",
		portal: "portal-bg", portalbg: "portal-bg", "polymarket-trading-bot": "pally", "polymarket-bot": "pally",
		"studio-hub": "studio", claude: "claude-code", "claude-cli": "claude-code",
		agy: "antigravity", "gemini-cli": "antigravity",
		cf: "wrangler", r2: "wrangler", workers: "wrangler",
		"cloudflare-r2": "wrangler", secrets: "infisical", inf: "infisical",
	};
	return aliases[value] || value;
}

function readAccountRegistry() {
	const registry = readJson(ACCOUNTS_FILE, { version: 1, accounts: {}, projects: {} });
	return {
		version: 1,
		accounts: registry.accounts && typeof registry.accounts === "object" && !Array.isArray(registry.accounts) ? registry.accounts : {},
		projects: registry.projects && typeof registry.projects === "object" && !Array.isArray(registry.projects) ? registry.projects : {},
	};
}

function safeAccountAlias(value) {
	const alias = String(value || "").trim();
	return /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(alias) ? alias : null;
}

function resolveAccountContext(provider, parsed, args = {}) {
	const canonical = canonicalProviderId(provider);
	const registry = readAccountRegistry();
	const explicit = safeAccountAlias(parsed?.opts?.account || args.account);
	if ((parsed?.opts?.account || args.account) && !explicit) return { error: providerError(canonical, null, "invalid_account_alias", { expected: "1-64 chars: letters, numbers, dot, underscore, dash" }) };
	const project = String(parsed?.opts?.project || args.project || "").trim() || null;
	const projectEntry = project && registry.projects[project] && typeof registry.projects[project] === "object" ? registry.projects[project] : null;
	const projectBinding = projectEntry ? safeAccountAlias(projectEntry[canonical]) : null;
	if (projectEntry && !projectBinding && !explicit) {
		return { error: providerError(canonical, null, "project_provider_binding_missing", { project, provider: canonical, message: "This project is registered but has no binding for this provider. Bind it in accounts.json or pass --account explicitly; Toolbelt will not fall back to ambient credentials." }) };
	}
	if (explicit && projectBinding && explicit !== projectBinding) {
		return { error: providerError(canonical, null, "account_binding_mismatch", { project, requestedAccount: explicit, boundAccount: projectBinding, message: "Explicit account conflicts with the project's fail-closed provider binding." }) };
	}
	const alias = explicit || projectBinding;
	const providerAccounts = Object.entries(registry.accounts).filter(([, account]) => account && canonicalProviderId(account.provider) === canonical && account.enabled !== false);
	if (!alias) {
		if (providerAccounts.length > 1) return { error: providerError(canonical, null, "account_selection_required", { accounts: providerAccounts.map(([name]) => name), message: "Multiple provider accounts are registered; select an account or bind the project." }) };
		// Exactly one registered account IS the selection. Falling through to
		// ambient auth here was how a call could silently run as another login.
		if (providerAccounts.length === 1) return resolveAccountContext(canonical, { opts: { ...(parsed?.opts || {}), account: providerAccounts[0][0] } }, args);
		return { context: null };
	}
	const account = registry.accounts[alias];
	if (!account || typeof account !== "object") return { error: providerError(canonical, null, "account_not_found", { account: alias }) };
	if (canonicalProviderId(account.provider) !== canonical) return { error: providerError(canonical, null, "account_provider_mismatch", { account: alias, configuredProvider: account.provider }) };
	if (account.enabled === false) return { error: providerError(canonical, null, "account_disabled", { account: alias }) };
	const profile = safeAccountAlias(account.profile);
	if (!profile) return { error: providerError(canonical, null, "invalid_account_profile", { account: alias }) };
	if (args.profile && String(args.profile).trim() !== profile) return { error: providerError(canonical, null, "account_profile_mismatch", { account: alias, requestedProfile: String(args.profile).trim(), boundProfile: profile }) };
	return { context: { alias, provider: canonical, profile, project, source: explicit ? "explicit" : "project_binding", scope: account.scope ? String(account.scope) : null, expectedIdentity: account.expectedIdentity ? String(account.expectedIdentity) : null } };
}

function operationTimeoutMetadata(provider, operation, args = {}) {
	const canonicalProvider = canonicalProviderId(provider);
	const op = String(operation || "status");
	let adapterTimeoutMs = 60_000;
	if (["vercel", "railway", "github", "stripe", "resend", "google-workspace", "sentry", "tailscale", "pixellab", "studio"].includes(canonicalProvider)) adapterTimeoutMs = 60_000;
	if (canonicalProvider === "google-workspace" && op === "drive-folder-upload") adapterTimeoutMs = 1_200_000;
	if (["youtube", "runware"].includes(canonicalProvider)) adapterTimeoutMs = 120_000;
	if (canonicalProvider === "portal-bg") adapterTimeoutMs = op === "sync" ? 180_000 : (op === "search" ? 120_000 : 60_000);
	if (canonicalProvider === "pally") adapterTimeoutMs = ["shadow-live", "export-bundle"].includes(op) ? 120_000 : 90_000;
	if (canonicalProvider === "audible") adapterTimeoutMs = op === "library-list" ? 60_000 : 30_000;
	if (canonicalProvider === "notebooklm") {
		if (op.startsWith("download-")) adapterTimeoutMs = 600_000;
		else if (op.startsWith("generate-")) adapterTimeoutMs = 300_000;
		else if (op === "ask") adapterTimeoutMs = 180_000;
		else if (op.endsWith("-wait")) adapterTimeoutMs = Math.max(60_000, Math.min(Number(args.timeout) || 300, 1800) * 1000 + 15_000);
		else adapterTimeoutMs = 90_000;
	}
	if (canonicalProvider === "stitch") adapterTimeoutMs = op === "batch" ? 43_200_000 : (op === "generate" ? 420_000 : 90_000);
	// Owner SQL can carry long DDL (table re-ownership, index builds).
	if (canonicalProvider === "supabase" && op === SUPABASE_OWNER_SQL) adapterTimeoutMs = SUPABASE_OWNER_SQL_TIMEOUT_MS;
	adapterTimeoutMs = Math.max(MIN_OPERATION_TIMEOUT_MS, Math.min(adapterTimeoutMs, MAX_OPERATION_TIMEOUT_MS));
	return {
		provider: canonicalProvider || null,
		operation: op,
		adapterTimeoutMs,
		extensionTimeoutMs: Math.min(adapterTimeoutMs + OPERATION_TIMEOUT_GRACE_MS, MAX_OPERATION_TIMEOUT_MS + OPERATION_TIMEOUT_GRACE_MS),
		minTimeoutMs: MIN_OPERATION_TIMEOUT_MS,
		maxTimeoutMs: MAX_OPERATION_TIMEOUT_MS,
		deadlineVisible: true,
		abortPropagation: process.platform === "linux" ? "extension_signal_to_process_tree_pdeathsig" : "extension_signal_to_process",
	};
}

function providerCacheState() {
	return {
		version: 1,
		canonical: "PROVIDER_CATALOG",
		providers: PROVIDER_CATALOG,
		policy: {
			official_cli: "preferred",
			generated_cli: "fallback_after_spec",
			api_key_only: "generation_ready_or_needs_spec",
			secrets: "never_store_or_print_secret_values",
		},
	};
}

function ensureStorage() {
	fs.mkdirSync(DATA_DIR, { recursive: true, mode: 0o700 });
	// Only rewrite when the cache actually differs. Writing unconditionally cost
	// a full serialize on every invocation AND made catalog-check tautological:
	// it compared a file this function had just overwritten from the same source.
	// Record drift BEFORE self-healing, otherwise catalog-check can only ever
	// observe the file this function just rewrote from the same source.
	const defaultProviderState = providerCacheState();
	DRIFT_AT_STARTUP = catalogDrift();
	if (DRIFT_AT_STARTUP) writeJson(PROVIDERS_FILE, defaultProviderState);
	if (!fs.existsSync(LINKS_FILE)) writeJson(LINKS_FILE, { version: 1, links: [] });
	if (!fs.existsSync(ACCOUNTS_FILE)) writeJson(ACCOUNTS_FILE, { version: 1, accounts: {}, projects: {} });
	if (!fs.existsSync(LEDGER_FILE)) fs.writeFileSync(LEDGER_FILE, "", { mode: 0o600 });
}

function parseArgv(argv) {
	const flags = { json: false, agent: process.env.PI_TOOLBELT_AGENT || null };
	const opts = {};
	const positional = [];
	for (let i = 0; i < argv.length; i++) {
		const arg = argv[i];
		if (arg === "--") {
			positional.push(...argv.slice(i + 1));
			break;
		}
		if (arg === "--json") {
			flags.json = true;
			continue;
		}
		if (arg === "--agent") {
			if (argv[i + 1] && !argv[i + 1].startsWith("--")) flags.agent = argv[++i];
			else flags.agent = "agent";
			continue;
		}
		if (arg.startsWith("--")) {
			const eq = arg.indexOf("=");
			if (eq !== -1) {
				opts[arg.slice(2, eq)] = arg.slice(eq + 1);
			} else if (argv[i + 1] && !argv[i + 1].startsWith("--")) {
				opts[arg.slice(2)] = argv[++i];
			} else {
				opts[arg.slice(2)] = true;
			}
			continue;
		}
		positional.push(arg);
	}
	return { flags, opts, positional };
}

function loadEnvFile(file) {
	try {
		if (!fs.existsSync(file)) return;
		for (const line of fs.readFileSync(file, "utf8").split("\n")) {
			const trimmed = line.trim();
			if (!trimmed || trimmed.startsWith("#")) continue;
			const eq = trimmed.indexOf("=");
			if (eq <= 0) continue;
			const key = trimmed.slice(0, eq).trim();
			let value = trimmed.slice(eq + 1).trim();
			if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) value = value.slice(1, -1);
			if (/^[A-Z][A-Z0-9_]*$/.test(key) && process.env[key] === undefined) process.env[key] = value;
		}
	} catch {
		// Local env file is optional; never print values or fail Toolbelt startup for it.
	}
}

// ─── Secrets guard (SK6) ─────────────────────────────────────────────────────
// `plans/secrets/key-management-blueprint-2026-10-16.md` SK6. While the
// `toolbelt` consumer is on in `state/secrets/cutover.json`, an operation whose
// provider reads its credential from this process's env re-execs its own argv
// under SK1's `run-as toolbelt`, so the fetch has one owner and the vault's
// value wins: `run-as` rule 1 drops the inherited managed name before it
// injects the vault's.
//
// `infisical-agent cutover-state` (SK8) is the one reader of that file, and the
// file's own existence decides whether to ask at all, so a start before the
// section 13 cutover makes no `infisical-agent` call and behaves exactly as
// today. An unparseable file makes the reader exit 2 with its message, and the
// run is refused instead, because after C3 `off` is no longer a safe default.

/** The reader's state file, at the state root SK1's `run-as` uses. */
const CUTOVER_FILE = path.join(os.homedir(), ".pi", "agent", "state", "secrets", "cutover.json");
/** The commands that read a provider credential from this process's env. */
const ENV_TOKEN_COMMANDS = new Set(["run", "call", "status"]);
/** A catalog `envVars` name that is a credential the provider or its CLI reads. */
const ENV_TOKEN_NAME_RE = /(_TOKEN|_KEY)$/;
/**
 * Providers whose adapter reads a credential from the env although their catalog
 * entry lists no `envVars` name: Supabase swaps the account's
 * `SUPABASE_ACCESS_TOKEN[_<PROFILE>]` in `supabaseAccessToken`.
 */
const ADAPTER_ENV_TOKEN_PROVIDERS = new Set(["supabase"]);

/** Whether a provider's key can come from this process's env. */
function providerReadsEnvToken(provider) {
	if (ADAPTER_ENV_TOKEN_PROVIDERS.has(provider)) return true;
	const entry = PROVIDER_CATALOG.find((item) => item.id === provider);
	return Boolean(entry && Array.isArray(entry.envVars) && entry.envVars.some((name) => ENV_TOKEN_NAME_RE.test(name)));
}

/** The providers an invocation can read a credential for, from its own argv. */
function invocationEnvTokenProviders(parsed) {
	const command = parsed.positional[0];
	if (!ENV_TOKEN_COMMANDS.has(command)) return [];
	const named = canonicalProviderId(parsed.opts.provider || parsed.positional[1] || "");
	if (named) return [named];
	// A bare `status` probes every installed provider and the accounts bound to
	// it, so any of their env tokens can be read.
	return command === "status" ? PROVIDER_CATALOG.map((item) => item.id) : [];
}

/**
 * Whether the reader says the `toolbelt` consumer is on. A file that does not
 * parse refuses the run with the reader's message; any other failure (no reader
 * installed, an older wrapper without the verb) stays inert, as today.
 */
function toolbeltCutoverOn() {
	const result = spawnSync("infisical-agent", ["cutover-state", "toolbelt"], { encoding: "utf8" });
	if (result.status === 0 && String(result.stdout || "").trim() === "on") return true;
	const message = String(result.stderr || "").trim();
	if (result.status === 2 && message.includes("secrets:")) {
		process.stderr.write(`${message}\n`);
		process.exit(2);
	}
	return false;
}

/** SK6's guard: re-exec this argv under `run-as toolbelt` when the vault must supply the key. */
function maybeReexecUnderVault(parsed) {
	// The child this guard started carries the marker, so a call re-execs once.
	if (process.env.PI_SECRETS_CONSUMER === "toolbelt") return;
	if (!invocationEnvTokenProviders(parsed).some(providerReadsEnvToken)) return;
	if (!fs.existsSync(CUTOVER_FILE)) return;
	if (!toolbeltCutoverOn()) return;
	const child = spawnSync(
		"infisical-agent",
		["run-as", "toolbelt", "--", process.execPath, process.argv[1], ...process.argv.slice(2)],
		{ stdio: "inherit" },
	);
	process.exit(typeof child.status === "number" ? child.status : 1);
}

function readJson(file, fallback) {
	try {
		return JSON.parse(fs.readFileSync(file, "utf8"));
	} catch {
		return fallback;
	}
}

function writeJson(file, value) {
	fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
	fs.writeFileSync(file, `${JSON.stringify(redact(value), null, 2)}\n`, { mode: 0o600 });
}

function shouldRedactByKey(key, child) {
	if (key === "api_key_only" || key === "secrets" || key.startsWith("secretValues")) return false;
	if (!SECRET_NAME_RE.test(key)) return false;
	if (child === false || child === null || child === undefined || child === "[REDACTED]") return false;
	return true;
}

function redact(value) {
	if (Array.isArray(value)) return value.map(redact);
	if (value && typeof value === "object") {
		const out = {};
		for (const [key, child] of Object.entries(value)) {
			out[key] = shouldRedactByKey(key, child) ? "[REDACTED]" : redact(child);
		}
		return out;
	}
	if (typeof value === "string") {
		if (SECRET_VALUE_RE.test(value) || SECRET_PAIR_RE.test(value)) return "[REDACTED]";
	}
	return value;
}

function containsSecretValue(value) {
	return typeof value === "string" && (SECRET_VALUE_RE.test(value) || SECRET_PAIR_RE.test(value));
}

// Source scans avoid treating code placeholders and matcher literals as stored credentials.
// Structured persisted data still uses the stricter input detector above.
function containsStoredSourceSecret(value) {
	if (typeof value !== "string") return false;
	if (STORED_SECRET_VALUE_RE.test(value)) return true;
	const pair = value.match(SECRET_PAIR_RE);
	if (!pair) return false;
	const assignment = pair[0];
	const delimiter = Math.max(assignment.lastIndexOf(":"), assignment.lastIndexOf("="));
	const candidate = assignment.slice(delimiter + 1).trim().replace(/^[`'"{[]+|[`'"}\]]+$/g, "");
	if (!candidate || /^(?:f|r|u|b)?$/i.test(candidate)) return false;
	if (/^(?:Bearer\s*)?[$]?[{]|^(?:process\.)?env\b/i.test(candidate)) return false;
	if (/^[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*(?:\([^)]*\))?)*$/.test(candidate)) return false;
	return candidate.length >= 12 && /[A-Za-z]/.test(candidate) && /[0-9_+\-/=]/.test(candidate);
}

function isSecretInputKey(key) {
	// camelCase is split first: without this, `db_password` was rejected while
	// `dbPassword` and `pass` sailed through into argv.
	const normalized = String(key || "").replace(/^--?/, "").replace(/([a-z0-9])([A-Z])/g, "$1_$2");
	if (/^(?:max|min|input|output|cache|total|num|number|count)[_-]?tokens?$/i.test(normalized)) return false;
	if (/^token[_-]?(?:budget|count|limit|usage)$/i.test(normalized)) return false;
	return SECRET_INPUT_KEY_RE.test(normalized);
}

function hasSecretLikeObject(value) {
	if (Array.isArray(value)) return value.some(hasSecretLikeObject);
	if (value && typeof value === "object") {
		return Object.entries(value).some(([key, child]) => isSecretInputKey(key) || hasSecretLikeObject(child));
	}
	return containsSecretValue(String(value));
}

function hasSecretInput(parsed) {
	if (parsed.flags.agent && (containsSecretValue(String(parsed.flags.agent)) || !/^[A-Za-z0-9._-]{1,64}$/.test(String(parsed.flags.agent)))) return true;
	for (const [key, value] of Object.entries(parsed.opts)) {
		if (isSecretInputKey(key) || containsSecretValue(String(value))) return true;
		if (key === "args") {
			try {
				if (hasSecretLikeObject(JSON.parse(String(value)))) return true;
			} catch {
				// Non-JSON args are handled as strings above.
			}
		}
	}
	return parsed.positional.slice(1).some((value) => containsSecretValue(value));
}

function redactArgv(argv) {
	const out = [];
	let redactNext = false;
	for (const arg of argv) {
		if (redactNext) {
			out.push("[REDACTED]");
			redactNext = false;
			continue;
		}
		if (arg.startsWith("--")) {
			const [name, inline] = arg.split("=", 2);
			if (SECRET_NAME_RE.test(name)) {
				out.push(inline === undefined ? name : `${name}=[REDACTED]`);
				if (inline === undefined) redactNext = true;
				continue;
			}
		}
		out.push(redact(arg));
	}
	return out;
}

function ledgerIdentity(value) {
	if (value === undefined || value === null || value === "") return null;
	const text = String(value).trim();
	if (!text || containsSecretValue(text) || SECRET_NAME_RE.test(text) || /[?&](token|key|secret|password)=/i.test(text)) return "[REDACTED]";
	return `sha256:${createHash("sha256").update(text).digest("hex").slice(0, 16)}`;
}

function ledgerToken(value) {
	if (value === undefined || value === null || value === "") return null;
	const text = String(value).trim();
	return /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/.test(text) && !containsSecretValue(text) ? text : "[REDACTED]";
}

function ledgerOutcome(result) {
	// menu/providers return rendered text, not an envelope; reaching the caller
	// at all is success.
	if (typeof result === "string") return "success";
	if (result && result.ok === true) return "success";
	const status = String(result && (result.status || result.error) || "error");
	if (/approval|required|blocked|rejected|unsupported|invalid|missing|not_implemented/.test(status)) return "rejected";
	return "failed";
}

function adapterIdentity(result, kind) {
	const keys = kind === "account" ? new Set(["account", "accountid", "account_id"]) : new Set(["project", "projectid", "project_id"]);
	const roots = [[result && result.data, "data"], [result && result.cli && result.cli.json, "cli.json"]];
	const visit = (value, source, seen = new Set()) => {
		if (!value || typeof value !== "object" || seen.has(value)) return null;
		seen.add(value);
		for (const [key, child] of Object.entries(value)) {
			const childSource = `${source}.${key}`;
			if (keys.has(key.toLowerCase()) && ["string", "number"].includes(typeof child) && String(child).trim()) {
				return { value: child, source: `adapter:${childSource}` };
			}
			const nested = visit(child, childSource, seen);
			if (nested) return nested;
		}
		return null;
	};
	for (const [root, source] of roots) {
		const found = visit(root, source);
		if (found) return found;
	}
	return null;
}

function appendSecretRejectionLedger(startedAt) {
	const entry = {
		timestamp: new Date().toISOString(),
		outcome: "rejected",
		status: "secret_like_input_rejected",
		durationMs: Math.max(0, Date.now() - startedAt),
		exitClass: "policy_or_validation_rejection",
		errorClass: "secret_like_input_rejected",
	};
	fs.appendFileSync(LEDGER_FILE, `${JSON.stringify(entry)}\n`, { mode: 0o600 });
}

function appendLedger(command, parsed, result, startedAt, internalError = null) {
	if (command === "ledger" || command === "operation-meta") return;
	const args = parseArgsObject(parsed);
	const requestedProvider = ledgerToken(String(parsed.opts.provider || parsed.positional[1] || "").trim().toLowerCase());
	const requestedOperation = ledgerToken(String(parsed.opts.operation || parsed.opts.op || parsed.positional[2] || (command === "call" ? "status" : "")).trim());
	const status = ledgerToken(typeof result === "string" ? "success" : (result && (result.status || result.error)) || (internalError ? "internal_error" : "unknown"));
	const outcome = ledgerOutcome(result);
	const actualProvider = ledgerToken(result && result.provider || (requestedProvider && requestedProvider !== "[REDACTED]" ? canonicalProviderId(requestedProvider) : requestedProvider));
	const actualOperation = ledgerToken(result && result.operation || requestedOperation);
	const fallbackRoute = ledgerToken(result && (result.fallbackRoute || result.adapter) || (command === "call" ? "none" : null));
	const exitClass = ledgerToken(internalError ? "internal_error" : (outcome === "success" ? "success" : (outcome === "rejected" ? "policy_or_validation_rejection" : "provider_error")));
	const errorClass = ledgerToken(internalError ? "exception" : (outcome === "success" ? null : status));
	const requestedAccount = parsed.opts.account || args.account || args.accountId || args.account_id;
	const requestedProject = parsed.opts.project || args.project || args.projectId || args.project_id;
	const actualAccount = adapterIdentity(result, "account");
	const actualProject = adapterIdentity(result, "project");
	const entry = {
		timestamp: new Date().toISOString(),
		agent: ledgerToken(parsed.flags.agent) || "unknown",
		command: ledgerToken(command),
		requestedProvider,
		actualProvider,
		requestedOperation,
		actualOperation,
		outcome,
		status,
		durationMs: Math.max(0, Date.now() - startedAt),
		identity: {
			account: ledgerIdentity(actualAccount ? actualAccount.value : requestedAccount),
			accountSource: ledgerToken(actualAccount ? actualAccount.source : (requestedAccount ? "request:args" : null)),
			project: ledgerIdentity(actualProject ? actualProject.value : requestedProject),
			projectSource: ledgerToken(actualProject ? actualProject.source : (requestedProject ? (parsed.opts.project ? "request:option" : "request:args") : null)),
		},
		fallbackRoute,
		exitClass,
		errorClass,
	};
	fs.appendFileSync(LEDGER_FILE, `${JSON.stringify(redact(entry))}\n`, { mode: 0o600 });
}

function countLedger() {
	try {
		// Counting newlines beats parsing 16k JSON objects for a status field.
		const size = fs.statSync(LEDGER_FILE).size;
		if (size === 0) return 0;
		let count = 0;
		const fd = fs.openSync(LEDGER_FILE, "r");
		const buffer = Buffer.alloc(1 << 16);
		try {
			let bytes;
			while ((bytes = fs.readSync(fd, buffer, 0, buffer.length, null)) > 0) {
				for (let i = 0; i < bytes; i++) if (buffer[i] === 10) count++;
			}
		} finally {
			fs.closeSync(fd);
		}
		return count;
	} catch {
		return 0;
	}
}

function readLedger(limit = 50) {
	const text = fs.existsSync(LEDGER_FILE) ? fs.readFileSync(LEDGER_FILE, "utf8") : "";
	return text
		.split("\n")
		.filter(Boolean)
		.slice(-limit)
		.map((line) => {
			try {
				return JSON.parse(line);
			} catch {
				return { malformed: true };
			}
		});
}

function output(value, parsed) {
	const safe = redact(value);
	if (parsed.flags.json) {
		process.stdout.write(`${JSON.stringify(safe)}\n`);
		return;
	}
	if (typeof safe === "string") process.stdout.write(`${safe}\n`);
	else process.stdout.write(`${JSON.stringify(safe, null, 2)}\n`);
}


function boundedText(value, limit = 4000) {
	const text = String(value || "");
	const safe = redact(text);
	if (safe.length <= limit) return safe;
	return `${safe.slice(0, limit)}...[truncated:${safe.length - limit}]`;
}

function providerEnvelope(provider, operation, status, fields = {}) {
	const ok = fields.ok !== undefined ? Boolean(fields.ok) : status === "success";
	const policy = {
		operationClass: fields.operationClass || "read_only",
		mutating: Boolean(fields.mutating),
		secretValuesAccepted: false,
		valuesPrinted: false,
		...(fields.policy || {}),
	};
	return redact({
		ok,
		schemaVersion: 1,
		provider,
		operation: operation || null,
		status,
		policy,
		execution: ACTIVE_OPERATION_META ? {
			adapterTimeoutMs: ACTIVE_OPERATION_META.adapterTimeoutMs,
			extensionTimeoutMs: ACTIVE_OPERATION_META.extensionTimeoutMs,
			deadlineAt: ACTIVE_DEADLINE_MS ? new Date(ACTIVE_DEADLINE_MS).toISOString() : null,
			deadlineVisible: true,
			abortPropagation: ACTIVE_OPERATION_META.abortPropagation,
		} : undefined,
		valuesPrinted: false,
		...fields,
		ok,
		policy,
	});
}

function providerError(provider, operation, status, fields = {}) {
	return providerEnvelope(provider, operation, status, { ok: false, ...fields });
}

function catalogState() {
	return providerCacheState();
}

function stableJson(value) {
	if (Array.isArray(value)) return value.map(stableJson);
	if (value && typeof value === "object") {
		return Object.fromEntries(Object.entries(value).sort(([a], [b]) => a.localeCompare(b)).map(([key, child]) => [key, stableJson(child)]));
	}
	return value;
}

function catalogDrift() {
	const expected = stableJson(catalogState());
	const current = stableJson(readJson(PROVIDERS_FILE, {}));
	return JSON.stringify(expected) !== JSON.stringify(current);
}

function help() {
	return `pi-toolbelt — router to external service CLIs.

Find the command, then run it. You do not need to know the provider first.

  pi-toolbelt find "deployment logs"        search every provider by intent
  pi-toolbelt find "logs" --provider vercel search one provider
  pi-toolbelt providers                     list provider CLIs available here
  pi-toolbelt menu vercel                   one provider's whole command menu
  pi-toolbelt menu github pr                one group, for large CLIs
  pi-toolbelt run vercel -- logs --limit 50 run it

Everything after \`--\` goes to the provider CLI verbatim: whatever the CLI
supports, run supports, whether or not the cached menu lists it. Toolbelt
flags go BEFORE \`--\`; a provider flag that happens to share a Toolbelt name
is passed through unchanged.

run controls (before \`--\`):
  --cwd <dir>         run the provider CLI here (git needs it, or git's own
                      -C <dir>, so it cannot hit the wrong repository)
  --timeout-ms <ms>   kill the provider process after this long
  --deadline-ms <ms>  absolute deadline covering the identity preflight and
                      the command itself
  --stdin-file <path> feed this local file to the provider on stdin; the
                      bytes never enter output, argv or the ledger, and the
                      provider's raw output is withheld because it may echo
                      them. Files up to 16 MiB: that cap is a resource guard
                      (one shot of the whole file into memory), not a hidden
                      secret limit. For more, write the file where the
                      provider CLI reads it itself (its own --upload or
                      --env-file flag) instead of piping it in.

Classification is advisory, not a gate: menus and find label commands
read / mutate / destructive / sensitive so you can say what you are about to
do. Nothing is refused for a missing --confirm flag. "blocked" in an older
menu only means the curated alias does not execute it; the CLI is still
reachable through run.

Accounts: --account <alias> or --project <name>. With several accounts and no
selection Toolbelt fails closed and lists them. \`pi-toolbelt accounts\` shows
aliases and project bindings. A provider-level profile/config flag that would
select a different identity than the bound one is refused.

Secrets never go in a command. Toolbelt rejects secret-shaped arguments and
strips values from output; use the provider's own --env-file or stdin.

On failure the result carries \`hint\` naming the fix — act on it.

Other: accounts, ledger, status, refresh-surface, audit-secrets, catalog-check,
inventory, discover, links, link, unlink, call (legacy named operations).
Add --json for a structured envelope, --agent <name> for ledger attribution.`;
}

function cmdDiscover(parsed) {
	const providerState = readJson(PROVIDERS_FILE, { version: 1, providers: [] });
	const requested = canonicalProviderId(parsed.opts.provider || parsed.positional[1] || "");
	const providers = requested ? providerState.providers.filter((provider) => provider.id === requested) : providerState.providers;
	return {
		ok: requested ? providers.length === 1 : true,
		storage: DATA_ROOT,
		providers,
		commands: COMMANDS,
		catalog: { canonical: "PROVIDER_CATALOG", cache: PROVIDERS_FILE, generatedRegistry: false, generatedRegistryStatus: "not_configured" },
		hermes: { supportedViaCli: true, adapterImplemented: false },
		redaction: "strict",
	};
}

// Known auth probes for providers without a dedicated identity branch. Command
// output is never printed raw; only a boolean + optional first identity line.
const AUTH_PROBES = {
	vercel: ["whoami", "--non-interactive", "--no-color"],
	wrangler: ["whoami"],
	supabase: ["orgs", "list", "-o", "json"],
	resend: ["whoami", "--json"],
	github: ["api", "user", "--jq", ".login"],
	railway: ["whoami"],
};

// Providers with a verifyActiveAccountIdentity branch (true fail-closed proof).
const IDENTITY_BRANCH_PROVIDERS = new Set(["resend", "github", "supabase", "vercel", "wrangler"]);

function cachedIdentityMatchesPin(context, cached) {
	if (!context || !context.expectedIdentity) return true;
	const expected = [].concat(context.expectedIdentity).map((value) => String(value).toLowerCase());
	const observedList = String((cached && cached.observedIdentity) || "").split(",").filter(Boolean);
	return observedList.length > 0 && observedList.some((id) => expected.includes(id.toLowerCase()));
}

function infisicalLocalAuth() {
	let loginEmail = null;
	try {
		const config = JSON.parse(fs.readFileSync(path.join(os.homedir(), ".infisical", "infisical-config.json"), "utf8"));
		if (typeof config.loggedInUserEmail === "string" && config.loggedInUserEmail.includes("@")) loginEmail = config.loggedInUserEmail;
	} catch {}
	return { authenticated: loginEmail !== null, identity: loginEmail, source: loginEmail ? "config" : null };
}

function firstMeaningfulLine(stdout) {
	for (const line of String(stdout || "").split(/\r?\n/)) {
		const trimmed = line.trim();
		if (trimmed && !trimmed.startsWith("\u26ad") && !/^-+$/.test(trimmed)) return trimmed.slice(0, 80);
	}
	return null;
}

function probeProviderAccounts(canonical, accounts, fast) {
	// Per-account auth rows. Cache hits honored within TTL (pin re-checked);
	// live probes only when stale, and only for providers with a real identity
	// branch (fail-closed proof). Never prints secret values.
	const rows = [];
	for (const account of accounts) {
		const context = { alias: account.alias, provider: canonical, profile: account.profile, scope: account.scope, expectedIdentity: account.expectedIdentity };
		const cached = cachedIdentity(context);
		if (cached && cachedIdentityMatchesPin(context, cached)) {
			rows.push({ alias: account.alias, authenticated: true, identity: cached.observedIdentity, source: "cache" });
			continue;
		}
		if (fast) {
			rows.push({ alias: account.alias, authenticated: null, identity: (cached && cached.observedIdentity) || null, source: cached ? "stale-cache" : null });
			continue;
		}
		if (!IDENTITY_BRANCH_PROVIDERS.has(canonical)) {
			rows.push({ alias: account.alias, authenticated: null, identity: null, source: null });
			continue;
		}
		ACTIVE_ACCOUNT_CONTEXT = context;
		let identity;
		try {
			identity = verifyActiveAccountIdentity(context);
		} catch {
			identity = { ok: false, observedIdentity: null, reason: "probe_failed" };
		}
		ACTIVE_ACCOUNT_CONTEXT = null;
		if (identity.ok) {
			storeIdentity(context, identity.observedIdentity);
			rows.push({ alias: account.alias, authenticated: true, identity: identity.observedIdentity, source: "probe" });
		} else {
			rows.push({ alias: account.alias, authenticated: false, identity: identity.observedIdentity, source: "probe", reason: identity.reason });
		}
	}
	return rows;
}

function genericProviderStatus(canonical, parsed) {
	const entry = PROVIDER_CATALOG.find((item) => item.id === canonical);
	const cli = (entry && entry.cli) || canonical;
	const installed = commandExists(cli);
	let version = null;
	let auth = { authenticated: null, identity: null, source: null };
	if (installed) {
		const versionResult = runProviderCli(cli, ["--version"], { timeout: 15_000 });
		version = versionResult.ok ? firstMeaningfulLine(versionResult.stdout) : null;
		if (canonical === "infisical") auth = infisicalLocalAuth();
		else if (canonical === "vps") auth = { authenticated: Boolean(process.env.VPSHOST_API_KEY), identity: null, source: process.env.VPSHOST_API_KEY ? "env" : null };
		else if (AUTH_PROBES[canonical]) {
			const probe = runProviderCli(cli, AUTH_PROBES[canonical], { timeout: 30_000 });
			auth = { authenticated: Boolean(probe.ok), identity: probe.ok ? firstMeaningfulLine(probe.stdout) : null, source: "probe" };
		}
	}
	const registry = readAccountRegistry();
	const accounts = Object.entries(registry.accounts).filter(([, account]) => canonicalProviderId(account.provider) === canonical).map(([alias, account]) => ({ alias, profile: account.profile || null, identityPinned: account.expectedIdentity || null }));
	return {
		ok: true,
		provider: canonical,
		adapter: "generic",
		cli: { name: cli, installed, version, valuesPrinted: false },
		auth,
		accounts,
		note: "generic status (no curated adapter); auth via known probe",
	};
}

async function cmdStatus(parsed) {
	const provider = String(parsed.opts.provider || parsed.positional[1] || "").trim().toLowerCase();
	if (provider) {
		const canonical = canonicalProviderId(provider);
		const result = await callProvider(canonical, "status", {}, parsed);
		if (result && result.status === "adapter_not_implemented") return genericProviderStatus(canonical, parsed);
		return result;
	}
	// Global multi-provider decision surface: installed + auth + multi-account
	// + project bindings for every catalog provider. Account auth is re-probed
	// when the identity cache is stale (default), or skipped with --fast.
	const fast = parsed.opts.fast === true;
	const deep = parsed.opts.deep === true;
	const registry = readAccountRegistry();
	const accountsByProvider = {};
	for (const [alias, account] of Object.entries(registry.accounts || {})) {
		if (account.enabled === false) continue;
		const canonical = canonicalProviderId(account.provider);
		(accountsByProvider[canonical] = accountsByProvider[canonical] || []).push({ alias, profile: account.profile || null, scope: account.scope || null, expectedIdentity: account.expectedIdentity || null });
	}
	const projectsByProvider = {};
	for (const [project, bindings] of Object.entries(registry.projects || {})) {
		for (const [bindingProvider, alias] of Object.entries(bindings || {})) {
			const canonical = canonicalProviderId(bindingProvider);
			(projectsByProvider[canonical] = projectsByProvider[canonical] || []).push({ project, alias });
		}
	}
	const providers = [];
	for (const entry of PROVIDER_CATALOG) {
		const canonical = entry.id;
		const cli = entry.cli || canonical;
		const installed = commandExists(cli);
		const accounts = accountsByProvider[canonical] || [];
		const projects = projectsByProvider[canonical] || [];
		let auth = { authenticated: null, identity: null, source: null };
		if (installed && canonical === "infisical") {
			auth = infisicalLocalAuth();
		} else if (installed && canonical === "vps") {
			auth = { authenticated: Boolean(process.env.VPSHOST_API_KEY), identity: null, source: process.env.VPSHOST_API_KEY ? "env" : null };
		} else if (installed && accounts.length) {
			const rows = probeProviderAccounts(canonical, accounts, fast);
			for (const row of rows) {
				const accountRow = accounts.find((a) => a.alias === row.alias);
				if (accountRow) accountRow.auth = { authenticated: row.authenticated, identity: row.identity, source: row.source, reason: row.reason || null };
			}
			auth = { authenticated: rows.some((r) => r.authenticated === true) ? true : rows.length && rows.every((r) => r.authenticated === false) ? false : null, identity: (rows.find((r) => r.authenticated === true) || rows[0] || {}).identity || null, source: "accounts" };
		} else if (installed && (deep || cachedIdentity({ provider: canonical, profile: null })) && AUTH_PROBES[canonical]) {
			const probe = runProviderCli(cli, AUTH_PROBES[canonical], { timeout: 30_000 });
			auth = { authenticated: Boolean(probe.ok), identity: probe.ok ? firstMeaningfulLine(probe.stdout) : null, source: "probe" };
		}
		providers.push({
			id: canonical,
			installed,
			auth,
			accounts: accounts.map((account) => ({
				alias: account.alias,
				profile: account.profile,
				identityPinned: account.expectedIdentity,
				projects: projects.filter((p) => p.alias === account.alias).map((p) => p.project),
				auth: account.auth || { authenticated: null, identity: null, source: null },
			})),
		});
	}
	const links = readJson(LINKS_FILE, { links: [] }).links || [];
	const authenticatedCount = providers.filter((p) => p.auth && p.auth.authenticated === true).length;
	return {
		ok: true,
		mode: fast ? "fast" : "default",
		agent: parsed.flags.agent || "unknown",
		storage: { root: DATA_ROOT, data: DATA_DIR, links: LINKS_FILE, ledger: LEDGER_FILE },
		commands: COMMANDS,
		counts: { links: links.length, ledgerEntries: countLedger(), accounts: Object.keys(registry.accounts || {}).length },
		policies: readJson(PROVIDERS_FILE, { policy: {} }).policy,
		totals: { providers: providers.length, installed: providers.filter((p) => p.installed).length, authenticated: authenticatedCount, accounts: Object.keys(registry.accounts || {}).length },
		providers,
		redaction: { enabled: true, secretValuesPrinted: false, secretValuesStored: false },
	};
}

function cmdAccounts() {
	const registry = readAccountRegistry();
	return {
		ok: true,
		accounts: Object.entries(registry.accounts).map(([alias, account]) => ({ alias, provider: canonicalProviderId(account.provider), profile: account.profile || null, scope: account.scope || null, expectedIdentityConfigured: Boolean(account.expectedIdentity), enabled: account.enabled !== false })),
		projects: registry.projects,
		credentialsStored: false,
		valuesPrinted: false,
	};
}

function cmdLinks() {
	return { ok: true, links: readJson(LINKS_FILE, { links: [] }).links || [] };
}

function cmdLink(parsed) {
	const name = String(parsed.opts.name || parsed.positional[1] || "").trim();
	const target = String(parsed.opts.target || parsed.opts.url || parsed.opts.path || parsed.positional[2] || "").trim();
	const kind = String(parsed.opts.kind || "reference").trim();
	if (!name || !target) return { ok: false, error: "link_requires_name_and_target" };
	if (SECRET_NAME_RE.test(name) || containsSecretValue(target) || /[?&](token|key|secret|password)=/i.test(target)) {
		return { ok: false, error: "secret_like_link_rejected" };
	}
	const state = readJson(LINKS_FILE, { version: 1, links: [] });
	const entry = { name, target, kind, updatedAt: new Date().toISOString() };
	state.links = (state.links || []).filter((link) => link.name !== name);
	state.links.push(entry);
	writeJson(LINKS_FILE, state);
	return { ok: true, link: entry };
}

function cmdUnlink(parsed) {
	const name = String(parsed.opts.name || parsed.positional[1] || "").trim();
	if (!name) return { ok: false, error: "unlink_requires_name" };
	if (SECRET_NAME_RE.test(name) || containsSecretValue(name)) return { ok: false, error: "secret_like_link_rejected" };
	const state = readJson(LINKS_FILE, { version: 1, links: [] });
	const before = state.links || [];
	state.links = before.filter((link) => link.name !== name);
	writeJson(LINKS_FILE, state);
	return { ok: true, removed: before.length - state.links.length, name };
}

function cmdLedger(parsed) {
	const limit = Number(parsed.opts.limit || 50);
	return { ok: true, entries: readLedger(Number.isFinite(limit) ? Math.max(1, Math.min(limit, 1000)) : 50) };
}

function walkFiles(dir) {
	if (!fs.existsSync(dir)) return [];
	const out = [];
	for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
		if (entry.name === "__pycache__" || entry.name === "node_modules" || entry.name === ".git") continue;
		const full = path.join(dir, entry.name);
		if (entry.isDirectory()) out.push(...walkFiles(full));
		else if (entry.isFile() && !/\.(pyc|pyo|png|jpe?g|gif|webp|zip|gz|tar|sqlite|db)$/i.test(entry.name)) out.push(full);
	}
	return out;
}

function scanJsonValue(value, file, findings, trail = []) {
	if (Array.isArray(value)) {
		value.forEach((child, index) => scanJsonValue(child, file, findings, [...trail, String(index)]));
		return;
	}
	if (value && typeof value === "object") {
		for (const [key, child] of Object.entries(value)) {
			const childTrail = [...trail, key];
			if (SECRET_NAME_RE.test(key) && shouldRedactByKey(key, child)) findings.push({ file, path: childTrail.join("."), issue: "secret_shaped_key" });
			scanJsonValue(child, file, findings, childTrail);
		}
		return;
	}
	if (typeof value === "string" && containsSecretValue(value)) findings.push({ file, path: trail.join("."), issue: "secret_shaped_value" });
}

// Policy files legitimately contain secret-SHAPED keys: rule names like
// `secretReturning` and CLI command names like `secrets set`. They are
// classification config, never values. Rather than skip the directory, verify
// the file really is that schema, then scan its values only.
const POLICY_TOP_KEYS = new Set(["schemaVersion", "provider", "dryRunFlag", "read", "mutate", "destructive", "blocked", "secretReturning", "exact", "sanitize", "httpMethodCommands"]);
const POLICY_CLASS_VALUES = new Set(["read", "mutate", "destructive", "sensitive", "blocked", "namesOnly"]);

function isPolicyShaped(value) {
	if (!value || typeof value !== "object" || Array.isArray(value)) return false;
	for (const [key, child] of Object.entries(value)) {
		if (!POLICY_TOP_KEYS.has(key)) return false;
		if (key === "exact" || key === "sanitize") {
			if (!child || typeof child !== "object" || Array.isArray(child)) return false;
			if (!Object.values(child).every((entry) => POLICY_CLASS_VALUES.has(entry))) return false;
			continue;
		}
		if (Array.isArray(child) && !child.every((entry) => typeof entry === "string")) return false;
	}
	return true;
}

function scanPolicyValues(value, file, findings, trail = []) {
	if (Array.isArray(value)) {
		value.forEach((child, index) => scanPolicyValues(child, file, findings, [...trail, String(index)]));
		return;
	}
	if (value && typeof value === "object") {
		for (const [key, child] of Object.entries(value)) scanPolicyValues(child, file, findings, [...trail, key]);
		return;
	}
	if (typeof value === "string" && containsSecretValue(value)) findings.push({ file, path: trail.join("."), issue: "secret_shaped_value" });
}

function cmdAuditSecrets() {
	const findings = [];
	const scanRoots = [CATALOG_DIR, DATA_DIR, path.join(DATA_ROOT, "specs"), path.join(CODE_ROOT, "generated"), path.join(DATA_ROOT, "metadata")];
	const files = [...new Set(scanRoots.flatMap(walkFiles))];
	for (const file of files) {
		const rel = relTo(file);
		let text = "";
		try { text = fs.readFileSync(file, "utf8"); } catch { continue; }
		if (/\.json$/i.test(file)) {
			try {
				const parsed = JSON.parse(text);
				if (rel.startsWith(path.join("data", "policy") + path.sep) && isPolicyShaped(parsed)) scanPolicyValues(parsed, rel, findings);
				else scanJsonValue(parsed, rel, findings);
				continue;
			} catch { /* fall through to line scan */ }
		}
		if (/\.jsonl$/i.test(file)) {
			let parsedAll = true;
			text.split("\n").filter(Boolean).forEach((line, index) => {
				try { scanJsonValue(JSON.parse(line), rel, findings, [String(index + 1)]); } catch { parsedAll = false; }
			});
			if (parsedAll) continue;
		}
		text.split("\n").forEach((line, index) => {
			if (STORED_SECRET_VALUE_RE.test(line)) findings.push({ file: rel, line: index + 1, issue: "secret_shaped_value" });
			const pair = line.match(SECRET_PAIR_RE);
			const matcherSource = /\/\^?[^/]*(api[_-]?key|secret|token|password|authorization|bearer|credential)[^/]*\/[dgimsuvy]*\.(?:test|replace|match)\(/i.test(line);
			if (pair && !matcherSource && !/secretValuesAccepted["'\s:=]+false/i.test(line) && containsStoredSourceSecret(line)) findings.push({ file: rel, line: index + 1, issue: "secret_shaped_pair" });
		});
	}
	return { ok: findings.length === 0, scanned: scanRoots.filter(fs.existsSync).map((dir) => relTo(dir) || "."), findings, valuesPrinted: false, policy: { secretValuesAccepted: false } };
}

function cmdCatalogCheck() {
	const drift = DRIFT_AT_STARTUP;
	// Standing capability-completeness rule: every CLI leaf must be representable
	// and classified. A leaf that falls through to `default_unclassified` (no
	// policy file, no verb match) silently executes as `mutate`, which is a
	// capability that is being run without an explicit gate decision. Surfacing
	// those leaves lets a reviewer add a policy rule instead of leaving the
	// default gap in place. Read-only; never blocks execution.
	const coverage = allSurfaces().map(({ provider, surface }) => {
		const policy = providerPolicy(provider);
		const unclassified = policyLib.unclassified(policy, surface);
		return {
			provider,
			leaves: surface.leafCount ?? surface.leaves.length,
			unclassified,
		};
	});
	const totalLeaves = coverage.reduce((sum, row) => sum + row.leaves, 0);
	const unclassifiedLeaves = coverage.filter((row) => row.unclassified.length > 0);
	return {
		ok: !drift,
		canonical: "PROVIDER_CATALOG",
		cache: relTo(PROVIDERS_FILE),
		drift,
		providers: PROVIDER_CATALOG.map((provider) => provider.id),
		coverage: {
			checkedProviders: coverage.length,
			totalLeaves,
			unclassifiedLeaves: unclassifiedLeaves.reduce((sum, row) => sum + row.unclassified.length, 0),
			fullyClassifiedProviders: coverage.filter((row) => row.unclassified.length === 0).map((row) => row.provider),
			partialProviders: unclassifiedLeaves.map((row) => ({ provider: row.provider, unclassified: row.unclassified })),
		},
		generatedRegistry: false,
		generatedRegistryStatus: "not_configured",
		valuesPrinted: false,
		policy: { secretValuesAccepted: false },
	};
}

function normalizeProviderInventory(provider) {
	return {
		...provider,
		safeOperations: Array.isArray(provider.safeOperations) ? provider.safeOperations : [],
		mutatingOperations: Array.isArray(provider.mutatingOperations) ? provider.mutatingOperations : [],
	};
}

function cmdInventory() {
	const providers = PROVIDER_CATALOG.map(normalizeProviderInventory);
	return {
		ok: true,
		schemaVersion: 1,
		command: "inventory",
		canonical: "PROVIDER_CATALOG",
		providers,
		totalProviders: providers.length,
		implementedCount: providers.filter((provider) => String(provider.status).startsWith("implemented")).length,
		catalogDrift: DRIFT_AT_STARTUP,
		generatedRegistry: false,
		generatedRegistryStatus: "not_configured",
		valuesPrinted: false,
		policy: { secretValuesAccepted: false },
	};
}

function cmdOperationMeta(parsed) {
	const provider = String(parsed.opts.provider || parsed.positional[1] || "").trim().toLowerCase();
	const operation = String(parsed.opts.operation || parsed.opts.op || parsed.positional[2] || "status").trim();
	return { ok: true, schemaVersion: 1, ...operationTimeoutMetadata(provider, operation, parseArgsObject(parsed)), valuesPrinted: false };
}

function cmdGenerate(parsed) {
	const provider = String(parsed.opts.provider || parsed.positional[1] || "").trim();
	const spec = parsed.opts.spec ? path.resolve(String(parsed.opts.spec)) : null;
	const hasSpec = spec ? fs.existsSync(spec) : false;
	return {
		ok: true,
		provider: provider || null,
		status: hasSpec ? "generation_ready" : "needs_spec",
		action: "not_generated",
		policy: "Official CLI first; generated CLI second; API-key-only integrations require a spec before generation.",
		hermesAdapterImplemented: false,
	};
}

function parseArgsObject(parsed) {
	if (!parsed.opts.args) return {};
	try {
		const args = JSON.parse(String(parsed.opts.args));
		return args && typeof args === "object" && !Array.isArray(args) ? args : {};
	} catch {
		return {};
	}
}

// Availability is PATH/file-system resolution, never a `--version` spawn. The
// old spawn cost a subprocess for every provider on `providers`/`run` and made
// "installed" depend on the CLI answering a probe rather than existing.
function commandExists(command) {
	const name = String(command || "");
	if (!name) return false;
	if (name.includes(path.sep)) {
		try { fs.accessSync(name, fs.constants.X_OK); return true; } catch { return false; }
	}
	return Boolean(surfaceLib.resolveCliPath(name));
}

function spawnProviderSync(command, args, options) {
	if (process.platform !== "linux") return spawnSync(command, args, options);
	const parentDeathWrapper = [
		"import ctypes, os, signal, sys",
		"libc = ctypes.CDLL(None)",
		"libc.prctl(1, signal.SIGTERM)",
		"sys.exit(143) if os.getppid() == 1 else None",
		"os.execvpe(sys.argv[1], sys.argv[1:], os.environ)",
	].join("; ");
	return spawnSync("python3", ["-c", parentDeathWrapper, command, ...args], options);
}

// The one Supabase credential lookup. Both the CLI spawn below and the
// Management API path use it, so there is never a second source of truth: a
// bound account injects SUPABASE_ACCESS_TOKEN_<PROFILE> and fails closed when
// the variable is absent; an unbound call uses the ambient
// SUPABASE_ACCESS_TOKEN the CLI itself already reads.
function supabaseAccessToken(context) {
	if (!context || context.provider !== "supabase") {
		return { token: process.env.SUPABASE_ACCESS_TOKEN || null, varName: "SUPABASE_ACCESS_TOKEN", source: "ambient_env" };
	}
	const varName = `SUPABASE_ACCESS_TOKEN_${String(context.profile).toUpperCase().replace(/[^A-Z0-9]/g, "_")}`;
	return { token: process.env[varName] || null, varName, source: "account_profile" };
}

function runProviderCli(command, args, options = {}) {
	// Floor of 1 ms, not MIN_OPERATION_TIMEOUT_MS: a deadline-driven caller
	// passes the exact remaining milliseconds, and the old 5 s clamp overran
	// the deadline it was handed. Nothing is lost for the legacy call adapters:
	// they pass their own explicit timeout (>= 15 s) and
	// operationTimeoutMetadata floors the adapter budget at
	// MIN_OPERATION_TIMEOUT_MS before this point. The clamp only stops a caller
	// from disabling the timeout with 0.
	const requestedTimeout = Math.max(1, Math.min(Number(options.timeout) || 30_000, MAX_OPERATION_TIMEOUT_MS));
	const remainingMs = ACTIVE_DEADLINE_MS ? Math.max(1, ACTIVE_DEADLINE_MS - Date.now()) : requestedTimeout;
	const timeoutMs = Math.max(1, Math.min(requestedTimeout, remainingMs));
	const cliArgs = [...args];
	const childEnv = { ...process.env, ...surfaceLib.QUIET_ENV, ...(options.env || {}) };
	const context = ACTIVE_ACCOUNT_CONTEXT;
	if (context && command === "resend" && context.provider === "resend") {
		if (!cliArgs.includes("--profile") && !cliArgs.includes("-p")) cliArgs.push("--profile", context.profile);
		delete childEnv.RESEND_API_KEY;
		delete childEnv.RESEND_PROFILE;
	}
	if (context && command === "gh" && context.provider === "github") {
		childEnv.GH_CONFIG_DIR = path.join(os.homedir(), ".config", "pi-toolbelt", "accounts", "github", context.profile);
		delete childEnv.GH_TOKEN;
		delete childEnv.GITHUB_TOKEN;
	}
	if (context && command === "supabase" && context.provider === "supabase") {
		const credential = supabaseAccessToken(context);
		if (!credential.token) {
			return { command, argv: redactArgv(cliArgs), ok: false, exitCode: null, timedOut: false, signal: null, spawnError: null, jsonParsed: false,
				stdout: "", stderr: `missing ${credential.varName} for account ${context.alias}`, json: null, valuesPrinted: false };
		}
		childEnv.SUPABASE_ACCESS_TOKEN = credential.token;
	}
	if (context && command === "vercel" && context.provider === "vercel") {
		if (!cliArgs.includes("--global-config") && !cliArgs.includes("-Q")) cliArgs.push("--global-config", path.join(os.homedir(), ".config", "pi-toolbelt", "accounts", "vercel", context.profile));
		if (context.scope && !cliArgs.includes("--scope") && !cliArgs.includes("-S")) cliArgs.push("--scope", context.scope);
		delete childEnv.VERCEL_TOKEN;
	}
	// Cloudflare multi-account: inject a per-profile API token from the Toolbelt
	// .env (CLOUDFLARE_API_TOKEN_<PROFILE>), mirroring the Supabase pattern.
	// This covers BOTH Cloudflare surfaces — the official wrangler CLI and the
	// generated DNS CLI — so one account binding keeps them consistent.
	// No profile token -> fall through to the ambient OAuth login, which is how
	// wrangler-personal keeps working.
	if (context && (context.provider === "cloudflare" || (context.provider === "wrangler" && command === "wrangler"))) {
		const suffix = String(context.profile || "").toUpperCase().replace(/[^A-Z0-9]/g, "_");
		const token = process.env[`CLOUDFLARE_API_TOKEN_${suffix}`];
		if (token) {
			childEnv.CLOUDFLARE_API_TOKEN = token;
			const accountId = process.env[`CLOUDFLARE_ACCOUNT_ID_${suffix}`];
			if (accountId) childEnv.CLOUDFLARE_ACCOUNT_ID = accountId;
		}
	}
	const cliStartedAt = Date.now();
	const result = spawnProviderSync(command, cliArgs, {
		cwd: options.cwd || process.cwd(),
		input: options.input,
		encoding: "utf8",
		timeout: timeoutMs,
		maxBuffer: 1_000_000,
		env: childEnv,
	});
	const elapsedMs = Date.now() - cliStartedAt;
	const stdout = (result.stdout || "").trim();
	const stderr = (result.stderr || "").trim();
	// `jsonParsed` is tracked separately from `json`: JSON `false`, `0`, `""`
	// and `null` are valid parsed payloads whose value is falsy, and testing the
	// value instead of the parse dropped them (a sanitized provider read of
	// `false` lost both its data and its stdout).
	let json = null;
	let jsonParsed = false;
	if (stdout) {
		try { json = JSON.parse(stdout); jsonParsed = true; } catch { json = null; jsonParsed = false; }
	}
	// A killed-on-timeout child can surface as ETIMEDOUT, as a null exit with a
	// signal, or (rarely) as both. Classify all three as a timeout rather than
	// reporting a misleading provider_error or bare null exit.
	const timedOut = Boolean(result.error && result.error.code === "ETIMEDOUT")
		|| (result.status === null && Boolean(result.signal) && elapsedMs >= timeoutMs - 100);
	const spawnError = result.error && !timedOut ? (result.error.code || result.error.message || "spawn_error") : null;
	return redact({
		command,
		argv: redactArgv(cliArgs),
		exitCode: typeof result.status === "number" ? result.status : null,
		signal: result.signal || null,
		ok: result.status === 0,
		timedOut,
		timeoutMs,
		elapsedMs,
		spawnError,
		stdout: jsonParsed && !options.keepStdout ? undefined : boundedText(stdout),
		stderr: boundedText(stderr),
		json,
		jsonParsed,
		valuesPrinted: false,
	});
}

function verifyActiveAccountIdentity(context, cwd = undefined) {
	if (!context) return { ok: true, observedIdentity: null };
	const probeOptions = (timeout) => ({ timeout, cwd });
	if (context.provider === "resend") {
		const result = runProviderCli("resend", ["whoami", "--json"], probeOptions(15_000));
		const observedProfile = result.json && typeof result.json.profile === "string" ? result.json.profile : null;
		if (!result.ok || result.json?.authenticated !== true || observedProfile !== context.profile) return { ok: false, observedIdentity: observedProfile, reason: "resend_profile_not_authenticated" };
		return { ok: true, observedIdentity: observedProfile };
	}
	if (context.provider === "github") {
		const result = runProviderCli("gh", ["api", "user", "--jq", ".login"], probeOptions(15_000));
		const observed = result.ok && result.stdout ? String(result.stdout).trim() : null;
		if (!observed) return { ok: false, observedIdentity: null, reason: "github_profile_not_authenticated" };
		if (context.expectedIdentity && observed.toLowerCase() !== context.expectedIdentity.toLowerCase()) return { ok: false, observedIdentity: observed, reason: "identity_mismatch" };
		return { ok: true, observedIdentity: observed };
	}
	if (context.provider === "supabase") {
		const result = runProviderCli("supabase", ["orgs", "list", "-o", "json"], probeOptions(30_000));
		const orgs = Array.isArray(result.json) ? result.json : null;
		if (!result.ok || !orgs) return { ok: false, observedIdentity: null, reason: "supabase_account_not_authenticated" };
		const observed = orgs.map((org) => String(org.id || org.slug || "")).filter(Boolean);
		if (context.expectedIdentity) {
			const expected = [].concat(context.expectedIdentity).map((value) => String(value).toLowerCase());
			if (!observed.some((org) => expected.includes(org.toLowerCase()))) return { ok: false, observedIdentity: observed.join(","), reason: "identity_mismatch" };
		}
		return { ok: true, observedIdentity: observed.join(",") };
	}
	if (context.provider === "vercel") {
		const result = runProviderCli("vercel", ["whoami", "--non-interactive", "--no-color"], probeOptions(15_000));
		const observed = result.ok && result.stdout ? String(result.stdout).trim().split(/\r?\n/).pop() : null;
		if (!observed) return { ok: false, observedIdentity: null, reason: "vercel_profile_not_authenticated" };
		if (context.expectedIdentity && observed.toLowerCase() !== context.expectedIdentity.toLowerCase()) return { ok: false, observedIdentity: observed, reason: "identity_mismatch" };
		return { ok: true, observedIdentity: observed };
	}
	// Wrangler identity proof: whoami lists Account IDs as 32-hex strings; the
	// whoami probe itself inherits the injected CLOUDFLARE_API_TOKEN from the
	// routing branch above, so it proves the token's account, not ambient OAuth.
	if (context.provider === "wrangler") {
		const result = runProviderCli("wrangler", ["whoami"], probeOptions(30_000));
		const observed = result.ok && result.stdout ? Array.from(new Set(String(result.stdout).match(/[0-9a-f]{32}/g) || [])) : [];
		if (!observed.length) return { ok: false, observedIdentity: null, reason: "wrangler_account_not_authenticated" };
		if (context.expectedIdentity) {
			const expected = [].concat(context.expectedIdentity).map((value) => String(value).toLowerCase());
			if (!observed.some((id) => expected.includes(id.toLowerCase()))) return { ok: false, observedIdentity: observed.join(","), reason: "identity_mismatch" };
		}
		return { ok: true, observedIdentity: observed.join(",") };
	}
	// Generated Cloudflare DNS CLI: whoami reports the account ids the token can
	// act on (account-owned tokens list via /accounts). The probe inherits the
	// injected CLOUDFLARE_API_TOKEN from the routing branch, so it proves the
	// token's account, not ambient state.
	if (context.provider === "cloudflare") {
		const result = runProviderCli(path.join(CODE_ROOT, "generated", "cloudflare", "cloudflare"), ["whoami"], probeOptions(30_000));
		const rows = result.json && Array.isArray(result.json.data) ? result.json.data : [];
		const observed = rows.map((row) => String((row && row.id) || "")).filter((id) => /^[0-9a-f]{32}$/i.test(id));
		if (!observed.length) return { ok: false, observedIdentity: null, reason: "cloudflare_account_not_authenticated" };
		if (context.expectedIdentity) {
			const expected = [].concat(context.expectedIdentity).map((value) => String(value).toLowerCase());
			if (!observed.some((id) => expected.includes(id.toLowerCase()))) return { ok: false, observedIdentity: observed.join(","), reason: "identity_mismatch" };
		}
		return { ok: true, observedIdentity: observed.join(",") };
	}
	return { ok: true, observedIdentity: null };
}

function providerUnavailable(provider, cli, operation = "status") {
	return providerEnvelope(provider, operation, "unavailable", {
		ok: false,
		cli: { name: cli, installed: false, valuesPrinted: false },
		generation: "needs_spec",
	});
}

function envPresence(names) {
	return names.filter((name) => Boolean(process.env[name]));
}

function filePresence(paths) {
	return paths.map((file) => ({ path: file, exists: fs.existsSync(file), valuesPrinted: false }));
}

function providerResult(provider, operation, resourceType, result, options = {}) {
	return providerEnvelope(provider, operation, result.ok ? "success" : "error", {
		ok: Boolean(result.ok),
		resourceType,
		adapter: options.adapter || "official_cli",
		operationClass: options.operationClass || "read_only",
		mutating: Boolean(options.mutating),
		data: result.json ?? null,
		cli: result,
	});
}

function providerCompositeResult(provider, operation, resourceType, parts, options = {}) {
	const ok = Object.values(parts).every((part) => part && part.ok !== false);
	return providerEnvelope(provider, operation, ok ? "success" : "error", {
		ok,
		resourceType,
		adapter: options.adapter || "official_cli",
		operationClass: options.operationClass || "read_only",
		mutating: Boolean(options.mutating),
		data: parts,
	});
}

function requiredArg(args, names) {
	for (const name of names) {
		if (args[name] !== undefined && args[name] !== null && String(args[name]).trim()) return String(args[name]).trim();
	}
	return null;
}

function optionalString(args, name, target, flag) {
	if (args[name] !== undefined && args[name] !== null && String(args[name]).trim()) target.push(flag || `--${name}`, String(args[name]).trim());
}

function boundedLimit(value, fallback, max) {
	return String(Math.max(1, Math.min(Number(value) || fallback, max)));
}

function parseJsonLines(text) {
	const lines = String(text || "").split("\n").filter(Boolean);
	const out = [];
	for (const line of lines) {
		try { out.push(JSON.parse(line)); } catch { out.push({ message: line }); }
	}
	return out;
}

function parseMixedJsonObject(text) {
	const raw = String(text || "");
	const start = raw.indexOf("{");
	const end = raw.lastIndexOf("}");
	if (start === -1 || end === -1 || end <= start) return null;
	try { return JSON.parse(raw.slice(start, end + 1)); } catch { return null; }
}

function applyResultLimit(result, limit) {
	const max = Math.max(1, Math.min(Number(limit) || 100, 1000));
	if (Array.isArray(result.json) && result.json.length > max) {
		result.json = result.json.slice(0, max);
		result.truncated = true;
		result.returned = max;
	}
	return result;
}

function portalPath() {
	return process.env.PORTAL_CLI_PATH || path.join(os.homedir(), "projects", "portal-cli", "portal");
}

function addPortalSearchFlags(cliArgs, args, defaults = {}) {
	const city = args.city || defaults.city;
	if (city) cliArgs.push("--city", String(city));
	optionalString(args, "neighborhood", cliArgs, "--neighborhood");
	optionalString(args, "type", cliArgs, "--type");
	cliArgs.push("--pages", boundedLimit(args.pages ?? defaults.pages, defaults.pages || 1, 1000));
	optionalString(args, "minPrice", cliArgs, "--min-price");
	optionalString(args, "maxPrice", cliArgs, "--max-price");
	optionalString(args, "minSqm", cliArgs, "--min-sqm");
	optionalString(args, "maxSqm", cliArgs, "--max-sqm");
	if (args.rent) cliArgs.push("--rent");
}

function parsePortalCities(stdout) {
	return String(stdout || "").split("\n")
		.map((line) => line.trim())
		.filter((line) => line && !line.startsWith("CITY") && !line.startsWith("────"))
		.map((line) => {
			const parts = line.split(/\s{2,}/);
			return { city: parts[0] || line, slug: parts[1] || null };
		});
}

function parsePortalStats(stdout) {
	const text = String(stdout || "");
	const numberAfter = (label) => {
		const match = text.match(new RegExp(label + "\\s*:?\\s*€?\\s*([0-9]+)", "i"));
		return match ? Number(match[1]) : null;
	};
	const neighborhoods = [];
	for (const line of text.split("\n")) {
		const match = line.trim().match(/^(.+?)\s+([0-9]+)\s+€\s*([0-9]+)\s+€\s*([0-9]+)$/);
		if (match && !match[1].includes("Neighborhood")) {
			neighborhoods.push({ neighborhood: match[1].trim(), count: Number(match[2]), avgPriceEur: Number(match[3]), avgPricePerSqm: Number(match[4]) });
		}
	}
	return {
		listings: numberAfter("Listings"),
		avgPriceEur: numberAfter("Avg price"),
		medianPriceEur: numberAfter("Median price"),
		minPriceEur: numberAfter("Min price"),
		maxPriceEur: numberAfter("Max price"),
		avgPricePerSqm: numberAfter("Avg €/sqm"),
		neighborhoods,
	};
}

function parsePortalSync(stdout) {
	const text = String(stdout || "");
	const match = text.match(/Synced\s+([0-9]+)\s+listings\s+\(([0-9]+)\s+new\)\s+from\s+(.+)/i);
	return match ? { synced: Number(match[1]), newListings: Number(match[2]), city: match[3].trim() } : { message: text.trim() || null };
}

function isPortalListingUrl(value) {
	return /^https:\/\/www\.portal\.bg\/obiava-[A-Za-z0-9-]+/i.test(String(value || ""));
}

function vercelApproval(operation, cliArgs) {
	return providerEnvelope("vercel", operation, "approval_required", {
		ok: false,
		resourceType: "vercel_operation",
		adapter: "official_cli",
		operationClass: "mutating_network",
		mutating: true,
		required: ["--confirm-mutating", "--reason <non-empty>"],
		command: "vercel",
		argv: redactArgv(cliArgs),
		message: "Vercel mutating operation is represented but not executed without explicit Toolbelt approval.",
	});
}

function callVercel(operation, args, confirmed = false) {
	const safeOperations = ["status", "list-projects", "list-deployments", "inspect-deployment", "logs", "domains", "domain-inspect", "env-list", "teams", "blob-list", "blob-get", "blob-get-store"];
	const mutating = {
		deploy: ["deploy"],
		"alias-set": ["alias", "set"],
		"env-add": ["env", "add"],
		"env-remove": ["env", "remove"],
		"env-update": ["env", "update"],
		"env-pull": ["env", "pull"],
		"env-run": ["env", "run"],
		"domain-add": ["domains", "add"],
		"domain-buy": ["domains", "buy"],
		"domain-move": ["domains", "move"],
		"domain-transfer-in": ["domains", "transfer-in"],
		"domain-remove": ["domains", "remove"],
		"team-add": ["teams", "add"],
		"team-invite": ["teams", "invite"],
		"team-switch": ["teams", "switch"],
		"blob-put": ["blob", "put"],
		"blob-del": ["blob", "del"],
		"blob-copy": ["blob", "copy"],
		"blob-create-store": ["blob", "create-store"],
		"blob-delete-store": ["blob", "delete-store"],
	};
	const known = [...safeOperations, ...Object.keys(mutating)];
	const approvedExecution = confirmed && (operation === "deploy" || operation === "alias-set" || (operation === "env-add" && Boolean(args.secretFile)) || operation === "env-remove");
	if (mutating[operation] && !approvedExecution) return vercelApproval(operation, mutating[operation]);
	if (!safeOperations.includes(operation) && operation !== "deploy" && operation !== "alias-set" && operation !== "env-add" && operation !== "env-remove") return unsupportedOperation("vercel", operation, known);
	if (operation === "alias-set") {
		const deployment = requiredArg(args, ["deployment", "deploymentId", "url"]);
		const alias = requiredArg(args, ["alias", "domain", "hostname"]);
		if (!deployment || !alias) return providerError("vercel", operation, "missing_required_arg", { required: ["deployment|deploymentId|url", "alias|domain|hostname"] });
		return providerResult("vercel", operation, "alias", runProviderCli("vercel", ["alias", "set", deployment, alias, "--non-interactive", "--no-color"]));
	}
	if (operation === "env-remove") {
		const cwd = String(args.cwd || "").trim();
		const name = String(args.name || "").trim();
		const environment = String(args.environment || "").trim();
		if (!cwd || !name || !environment) return providerError("vercel", operation, "missing_required_arg", { required: ["cwd", "name", "environment"] });
		let removeCwd;
		try {
			removeCwd = fs.realpathSync(cwd);
			if (!fs.statSync(removeCwd).isDirectory()) throw new Error("not_directory");
		} catch {
			return providerError("vercel", operation, "cwd_not_directory", { cwd });
		}
		const result = runProviderCli("vercel", ["env", "rm", name, environment, "--yes", "--non-interactive", "--no-color"], { cwd: removeCwd, timeout: 60_000 });
		return providerResult("vercel", operation, "environment_variable", result);
	}
	if (operation === "env-add") {
		const cwd = String(args.cwd || "").trim();
		const name = String(args.name || "").trim();
		const environment = String(args.environment || "").trim();
		const secretFile = String(args.secretFile || "").trim();
		if (!cwd || !name || !environment || !secretFile) return providerError("vercel", operation, "missing_required_arg", { required: ["cwd", "name", "environment", "secretFile"] });
		if (!/^[A-Z][A-Z0-9_]*$/.test(name)) return providerError("vercel", operation, "invalid_environment_variable_name", { name });
		if (!["production", "preview", "development"].includes(environment)) return providerError("vercel", operation, "invalid_environment", { environment });
		let sourcePath;
		try {
			sourcePath = fs.realpathSync(secretFile);
			if (!fs.statSync(sourcePath).isFile()) throw new Error("not_file");
		} catch {
			return providerError("vercel", operation, "secret_file_not_found", { secretFile });
		}
		let value = "";
		try {
			const raw = fs.readFileSync(sourcePath, "utf8");
			if (args.sourceJsonPath) {
				let current = JSON.parse(raw);
				for (const segment of String(args.sourceJsonPath).split(".")) current = current?.[segment];
				value = typeof current === "string" ? current : "";
			} else {
				const sourceKey = String(args.sourceKey || name).trim();
				const line = raw.split(/\r?\n/).find((candidate) => candidate.startsWith(`${sourceKey}=`));
				value = line ? line.slice(sourceKey.length + 1).trim() : "";
				if ((value.startsWith("\"") && value.endsWith("\"")) || (value.startsWith("'") && value.endsWith("'"))) value = value.slice(1, -1);
			}
		} catch {
			return providerError("vercel", operation, "secret_file_parse_failed", { secretFile });
		}
		if (!value || /[\r\n]/.test(value)) return providerError("vercel", operation, "secret_value_missing_or_multiline", { name });
		let deployCwd;
		try {
			deployCwd = fs.realpathSync(cwd);
			if (!fs.statSync(deployCwd).isDirectory()) throw new Error("not_directory");
		} catch {
			return providerError("vercel", operation, "cwd_not_directory", { cwd });
		}
		const result = runProviderCli("vercel", ["env", "add", name, environment, "--sensitive", "--force", "--yes", "--non-interactive", "--no-color"], { cwd: deployCwd, input: value, timeout: 60_000 });
		return providerResult("vercel", operation, "environment_variable", result);
	}
	if (operation === "deploy") {
		const cwd = String(args.cwd || "").trim();
		if (!cwd) return providerError("vercel", operation, "missing_required_arg", { required: ["cwd"] });
		let deployCwd;
		try {
			deployCwd = fs.realpathSync(cwd);
			if (!fs.statSync(deployCwd).isDirectory()) throw new Error("not_directory");
		} catch {
			return providerError("vercel", operation, "cwd_not_directory", { cwd });
		}
		const cliArgs = ["deploy", ".", "--yes", "--non-interactive", "--no-color"];
		if (args.noWait === true) cliArgs.push("--no-wait");
		optionalString(args, "target", cliArgs, "--target");
		optionalString(args, "project", cliArgs, "--name");
		const result = runProviderCli("vercel", cliArgs, { cwd: deployCwd, timeout: 180_000 });
		if (!result.json && result.stdout) {
			const url = result.stdout.split(/\s+/).find((value) => /^https?:\/\//i.test(value));
			result.json = { deploymentUrl: url || null };
		}
		return providerResult("vercel", operation, "deployment", result);
	} 
	if (!commandExists("vercel")) return providerUnavailable("vercel", "vercel", operation);
	if (operation === "status") {
		const version = runProviderCli("vercel", ["--version"]);
		const whoami = runProviderCli("vercel", ["whoami", "--non-interactive", "--no-color"]);
		return providerCompositeResult("vercel", operation, "account_status", { version, whoami });
	}
	if (operation === "list-projects") return providerResult("vercel", operation, "projects", runProviderCli("vercel", ["api", "/v9/projects", "--non-interactive", "--no-color"]));
	if (operation === "list-deployments") {
		const cliArgs = ["list", "--format", "json", "--yes", "--non-interactive", "--no-color"];
		if (args.project) cliArgs.splice(1, 0, String(args.project));
		return providerResult("vercel", operation, "deployments", runProviderCli("vercel", cliArgs));
	}
	if (operation === "inspect-deployment") {
		const deployment = requiredArg(args, ["deployment", "deploymentId", "url"]);
		if (!deployment) return providerError("vercel", operation, "missing_required_arg", { required: ["deployment|deploymentId|url"] });
		const cliArgs = ["inspect", deployment, "--non-interactive", "--no-color"];
		if (args.logs === true) cliArgs.push("--logs");
		else cliArgs.push("--format", "json");
		return providerResult("vercel", operation, "deployment", runProviderCli("vercel", cliArgs));
	}
	if (operation === "logs") {
		const cliArgs = ["logs", "--json", "--no-follow", "--non-interactive", "--no-color", "--limit", boundedLimit(args.limit, 50, 200)];
		const deployment = requiredArg(args, ["deployment", "deploymentId", "url"]);
		if (deployment) cliArgs.splice(1, 0, deployment);
		optionalString(args, "project", cliArgs, "--project");
		optionalString(args, "since", cliArgs, "--since");
		optionalString(args, "level", cliArgs, "--level");
		const result = runProviderCli("vercel", cliArgs, { timeout: 45_000 });
		if (!result.json && result.stdout) result.json = parseJsonLines(result.stdout);
		return providerResult("vercel", operation, "logs", result);
	}
	if (operation === "domains") {
		const result = runProviderCli("vercel", ["domains", "list", "--format", "json", "--non-interactive", "--no-color"], { timeout: 45_000 });
		if (!result.json && result.stdout) result.json = parseMixedJsonObject(result.stdout);
		return providerResult("vercel", operation, "domains", result);
	}
	if (operation === "domain-inspect") {
		const domain = requiredArg(args, ["domain", "name"]);
		if (!domain) return providerError("vercel", operation, "missing_required_arg", { required: ["domain|name"] });
		return providerResult("vercel", operation, "domain", runProviderCli("vercel", ["domains", "inspect", domain, "--non-interactive", "--no-color"], { timeout: 45_000 }));
	}
	if (operation === "env-list") {
		const cliArgs = ["env", "list"];
		const environment = requiredArg(args, ["environment"]);
		const gitBranch = requiredArg(args, ["gitBranch", "git_branch"]);
		if (environment) cliArgs.push(environment);
		if (gitBranch) cliArgs.push(gitBranch);
		cliArgs.push("--format", "json", "--non-interactive", "--no-color");
		const cwd = String(args.cwd || "").trim();
		let envCwd;
		if (cwd) {
			try {
				envCwd = fs.realpathSync(cwd);
				if (!fs.statSync(envCwd).isDirectory()) throw new Error("not_directory");
			} catch {
				return providerError("vercel", operation, "cwd_not_directory", { cwd });
			}
		}
		const result = runProviderCli("vercel", cliArgs, { cwd: envCwd, timeout: 45_000 });
		if (!result.json && result.stdout) result.json = parseMixedJsonObject(result.stdout);
		return providerResult("vercel", operation, "environment_variables", result);
	}
	if (operation === "teams") {
		const result = runProviderCli("vercel", ["teams", "list", "--format", "json", "--non-interactive", "--no-color"], { timeout: 45_000 });
		if (!result.json && result.stdout) result.json = parseMixedJsonObject(result.stdout);
		return providerResult("vercel", operation, "teams", result);
	}
	if (operation === "blob-list") {
		const cliArgs = ["blob", "list", "--non-interactive", "--no-color", "--limit", boundedLimit(args.limit, 10, 1000)];
		optionalString(args, "prefix", cliArgs, "--prefix");
		optionalString(args, "cursor", cliArgs, "--cursor");
		if (["folded", "expanded"].includes(String(args.mode || ""))) cliArgs.push("--mode", String(args.mode));
		return providerResult("vercel", operation, "blob_list", runProviderCli("vercel", cliArgs, { timeout: 45_000 }));
	}
	if (operation === "blob-get") {
		const target = requiredArg(args, ["url", "pathname", "urlOrPathname"]);
		if (!target) return providerError("vercel", operation, "missing_required_arg", { required: ["url|pathname|urlOrPathname"] });
		return providerResult("vercel", operation, "blob", runProviderCli("vercel", ["blob", "get", target, "--non-interactive", "--no-color"], { timeout: 45_000 }));
	}
	if (operation === "blob-get-store") {
		const cliArgs = ["blob", "get-store"];
		const storeId = requiredArg(args, ["storeId", "store_id", "id"]);
		if (storeId) cliArgs.push(storeId);
		cliArgs.push("--non-interactive", "--no-color");
		return providerResult("vercel", operation, "blob_store", runProviderCli("vercel", cliArgs, { timeout: 45_000 }));
	}
}

function sanitizeRailwayVariables(json) {
	if (!json || typeof json !== "object") return json;
	const source = Array.isArray(json) ? json : Object.entries(json).map(([name, value]) => ({ name, value }));
	return source.map((item) => {
		if (!item || typeof item !== "object") return item;
		const name = item.name || item.key || item.variable || null;
		return { name, valueRedacted: item.value !== undefined || item.defaultValue !== undefined, valuesPrinted: false };
	});
}

