		ok: false,
		resourceType: "supabase_operation",
		adapter: "official_cli",
		operationClass: "mutating_network",
		mutating: true,
		required: ["--confirm-mutating", "--reason <non-empty>"],
		command: "supabase",
		argv: redactArgv(cliArgs),
		message: reason || "Supabase mutating operation is represented but not executed without explicit Toolbelt approval.",
	});
}

/**
 * Supabase Management API adapter.
 *
 * Auth is ambient: the CLI reads SUPABASE_ACCESS_TOKEN, else ~/.supabase/access-token.
 * The CLI does expose a --profile flag, but it resolves against a config file whose
 * format Supabase does not document and which does not exist here; until that is
 * settled, this adapter is single-account and does NOT strip the ambient token.
 * Project-scoped reads take --project-ref; `projects`/`orgs`/`snippets` are global.
 * Owner-level SQL (`db-owner-sql`) is the one operation that goes over the
 * Management API instead of the CLI; it shares the CLI adapter's credential
 * path rather than introducing a second one.
 */

/**
 * Owner-level SQL over the Management API.
 *
 * `POST /v1/projects/<ref>/database/query` executes as the `postgres` owner,
 * which is the only way to change objects the application role does not own —
 * re-owning Prisma tables so `prisma migrate` can run, for example. It can
 * therefore alter or drop production data, so it is classified destructive and
 * gated like every other mutating operation.
 *
 * The credential comes from supabaseAccessToken(): the same account/profile
 * injection the CLI path uses, never a second lookup. The token stays in
 * process memory — it is not passed through argv, the result envelope or the
 * ledger.
 */
const SUPABASE_MANAGEMENT_API_DEFAULT = "https://api.supabase.com";

// The host is fixed in production. SUPABASE_API_URL exists so the offline test
// can point this at a local fixture; an unusable override is refused rather
// than ignored, so a bad value can never fall through to the live endpoint.
function supabaseApiBaseUrl() {
	const raw = String(process.env.SUPABASE_API_URL || "").trim();
	if (!raw) return { url: SUPABASE_MANAGEMENT_API_DEFAULT };
	try {
		const parsed = new URL(raw);
		if (parsed.protocol !== "http:" && parsed.protocol !== "https:") return { error: "invalid_supabase_api_url" };
		return { url: parsed.toString().replace(/\/$/, "") };
	} catch {
		return { error: "invalid_supabase_api_url" };
	}
}

function supabaseOwnerSqlApproval(message) {
	return providerEnvelope("supabase", SUPABASE_OWNER_SQL, "approval_required", {
		ok: false,
		resourceType: "supabase_owner_sql",
		adapter: "management_api",
		operationClass: "destructive",
		mutating: true,
		required: ["--confirm-mutating", "--reason <non-empty>"],
		endpoint: "/v1/projects/<projectRef>/database/query",
		// Deliberately no command/argv: the dispatcher completes approval
		// envelopes that carry a CLI argv, and owner SQL has no CLI command.
		message: message || "Owner SQL runs as the project owner and can alter or drop production data; explicit mutating approval and reason are required.",
	});
}

async function supabaseOwnerSql(args, parsed) {
	const projectRef = requiredArg(args, ["projectRef", "project_ref", "ref"]);
	if (!projectRef) {
		return providerError("supabase", SUPABASE_OWNER_SQL, "missing_required_arg", {
			required: ["projectRef"],
			message: "Owner SQL needs projectRef (get one from the `projects` operation).",
		});
	}
	const query = requiredArg(args, ["query", "sql"]);
	if (!query) {
		return providerError("supabase", SUPABASE_OWNER_SQL, "missing_required_arg", {
			required: ["query|sql"],
			message: "Owner SQL needs the SQL text to run as the project owner.",
		});
	}
	const reason = String((parsed && parsed.opts.reason) || "").trim();
	if (!parsed || parsed.opts["confirm-mutating"] !== true || !reason) return supabaseOwnerSqlApproval();
	const credential = supabaseAccessToken(ACTIVE_ACCOUNT_CONTEXT);
	if (!credential.token) {
		return providerError("supabase", SUPABASE_OWNER_SQL, "missing_credential", {
			required: [credential.varName],
			source: credential.source,
			message: ACTIVE_ACCOUNT_CONTEXT
				? `Account ${ACTIVE_ACCOUNT_CONTEXT.alias} needs ${credential.varName}; owner SQL does not fall back to ambient auth.`
				: `Set ${credential.varName} before running owner SQL.`,
		});
	}
	const base = supabaseApiBaseUrl();
	if (base.error) {
		return providerError("supabase", SUPABASE_OWNER_SQL, base.error, {
			variable: "SUPABASE_API_URL",
			message: "SUPABASE_API_URL must be an http(s) URL; refusing to guess an endpoint.",
		});
	}
	const requestedTimeout = Math.max(MIN_OPERATION_TIMEOUT_MS, Math.min(Number(ACTIVE_OPERATION_META && ACTIVE_OPERATION_META.adapterTimeoutMs) || SUPABASE_OWNER_SQL_TIMEOUT_MS, MAX_OPERATION_TIMEOUT_MS));
	const remainingMs = ACTIVE_DEADLINE_MS ? Math.max(1, ACTIVE_DEADLINE_MS - Date.now()) : requestedTimeout;
	const timeoutMs = Math.max(1, Math.min(requestedTimeout, remainingMs));
	const endpoint = `/v1/projects/${encodeURIComponent(projectRef)}/database/query`;
	const result = {
		command: "supabase-management-api",
		method: "POST",
		endpoint,
		ok: false,
		exitCode: null,
		timedOut: false,
		timeoutMs,
		stdout: undefined,
		stderr: "",
		json: null,
		queryProvided: true,
		queryBytes: Buffer.byteLength(query, "utf8"),
		valuesPrinted: false,
	};
	try {
		const response = await fetch(`${base.url}${endpoint}`, {
			method: "POST",
			headers: {
				Authorization: `Bearer ${credential.token}`,
				"Content-Type": "application/json",
				Accept: "application/json",
			},
			body: JSON.stringify({ query }),
			signal: AbortSignal.timeout(timeoutMs),
		});
		result.httpStatus = response.status;
		result.ok = response.ok;
		const text = await response.text();
		if (text) {
			try { result.json = JSON.parse(text); } catch { result.json = null; }
		}
		result.stdout = result.json ? undefined : boundedText(text);
		if (!response.ok) {
			const serverMessage = result.json && !Array.isArray(result.json) && typeof result.json.message === "string" ? result.json.message : null;
			result.stderr = boundedText(serverMessage || text || `Management API returned HTTP ${response.status}`);
		}
	} catch (error) {
		const name = error && error.name;
		result.timedOut = name === "TimeoutError" || name === "AbortError";
		result.stderr = boundedText(`owner SQL request failed: ${error && error.message ? error.message : error}`);
	}
	return providerResult("supabase", SUPABASE_OWNER_SQL, "supabase_owner_sql", applyResultLimit(result, args.limit), {
		adapter: "management_api",
		operationClass: "destructive",
		mutating: true,
	});
}

function callSupabase(operation, args = {}, parsed = null) {
	const globalReads = {
		status: ["projects", "list"],
		projects: ["projects", "list"],
		orgs: ["orgs", "list"],
		snippets: ["snippets", "list"],
	};
	const projectReads = {
		branches: ["branches", "list"],
		functions: ["functions", "list"],
		secrets: ["secrets", "list"],
		migrations: ["migration", "list"],
		backups: ["backups", "list"],
		"domains-get": ["domains", "get"],
		"network-restrictions": ["network-restrictions", "get"],
		"network-bans": ["network-bans", "get"],
		"ssl-enforcement": ["ssl-enforcement", "get"],
		"postgres-config": ["postgres-config", "get"],
		"config-get": ["config", "get"],
	};
	const mutating = {
		"project-create": ["projects", "create"],
		"project-delete": ["projects", "delete"],
		"branch-create": ["branches", "create"],
		"branch-delete": ["branches", "delete"],
		"branch-update": ["branches", "update"],
		"function-deploy": ["functions", "deploy"],
		"function-delete": ["functions", "delete"],
		"secrets-set": ["secrets", "set"],
		"secrets-unset": ["secrets", "unset"],
		"domains-create": ["domains", "create"],
		"domains-activate": ["domains", "activate"],
		"domains-delete": ["domains", "delete"],
		"db-push": ["db", "push"],
		"db-reset": ["db", "reset"],
		"db-dump": ["db", "dump"],
		"migration-up": ["migration", "up"],
		"migration-repair": ["migration", "repair"],
		link: ["link"],
		unlink: ["unlink"],
		"network-restrictions-update": ["network-restrictions", "update"],
		"ssl-enforcement-update": ["ssl-enforcement", "update"],
		"postgres-config-update": ["postgres-config", "update"],
		"backups-restore": ["backups", "restore"],
		"storage-cp": ["storage", "cp"],
		"storage-rm": ["storage", "rm"],
	};
	const known = [...Object.keys(globalReads), ...Object.keys(projectReads), ...Object.keys(mutating), SUPABASE_OWNER_SQL];
	// Owner SQL is not a CLI command, so it never reaches the argv maps below.
	if (operation === SUPABASE_OWNER_SQL) return supabaseOwnerSql(args, parsed);
	if (mutating[operation]) return supabaseApproval(operation, mutating[operation]);
	if (!globalReads[operation] && !projectReads[operation]) return unsupportedOperation("supabase", operation, known);
	if (!commandExists("supabase")) return providerUnavailable("supabase", "supabase", operation);

	if (globalReads[operation]) {
		const cliArgs = [...globalReads[operation], "-o", "json"];
		const resourceType = operation === "status" ? "account_status" : operation;
		return providerResult("supabase", operation, resourceType, runProviderCli("supabase", cliArgs));
	}
	const projectRef = requiredArg(args, ["projectRef", "project_ref", "ref"]);
	if (!projectRef) {
		return providerError("supabase", operation, "missing_required_arg", {
			required: ["projectRef"],
			message: "Project-scoped Supabase reads need projectRef (get one from the `projects` operation).",
		});
	}
	const cliArgs = [...projectReads[operation], "--project-ref", projectRef, "-o", "json"];
	return providerResult("supabase", operation, operation, runProviderCli("supabase", cliArgs));
}

function callRailway(operation, args) {
	const safeOperations = ["status", "whoami", "list-projects", "services", "deployments", "logs", "variables", "environment-config", "volumes"];
	const mutating = {
		up: ["up"],
		run: ["run", "<command>"],
		deploy: ["deploy"],
		add: ["add"],
		redeploy: ["redeploy"],
		restart: ["restart"],
		down: ["down"],
		connect: ["connect"],
		shell: ["shell"],
		ssh: ["ssh"],
		"variable-set": ["variable", "set"],
		"variable-delete": ["variable", "delete"],
		"domain-add": ["domain"],
		"environment-new": ["environment", "new"],
		"environment-delete": ["environment", "delete"],
		"environment-edit": ["environment", "edit"],
		"environment-link": ["environment", "link"],
		"project-delete": ["project", "delete"],
		"volume-add": ["volume", "add"],
		"volume-delete": ["volume", "delete"],
		"volume-update": ["volume", "update"],
		"volume-attach": ["volume", "attach"],
		"volume-detach": ["volume", "detach"],
		"service-redeploy": ["service", "redeploy"],
		"service-restart": ["service", "restart"],
		"service-scale": ["service", "scale"],
	};
	const known = [...safeOperations, ...Object.keys(mutating)];
	if (mutating[operation]) return railwayApproval(operation, mutating[operation]);
	if (!safeOperations.includes(operation)) return unsupportedOperation("railway", operation, known);
	if (!commandExists("railway")) return providerUnavailable("railway", "railway", operation);
	if (operation === "status") return providerResult("railway", operation, "project_status", runProviderCli("railway", ["status", "--json"]));
	if (operation === "whoami") return providerResult("railway", operation, "account_status", runProviderCli("railway", ["whoami", "--json"]));
	if (operation === "list-projects") return providerResult("railway", operation, "projects", runProviderCli("railway", ["list", "--json"]));
	if (operation === "services") {
		const cliArgs = ["service", "status", "--all", "--json"];
		optionalString(args, "environment", cliArgs, "--environment");
		return providerResult("railway", operation, "services", runProviderCli("railway", cliArgs));
	}
	if (operation === "deployments") {
		const cliArgs = ["deployment", "list", "--json", "--limit", boundedLimit(args.limit, 20, 1000)];
		optionalString(args, "service", cliArgs, "--service");
		optionalString(args, "environment", cliArgs, "--environment");
		return providerResult("railway", operation, "deployments", runProviderCli("railway", cliArgs));
	}
	if (operation === "logs") {
		const cliArgs = ["logs", "--json", "--lines", boundedLimit(args.limit, 50, 500)];
		const deployment = requiredArg(args, ["deployment", "deploymentId"]);
		if (deployment) cliArgs.push(deployment);
		optionalString(args, "service", cliArgs, "--service");
		optionalString(args, "environment", cliArgs, "--environment");
		optionalString(args, "since", cliArgs, "--since");
		optionalString(args, "filter", cliArgs, "--filter");
		const result = runProviderCli("railway", cliArgs, { timeout: 45_000 });
		if (!result.json && result.stdout) result.json = parseJsonLines(result.stdout);
		return providerResult("railway", operation, "logs", result);
	}
	if (operation === "variables") {
		const cliArgs = ["variable", "list", "--json"];
		optionalString(args, "service", cliArgs, "--service");
		optionalString(args, "environment", cliArgs, "--environment");
		const result = runProviderCli("railway", cliArgs);
		result.json = sanitizeRailwayVariables(result.json);
		delete result.stdout;
		return providerResult("railway", operation, "variable_names", result);
	}
	if (operation === "environment-config") {
		const cliArgs = ["environment", "config", "--json"];
		optionalString(args, "environment", cliArgs, "--environment");
		return providerResult("railway", operation, "environment_config", runProviderCli("railway", cliArgs));
	}
	if (operation === "volumes") {
		const cliArgs = ["volume", "list", "--json"];
		optionalString(args, "service", cliArgs, "--service");
		optionalString(args, "environment", cliArgs, "--environment");
		return providerResult("railway", operation, "volumes", runProviderCli("railway", cliArgs));
	}
}

function githubSearch(operation, args, baseArgs, resourceType, fields) {
	const query = requiredArg(args, ["query", "q"]);
	if (!query) return providerError("github", operation, "missing_required_arg", { required: ["query|q"] });
	const cliArgs = [...baseArgs, query, "--limit", boundedLimit(args.limit, 30, 100), "--json", fields];
	optionalString(args, "repo", cliArgs, "--repo");
	optionalString(args, "owner", cliArgs, "--owner");
	optionalString(args, "language", cliArgs, "--language");
	optionalString(args, "state", cliArgs, "--state");
	optionalString(args, "sort", cliArgs, "--sort");
	optionalString(args, "order", cliArgs, "--order");
	return providerResult("github", operation, resourceType, runProviderCli("gh", cliArgs, { timeout: 45_000 }));
}

function githubApproval(operation, cliArgs) {
	return providerEnvelope("github", operation, "approval_required", {
		ok: false,
		resourceType: "github_operation",
		adapter: "official_cli",
		operationClass: "mutating_network",
		mutating: true,
		required: ["--confirm-mutating", "--reason <non-empty>"],
		command: "gh",
		argv: redactArgv(cliArgs),
		message: "GitHub mutating operation is represented but not executed without explicit Toolbelt approval.",
	});
}

function githubBlocked(operation, cliArgs) {
	return providerEnvelope("github", operation, "blocked_operation", {
		ok: false,
		resourceType: "github_resource",
		adapter: "official_cli",
		operationClass: "destructive",
		mutating: true,
		command: "gh",
		argv: redactArgv(cliArgs),
		message: "GitHub destructive operation is blocked and will not be executed.",
	});
}

function callGithub(operation, args) {
	const safeOperations = ["status", "repo", "repo-list", "prs", "pr", "pr-checks", "pr-diff", "pr-comments", "issues", "issue", "runs", "run", "run-log", "releases", "release", "workflows", "workflow", "branches", "tags", "commits", "search-repos", "search-code", "search-issues", "search-prs", "search-commits", "notifications", "gists", "gist", "orgs", "org"];
	const mutating = {
		"pr-create": ["pr", "create"],
		"pr-merge": ["pr", "merge"],
		"pr-close": ["pr", "close"],
		"pr-reopen": ["pr", "reopen"],
		"pr-edit": ["pr", "edit"],
		"pr-ready": ["pr", "ready"],
		"pr-comment": ["pr", "comment"],
		"issue-create": ["issue", "create"],
		"issue-close": ["issue", "close"],
		"issue-reopen": ["issue", "reopen"],
		"issue-edit": ["issue", "edit"],
		"issue-comment": ["issue", "comment"],
		"release-create": ["release", "create"],
		"release-edit": ["release", "edit"],
		"release-upload": ["release", "upload"],
		"workflow-run": ["workflow", "run"],
		"workflow-enable": ["workflow", "enable"],
		"workflow-disable": ["workflow", "disable"],
		"run-rerun": ["run", "rerun"],
		"run-cancel": ["run", "cancel"],
		"run-download": ["run", "download"],
		"gist-create": ["gist", "create"],
		"gist-edit": ["gist", "edit"],
		"gist-clone": ["gist", "clone"],
		"repo-create": ["repo", "create"],
		"secret-set": ["secret", "set"],
		"secret-delete": ["secret", "delete"],
		"variable-set": ["variable", "set"],
		"variable-delete": ["variable", "delete"],
	};
	const blocked = { "repo-delete": ["repo", "delete"], "release-delete": ["release", "delete"], "gist-delete": ["gist", "delete"] };
	const known = [...safeOperations, ...Object.keys(mutating), ...Object.keys(blocked)];
	if (blocked[operation]) return githubBlocked(operation, blocked[operation]);
	if (mutating[operation]) return githubApproval(operation, mutating[operation]);
	if (!safeOperations.includes(operation)) return unsupportedOperation("github", operation, known);
	if (operation === "pr" && !requiredArg(args, ["number", "pr"])) return providerError("github", operation, "missing_required_arg", { required: ["number|pr"] });
	if (operation === "issue" && !requiredArg(args, ["number", "issue"])) return providerError("github", operation, "missing_required_arg", { required: ["number|issue"] });
	if (operation === "run" && !requiredArg(args, ["run", "runId", "databaseId"])) return providerError("github", operation, "missing_required_arg", { required: ["run|runId|databaseId"] });
	if (operation === "release" && !requiredArg(args, ["tag", "tagName", "name"])) return providerError("github", operation, "missing_required_arg", { required: ["tag|tagName|name"] });
	if (operation === "workflow" && !requiredArg(args, ["workflow", "workflowId", "id", "name"])) return providerError("github", operation, "missing_required_arg", { required: ["workflow|workflowId|id|name"] });
	if (operation === "gist" && !requiredArg(args, ["gist", "gistId", "id", "url"])) return providerError("github", operation, "missing_required_arg", { required: ["gist|gistId|id|url"] });
	if (operation === "org" && !requiredArg(args, ["org", "organization"])) return providerError("github", operation, "missing_required_arg", { required: ["org|organization"] });
	if (operation === "run-log" && !requiredArg(args, ["run", "runId", "databaseId"])) return providerError("github", operation, "missing_required_arg", { required: ["run|runId|databaseId"] });
	if (["pr-checks", "pr-diff", "pr-comments"].includes(operation) && !requiredArg(args, ["number", "pr"])) return providerError("github", operation, "missing_required_arg", { required: ["number|pr"] });
	if (operation === "pr-comments" && !requiredArg(args, ["repo"])) return providerError("github", operation, "missing_required_arg", { required: ["repo"] });
	if (!commandExists("gh")) return providerUnavailable("github", "gh", operation);
	const repoFlag = [];
	if (args.repo) repoFlag.push("--repo", String(args.repo));
	if (operation === "status") return providerResult("github", operation, "auth_status", runProviderCli("gh", ["auth", "status"]));
	if (operation === "repo") {
		const repoArgs = ["repo", "view"];
		if (args.repo) repoArgs.push(String(args.repo));
		repoArgs.push("--json", "name,owner,url,description,isPrivate,defaultBranchRef");
		return providerResult("github", operation, "repository", runProviderCli("gh", repoArgs));
	}
	if (operation === "repo-list") {
		const cliArgs = ["repo", "list"];
		if (args.owner) cliArgs.push(String(args.owner));
		cliArgs.push("--limit", boundedLimit(args.limit, 30, 100), "--json", "name,owner,url,description,isPrivate,defaultBranchRef");
		return providerResult("github", operation, "repositories", runProviderCli("gh", cliArgs));
	}
	if (operation === "prs") return providerResult("github", operation, "pull_requests", runProviderCli("gh", ["pr", "list", ...repoFlag, "--limit", boundedLimit(args.limit, 30, 100), "--json", "number,title,state,url,author,headRefName,baseRefName,reviewDecision"]));
	if (operation === "pr") {
		const number = requiredArg(args, ["number", "pr"]);
		if (!number) return providerError("github", operation, "missing_required_arg", { required: ["number|pr"] });
		return providerResult("github", operation, "pull_request", runProviderCli("gh", ["pr", "view", number, ...repoFlag, "--json", "number,title,state,url,author,body,headRefName,baseRefName,reviewDecision,mergeStateStatus,statusCheckRollup"]));
	}
	if (operation === "pr-checks") return providerResult("github", operation, "pr_checks", runProviderCli("gh", ["pr", "checks", requiredArg(args, ["number", "pr"]), ...repoFlag]));
	if (operation === "pr-diff") return providerResult("github", operation, "pr_diff", runProviderCli("gh", ["pr", "diff", requiredArg(args, ["number", "pr"]), ...repoFlag]));
	if (operation === "pr-comments") return providerResult("github", operation, "pr_comments", runProviderCli("gh", ["api", `repos/${requiredArg(args, ["repo"])}/issues/${requiredArg(args, ["number", "pr"])}/comments`]));
	if (operation === "issues") return providerResult("github", operation, "issues", runProviderCli("gh", ["issue", "list", ...repoFlag, "--limit", boundedLimit(args.limit, 30, 100), "--json", "number,title,state,url,author,labels,assignees"]));
	if (operation === "issue") {
		const number = requiredArg(args, ["number", "issue"]);
		if (!number) return providerError("github", operation, "missing_required_arg", { required: ["number|issue"] });
		return providerResult("github", operation, "issue", runProviderCli("gh", ["issue", "view", number, ...repoFlag, "--json", "number,title,state,url,author,body,labels,assignees,comments"]));
	}
	if (operation === "runs") return providerResult("github", operation, "workflow_runs", runProviderCli("gh", ["run", "list", ...repoFlag, "--limit", boundedLimit(args.limit, 10, 100), "--json", "databaseId,status,conclusion,workflowName,headBranch,displayTitle,url"]));
	if (operation === "run") {
		const runId = requiredArg(args, ["run", "runId", "databaseId"]);
		if (!runId) return providerError("github", operation, "missing_required_arg", { required: ["run|runId|databaseId"] });
		return providerResult("github", operation, "workflow_run", runProviderCli("gh", ["run", "view", runId, ...repoFlag, "--json", "databaseId,status,conclusion,workflowName,headBranch,displayTitle,url,jobs"]));
	}
	if (operation === "releases") return providerResult("github", operation, "releases", runProviderCli("gh", ["release", "list", ...repoFlag, "--limit", boundedLimit(args.limit, 30, 100), "--json", "tagName,name,isDraft,isPrerelease,isLatest,createdAt,publishedAt"]));
	if (operation === "release") return providerResult("github", operation, "release", runProviderCli("gh", ["release", "view", requiredArg(args, ["tag", "tagName", "name"]), ...repoFlag, "--json", "tagName,name,body,isDraft,isPrerelease,isLatest,createdAt,publishedAt,assets"]));
	if (operation === "workflows") return providerResult("github", operation, "workflows", runProviderCli("gh", ["workflow", "list", ...repoFlag, "--limit", boundedLimit(args.limit, 50, 200), "--json", "id,name,path,state"]));
	if (operation === "workflow") return providerResult("github", operation, "workflow", runProviderCli("gh", ["workflow", "view", requiredArg(args, ["workflow", "workflowId", "id", "name"]), ...repoFlag, "--json", "id,name,path,state"]));
	if (operation === "branches") {
		const repo = requiredArg(args, ["repo"]);
		if (!repo) return providerError("github", operation, "missing_required_arg", { required: ["repo"] });
		return providerResult("github", operation, "branches", runProviderCli("gh", ["api", `repos/${repo}/branches`, "--paginate", "--jq", `.[:${boundedLimit(args.limit, 30, 100)}]`]));
	}
	if (operation === "tags") {
		const repo = requiredArg(args, ["repo"]);
		if (!repo) return providerError("github", operation, "missing_required_arg", { required: ["repo"] });
		return providerResult("github", operation, "tags", runProviderCli("gh", ["api", `repos/${repo}/tags`, "--paginate", "--jq", `.[:${boundedLimit(args.limit, 30, 100)}]`]));
	}
	if (operation === "commits") {
		const repo = requiredArg(args, ["repo"]);
		if (!repo) return providerError("github", operation, "missing_required_arg", { required: ["repo"] });
		return providerResult("github", operation, "commits", runProviderCli("gh", ["api", `repos/${repo}/commits`, "--paginate", "--jq", `.[:${boundedLimit(args.limit, 30, 100)}]`]));
	}
	if (operation === "search-repos") return githubSearch(operation, args, ["search", "repos"], "repositories", "fullName,description,url,stargazersCount");
	if (operation === "search-code") return githubSearch(operation, args, ["search", "code"], "code_results", "repository,path,url");
	if (operation === "search-issues") return githubSearch(operation, args, ["search", "issues"], "issue_results", "number,title,state,url,author,repository");
	if (operation === "search-prs") return githubSearch(operation, args, ["search", "prs"], "pull_request_results", "number,title,state,url,author,repository");
	if (operation === "search-commits") return githubSearch(operation, args, ["search", "commits"], "commit_results", "sha,commit,repository,url");
	if (operation === "notifications") return providerResult("github", operation, "notifications", runProviderCli("gh", ["api", "notifications", "--paginate", "--jq", `.[:${boundedLimit(args.limit, 30, 100)}]`]));
	if (operation === "orgs") return providerResult("github", operation, "organizations", runProviderCli("gh", ["api", "user/orgs"]));
	if (operation === "org") return providerResult("github", operation, "organization", runProviderCli("gh", ["api", `orgs/${requiredArg(args, ["org", "organization"])}`]));
	if (operation === "run-log") return providerResult("github", operation, "run_log", runProviderCli("gh", ["run", "view", requiredArg(args, ["run", "runId", "databaseId"]), ...repoFlag, "--log"], { timeout: 45_000 }));
	if (operation === "gists") return providerResult("github", operation, "gists", runProviderCli("gh", ["gist", "list", "--limit", boundedLimit(args.limit, 10, 100)]));
	if (operation === "gist") return providerResult("github", operation, "gist", runProviderCli("gh", ["gist", "view", requiredArg(args, ["gist", "gistId", "id", "url"])]));
}

function sanitizeStripeWhoami(json) {
	if (!json || typeof json !== "object") return null;
	return {
		authenticated: Boolean(json.authenticated),
		profileName: json.profile_name || null,
		displayName: json.display_name || null,
		accountId: json.account_id || null,
		deviceName: json.device_name || null,
		testModeAvailable: json.test_mode_key && typeof json.test_mode_key === "object" ? Boolean(json.test_mode_key.available) : false,
		testModeExpiresAt: json.test_mode_key && typeof json.test_mode_key === "object" ? json.test_mode_key.expires_at || null : null,
		liveModeAvailable: json.live_mode_key && typeof json.live_mode_key === "object" ? Boolean(json.live_mode_key.available) : false,
		liveModeExpiresAt: json.live_mode_key && typeof json.live_mode_key === "object" ? json.live_mode_key.expires_at || null : null,
		apiVersion: json.api_version || null,
		previewApiVersion: json.preview_api_version || null,
		valuesPrinted: false,
	};
}

function sanitizeStripeResource(value) {
	if (Array.isArray(value)) return value.map(sanitizeStripeResource);
	if (!value || typeof value !== "object") return value;
	const out = {};
	for (const [key, child] of Object.entries(value)) {
		if (SECRET_NAME_RE.test(key)) continue;
		if (["email", "phone", "fingerprint", "last4"].includes(key)) out[key] = "[REDACTED]";
		else if (key === "address" && child && typeof child === "object") {
			out[key] = { ...child, line1: child.line1 ? "[REDACTED]" : child.line1, line2: child.line2 ? "[REDACTED]" : child.line2, postal_code: child.postal_code ? "[REDACTED]" : child.postal_code };
		} else out[key] = sanitizeStripeResource(child);
	}
	return out;
}

function stripeApproval(operation, cliArgs, operationClass = "mutating_data") {
	return providerEnvelope("stripe", operation, "approval_required", {
		ok: false,
		resourceType: "stripe_operation",
		adapter: "official_cli",
		operationClass,
		mutating: true,
		required: ["--confirm-mutating", "--reason <non-empty>"],
		command: "stripe",
		argv: redactArgv(cliArgs),
		message: "Stripe mutating operation is represented but not executed without explicit Toolbelt approval.",
	});
}

function stripeRead(operation, resourceType, cliArgs) {
	const result = runProviderCli("stripe", [...cliArgs, "--log-level", "error"], { timeout: 45_000, env: { STRIPE_SKIP_UPDATE_CHECK: "1" } });
	if (result.json) result.json = sanitizeStripeResource(result.json);
	return providerResult("stripe", operation, resourceType, result, { adapter: "official_cli", operationClass: "read_only_network" });
}

function callStripe(operation, args = {}) {
	const cliAvailable = commandExists("stripe");
	const configuredEnvVars = envPresence(["STRIPE_API_KEY"]);
	const safeOperations = ["status", "balance", "customers-list", "customers-get", "charges-list", "charges-get", "payment-intents-list", "payment-intents-get", "subscriptions-list", "subscriptions-get", "products-list", "products-get", "prices-list", "prices-get", "invoices-list", "invoices-get", "invoices-upcoming", "events-list", "events-get", "payouts-list", "payouts-get", "disputes-list", "disputes-get"];
	const mutating = {
		"customers-create": ["customers", "create"], "customers-update": ["customers", "update"], "customers-delete": ["customers", "delete"],
		"charges-create": ["charges", "create"],
		"payment-intents-create": ["payment_intents", "create"], "payment-intents-update": ["payment_intents", "update"], "payment-intents-confirm": ["payment_intents", "confirm"], "payment-intents-cancel": ["payment_intents", "cancel"],
		"subscriptions-create": ["subscriptions", "create"], "subscriptions-update": ["subscriptions", "update"], "subscriptions-cancel": ["subscriptions", "cancel"],
		"products-create": ["products", "create"], "products-update": ["products", "update"], "products-delete": ["products", "delete"], "prices-create": ["prices", "create"],
		"invoices-create": ["invoices", "create"], "invoices-update": ["invoices", "update"], "invoices-finalize": ["invoices", "finalize"], "invoices-pay": ["invoices", "pay"], "invoices-void": ["invoices", "void"], "invoices-delete": ["invoices", "delete"],
		"payouts-create": ["payouts", "create"], "payouts-cancel": ["payouts", "cancel"], "disputes-update": ["disputes", "update"], "disputes-close": ["disputes", "close"], "refunds-create": ["refunds", "create"],
	};
	const known = [...safeOperations, ...Object.keys(mutating)];
	if (mutating[operation]) return stripeApproval(operation, mutating[operation], /charges|payment|subscriptions|prices|invoices|payouts|disputes|refunds/.test(operation) ? "mutating_financial" : (/delete/.test(operation) ? "mutating_destructive" : "mutating_data"));
	if (!safeOperations.includes(operation)) return unsupportedOperation("stripe", operation, known);
	if (operation === "status") {
		const parts = {
			version: cliAvailable ? runProviderCli("stripe", ["version"], { timeout: 20_000, env: { STRIPE_SKIP_UPDATE_CHECK: "1" } }) : { ok: false, skipped: true },
			whoami: cliAvailable ? runProviderCli("stripe", ["whoami", "--format", "json", "--log-level", "error"], { timeout: 20_000, env: { STRIPE_SKIP_UPDATE_CHECK: "1" } }) : { ok: false, skipped: true },
		};
		if (parts.whoami && parts.whoami.json) parts.whoami.json = sanitizeStripeWhoami(parts.whoami.json);
		return providerEnvelope("stripe", operation, cliAvailable || configuredEnvVars.length > 0 ? "success" : "unavailable", {
			ok: cliAvailable || configuredEnvVars.length > 0,
			adapter: "official_cli",
			resourceType: "cli_auth_status",
			data: parts,
			cli: { name: "stripe", installed: cliAvailable, valuesPrinted: false },
			auth: { envVarsPresent: configuredEnvVars, valuesPrinted: false },
			generation: cliAvailable ? "official_cli_available" : "needs_spec",
		});
	}
	if (!cliAvailable) return providerUnavailable("stripe", "stripe", operation);
	const listArgs = (resource) => {
		const cliArgs = [resource, "list", "--limit", boundedLimit(args.limit, 100, 100)];
		optionalString(args, "customer", cliArgs, "--customer");
		optionalString(args, "status", cliArgs, "--status");
		optionalString(args, "email", cliArgs, "--email");
		optionalString(args, "type", cliArgs, "--type");
		optionalString(args, "startingAfter", cliArgs, "--starting-after");
		optionalString(args, "starting_after", cliArgs, "--starting-after");
		optionalString(args, "paymentIntent", cliArgs, "--payment-intent");
		optionalString(args, "payment_intent", cliArgs, "--payment-intent");
		optionalString(args, "product", cliArgs, "--product");
		optionalString(args, "active", cliArgs, "--active");
		return cliArgs;
	};
	const getId = (names) => requiredArg(args, names);
	if (operation === "balance") return stripeRead(operation, "balance", ["balance", "retrieve"]);
	const listMap = { "customers-list": ["customers", "customers"], "charges-list": ["charges", "charges"], "payment-intents-list": ["payment_intents", "payment_intents"], "subscriptions-list": ["subscriptions", "subscriptions"], "products-list": ["products", "products"], "prices-list": ["prices", "prices"], "invoices-list": ["invoices", "invoices"], "events-list": ["events", "events"], "payouts-list": ["payouts", "payouts"], "disputes-list": ["disputes", "disputes"] };
	if (listMap[operation]) return stripeRead(operation, listMap[operation][1], listArgs(listMap[operation][0]));
	const getMap = { "customers-get": ["customers", ["id", "customerId"]], "charges-get": ["charges", ["id", "chargeId"]], "payment-intents-get": ["payment_intents", ["id", "paymentIntentId"]], "subscriptions-get": ["subscriptions", ["id", "subscriptionId"]], "products-get": ["products", ["id", "productId"]], "prices-get": ["prices", ["id", "priceId"]], "invoices-get": ["invoices", ["id", "invoiceId"]], "events-get": ["events", ["id", "eventId"]], "payouts-get": ["payouts", ["id", "payoutId"]], "disputes-get": ["disputes", ["id", "disputeId"]] };
	if (getMap[operation]) {
		const id = getId(getMap[operation][1]);
		if (!id) return providerError("stripe", operation, "missing_required_arg", { required: getMap[operation][1] });
		return stripeRead(operation, getMap[operation][0], [getMap[operation][0], "retrieve", id]);
	}
	if (operation === "invoices-upcoming") {
		const cliArgs = ["invoices", "upcoming"];
		optionalString(args, "customer", cliArgs, "--customer");
		return stripeRead(operation, "invoice", cliArgs);
	}
}

function isSafeResendProfileName(profile) {
	return /^[A-Za-z0-9._-]{1,64}$/.test(String(profile || ""));
}

function sanitizeResendWhoami(json) {
	if (!json || typeof json !== "object") return null;
	if (json.error) return { authenticated: false, error: json.error, valuesPrinted: false };
	return {
		authenticated: Boolean(json.authenticated),
		profile: json.profile || null,
		source: json.source || null,
		configPathReported: Boolean(json.config_path),
		authMaterialPresent: Boolean(json.api_key),
		valuesPrinted: false,
	};
}

function sanitizeResendProfiles(json) {
	if (!json || typeof json !== "object") return null;
	const profiles = Array.isArray(json.profiles) ? json.profiles.map((profile) => {
		if (typeof profile === "string") return { name: profile };
		if (profile && typeof profile === "object") return { name: profile.name || profile.profile || null, active: Boolean(profile.active || profile.current) };
		return { name: null };
	}).filter((profile) => profile.name) : [];
	return { count: profiles.length, profiles, valuesPrinted: false };
}

function resendApproval(operation, cliArgs) {
	return providerEnvelope("resend", operation, "approval_required", {
		ok: false,
		resourceType: "resend_operation",
		adapter: "official_cli",
		operationClass: "mutating_network",
		mutating: true,
		required: ["--confirm-mutating", "--reason <non-empty>"],
		command: "resend",
		argv: redactArgv(cliArgs),
		message: "Resend mutating operation is represented but not executed without explicit Toolbelt approval.",
	});
}

function sanitizeResendOutput(value) {
	if (Array.isArray(value)) return value.map(sanitizeResendOutput);
	if (!value || typeof value !== "object") return value;
	const out = {};
	for (const [key, child] of Object.entries(value)) {
		if (SECRET_NAME_RE.test(key) || /^key$/i.test(key)) out[key] = "[REDACTED]";
		else out[key] = sanitizeResendOutput(child);
	}
	return out;
}

function callResend(operation, args, parsed = null) {
	const cliAvailable = commandExists("resend");
	const configuredEnvVars = ACTIVE_ACCOUNT_CONTEXT ? [] : envPresence(["RESEND_API_KEY", "RESEND_PROFILE"]);
	const safeOperations = ["status", "domains-list", "domains-get", "api-keys-list", "emails-list", "emails-get", "broadcasts-list", "broadcasts-get", "contacts-list", "contacts-get", "templates-list", "templates-get", "webhooks-list", "webhooks-get"];
	const mutating = {
		"emails-send": ["emails", "send"], "emails-batch": ["emails", "batch"], "emails-cancel": ["emails", "cancel"], "emails-update": ["emails", "update"],
		"domains-create": ["domains", "create"], "domains-update": ["domains", "update"], "domains-delete": ["domains", "delete"], "domains-verify": ["domains", "verify"],
		"api-keys-create": ["api-keys", "create"], "api-keys-delete": ["api-keys", "delete"],
		"broadcasts-create": ["broadcasts", "create"], "broadcasts-update": ["broadcasts", "update"], "broadcasts-delete": ["broadcasts", "delete"], "broadcasts-send": ["broadcasts", "send"],
		"contacts-create": ["contacts", "create"], "contacts-update": ["contacts", "update"], "contacts-delete": ["contacts", "delete"], "contacts-add-segment": ["contacts", "add-segment"], "contacts-remove-segment": ["contacts", "remove-segment"], "contacts-update-topics": ["contacts", "update-topics"],
		"templates-create": ["templates", "create"], "templates-update": ["templates", "update"], "templates-delete": ["templates", "delete"], "templates-publish": ["templates", "publish"], "templates-duplicate": ["templates", "duplicate"],
		"webhooks-create": ["webhooks", "create"], "webhooks-update": ["webhooks", "update"], "webhooks-delete": ["webhooks", "delete"],
	};
	const known = [...safeOperations, ...Object.keys(mutating)];
	if (mutating[operation] && !parsed?.opts?.["confirm-mutating"]) return resendApproval(operation, mutating[operation]);
	if (mutating[operation] && !["domains-create", "domains-update", "domains-verify"].includes(operation)) {
		return providerError("resend", operation, ["api-keys-create", "webhooks-create"].includes(operation) ? "secure_secret_sink_required" : "approved_mutation_not_implemented", { operationClass: "mutating_network", mutating: true, command: "resend", argv: redactArgv(mutating[operation]), message: "This official CLI operation is not executed until Toolbelt can preserve any one-time secret or has an explicit safe mutation contract." });
	}
	if (!safeOperations.includes(operation) && !mutating[operation]) return unsupportedOperation("resend", operation, known);
	const id = requiredArg(args, ["id", "domainId", "emailId", "broadcastId", "contactId", "templateId", "webhookId"]);
	if (operation.endsWith("-get") && !id) return providerError("resend", operation, "missing_required_arg", { required: ["id"] });
	if (!cliAvailable) {
		return providerEnvelope("resend", operation, "unavailable", {
			ok: false,
			adapter: "official_cli",
			resourceType: operation === "status" ? "cli_auth_readiness" : "resend_resource",
			cli: { name: "resend", installed: false, valuesPrinted: false },
			auth: { envVarsPresent: configuredEnvVars, valuesPrinted: false },
			generation: "install_official_cli",
		});
	}
	if (["domains-create", "domains-update", "domains-verify"].includes(operation)) {
		const cliArgs = ["domains", operation.slice("domains-".length)];
		if (operation === "domains-create") {
			const name = requiredArg(args, ["name", "domain"]);
			if (!name) return providerError("resend", operation, "missing_required_arg", { required: ["name|domain"] });
			cliArgs.push("--name", name);
			if (args.region) cliArgs.push("--region", String(args.region));
			if (args.tls) cliArgs.push("--tls", String(args.tls));
			if (args.trackingSubdomain || args.tracking_subdomain) cliArgs.push("--tracking-subdomain", String(args.trackingSubdomain || args.tracking_subdomain));
		} else {
			if (!id) return providerError("resend", operation, "missing_required_arg", { required: ["id|domainId"] });
			cliArgs.push(id);
			if (operation === "domains-update") {
				if (args.tls) cliArgs.push("--tls", String(args.tls));
				if (args.trackingSubdomain || args.tracking_subdomain) cliArgs.push("--tracking-subdomain", String(args.trackingSubdomain || args.tracking_subdomain));
				if (args.openTracking === true || args.open_tracking === true) cliArgs.push("--open-tracking");
				if (args.openTracking === false || args.open_tracking === false) cliArgs.push("--no-open-tracking");
				if (args.clickTracking === true || args.click_tracking === true) cliArgs.push("--click-tracking");
				if (args.clickTracking === false || args.click_tracking === false) cliArgs.push("--no-click-tracking");
			}
		}
		cliArgs.push("--json");
		const mutation = runProviderCli("resend", cliArgs, { timeout: 30_000 });
		if (mutation.json) mutation.json = sanitizeResendOutput(mutation.json);
		delete mutation.stdout;
		return providerResult("resend", operation, "resend_domain_mutation", mutation, { adapter: "official_cli", operationClass: "mutating_network", mutating: true });
	}
	const profile = args.profile !== undefined && args.profile !== null && String(args.profile).trim() ? String(args.profile).trim() : null;
	if (profile && !isSafeResendProfileName(profile)) return providerError("resend", operation, "invalid_arg", { arg: "profile", expected: "1-64 chars: letters, numbers, dot, underscore, dash" });
	const profileArgs = profile ? ["--profile", profile] : [];
	if (operation === "status") {
		const whoami = runProviderCli("resend", ["whoami", "--json", ...profileArgs], { timeout: 15_000 });
		if (whoami.json) whoami.json = sanitizeResendWhoami(whoami.json);
		delete whoami.stdout;
		const profiles = runProviderCli("resend", ["auth", "list", "--json"], { timeout: 15_000 });
		if (profiles.json) profiles.json = sanitizeResendProfiles(profiles.json);
		delete profiles.stdout;
		const authenticated = Boolean(whoami.ok && whoami.json && whoami.json.authenticated);
		return providerEnvelope("resend", operation, authenticated ? "success" : "error", {
			ok: authenticated,
			adapter: "official_cli",
			resourceType: "cli_auth_readiness",
			data: { version: runProviderCli("resend", ["--version"], { timeout: 15_000 }), whoami, profiles, env: { present: configuredEnvVars, valuesPrinted: false }, config: { files: filePresence([path.join(os.homedir(), ".config", "resend", "credentials.json")]), valuesPrinted: false } },
			cli: { name: "resend", installed: true, profile: ACTIVE_ACCOUNT_CONTEXT?.profile || profile || null, valuesPrinted: false },
		});
	}
	const readMap = {
		"domains-list": ["domains", "list"], "domains-get": ["domains", "get", id], "api-keys-list": ["api-keys", "list"], "emails-list": ["emails", "list"], "emails-get": ["emails", "get", id],
		"broadcasts-list": ["broadcasts", "list"], "broadcasts-get": ["broadcasts", "get", id], "contacts-list": ["contacts", "list"], "contacts-get": ["contacts", "get", id], "templates-list": ["templates", "list"], "templates-get": ["templates", "get", id], "webhooks-list": ["webhooks", "list"], "webhooks-get": ["webhooks", "get", id],
	};
	const result = runProviderCli("resend", [...readMap[operation], "--json", ...profileArgs], { timeout: 30_000 });
	if (result.json) result.json = sanitizeResendOutput(result.json);
	delete result.stdout;
	return providerResult("resend", operation, operation.replace(/-/g, "_"), result, { adapter: "official_cli", operationClass: "read_only_network" });
}

function gwsParams(params) {
	return ["--params", JSON.stringify(params || {}), "--format", "json"];
}

function gwsCommand() {
	const override = process.env.PI_TOOLBELT_GWS_BIN;
	if (override && path.isAbsolute(override) && commandExists(override)) return override;
	const currentPath = String(process.env.PATH || "").split(path.delimiter);
	const nodeBin = path.dirname(process.execPath);
	if (!currentPath.includes(nodeBin)) process.env.PATH = `${nodeBin}${path.delimiter}${process.env.PATH || ""}`;
	const bundled = path.join(CODE_ROOT, "node_modules", ".bin", "gws");
	if (commandExists(bundled)) {
		const bundledBin = path.dirname(bundled);
		if (!String(process.env.PATH || "").split(path.delimiter).includes(bundledBin)) process.env.PATH = `${bundledBin}${path.delimiter}${process.env.PATH || ""}`;
		return "gws";
	}
	return commandExists("gws") ? "gws" : null;
}

function gwsApproval(operation, cliArgs) {
	return providerEnvelope("google-workspace", operation, "approval_required", {
		ok: false,
		resourceType: "google_workspace_operation",
		adapter: "official_cli",
		operationClass: "mutating_network",
		mutating: true,
		required: ["--confirm-mutating", "--reason <non-empty>"],
		command: gwsCommand() || "gws",
		argv: redactArgv(cliArgs),
		message: "Google Workspace mutating operation is represented but not executed without explicit Toolbelt approval.",
	});
}

function sanitizeGoogleWorkspaceMetadata(value) {
	if (Array.isArray(value)) return value.map(sanitizeGoogleWorkspaceMetadata);
	if (!value || typeof value !== "object") return value;
	const out = {};
	for (const [key, child] of Object.entries(value)) {
		if (["snippet", "body", "raw", "payload", "data"].includes(key.toLowerCase())) continue;
		out[key] = sanitizeGoogleWorkspaceMetadata(child);
	}
	return out;
}

function googleWorkspaceMetadataResult(operation, resourceType, cliArgs, includeContent = false) {
	const gws = gwsCommand();
	if (!gws) return providerUnavailable("google-workspace", "gws", operation);
	const result = runProviderCli(gws, cliArgs, { timeout: 30_000 });
	if (result.json && !includeContent) result.json = sanitizeGoogleWorkspaceMetadata(result.json);
	delete result.stdout;
	return providerResult("google-workspace", operation, resourceType, result);
}

function googleWorkspaceFolderUpload(args = {}) {
	const gws = gwsCommand();
	const localPathArg = requiredArg(args, ["localPath", "local_path", "path"]);
	const parentId = requiredArg(args, ["parentId", "parent_id"]);
	if (!localPathArg || !parentId) return providerError("google-workspace", "drive-folder-upload", "missing_required_arg", { required: ["localPath|local_path|path", "parentId|parent_id"] });
	if (!gws) return providerUnavailable("google-workspace", "gws", "drive-folder-upload");

	let localPath;
	try {
		localPath = fs.realpathSync(String(localPathArg));
	} catch {
		return providerError("google-workspace", "drive-folder-upload", "local_path_not_found", { localPath: String(localPathArg) });
	}
	if (!fs.statSync(localPath).isDirectory()) return providerError("google-workspace", "drive-folder-upload", "local_path_not_directory", { localPath });
	if (!/^[A-Za-z0-9_-]{10,}$/.test(String(parentId))) return providerError("google-workspace", "drive-folder-upload", "invalid_parent_id", {});

	const rootName = String(args.name || path.basename(localPath)).trim();
	if (!rootName || rootName.length > 180 || /[\\/]/.test(rootName)) return providerError("google-workspace", "drive-folder-upload", "invalid_folder_name", {});
	const directories = [];
	const files = [];
	const walk = (absoluteDir, relativeDir = "") => {
		const entries = fs.readdirSync(absoluteDir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name));
		for (const entry of entries) {
			const absolute = path.join(absoluteDir, entry.name);
			const relative = relativeDir ? path.posix.join(relativeDir, entry.name) : entry.name;
			if (entry.isSymbolicLink()) throw new Error(`symbolic_link_not_supported:${relative}`);
			if (entry.isDirectory()) {
				directories.push({ absolute, relative });
				walk(absolute, relative);
			} else if (entry.isFile()) {
				files.push({ absolute, relative, size: fs.statSync(absolute).size });
			}
		}
	};
	try {
		walk(localPath);
	} catch (error) {
		return providerError("google-workspace", "drive-folder-upload", "unsupported_source_entry", { message: String(error.message || error) });
	}

	const escapeDriveQuery = (value) => String(value).replace(/\\/g, "\\\\").replace(/'/g, "\\'");
	const existingQuery = `'${escapeDriveQuery(parentId)}' in parents and name = '${escapeDriveQuery(rootName)}' and mimeType = 'application/vnd.google-apps.folder' and trashed = false`;
	const existing = runProviderCli(gws, ["drive", "files", "list", ...gwsParams({ q: existingQuery, pageSize: 10, fields: "files(id,name,mimeType,parents,trashed)" })], { timeout: 30_000 });
	if (!existing.ok) return providerResult("google-workspace", "drive-folder-upload", "drive_folder_upload_preflight", existing);
	if (Array.isArray(existing.json?.files) && existing.json.files.length > 0) {
		return providerError("google-workspace", "drive-folder-upload", "destination_exists", { name: rootName, parentId, existingFolderId: existing.json.files[0].id });
	}

	const createFolder = (name, parent) => runProviderCli(gws, ["drive", "files", "create", "--json", JSON.stringify({ name, mimeType: "application/vnd.google-apps.folder", parents: [parent] }), "--format", "json"], { timeout: 30_000 });
	const rootResult = createFolder(rootName, String(parentId));
	const rootFolderId = rootResult.json?.id;
	if (!rootResult.ok || !rootFolderId) return providerResult("google-workspace", "drive-folder-upload", "drive_folder_upload_root", rootResult);

	const folderIds = new Map([["", rootFolderId]]);
	let foldersCreated = 1;
	let filesUploaded = 0;
	let bytesUploaded = 0;
	for (const directory of directories) {
		const parentRelative = path.posix.dirname(directory.relative) === "." ? "" : path.posix.dirname(directory.relative);
		const result = createFolder(path.posix.basename(directory.relative), folderIds.get(parentRelative));
		const id = result.json?.id;
		if (!result.ok || !id) return providerError("google-workspace", "drive-folder-upload", "partial_upload_failure", { rootFolderId, rootUrl: `https://drive.google.com/drive/folders/${rootFolderId}`, failedPath: directory.relative, foldersCreated, filesUploaded, bytesUploaded, message: "Folder creation failed; uploaded content was preserved for inspection." });
		folderIds.set(directory.relative, id);
		foldersCreated += 1;
	}
	for (const file of files) {
		const parentRelative = path.posix.dirname(file.relative) === "." ? "" : path.posix.dirname(file.relative);
		const result = runProviderCli(gws, ["drive", "files", "create", "--json", JSON.stringify({ name: path.posix.basename(file.relative), parents: [folderIds.get(parentRelative)] }), "--upload", file.absolute, "--format", "json"], { timeout: 300_000 });
		if (!result.ok || !result.json?.id) return providerError("google-workspace", "drive-folder-upload", "partial_upload_failure", { rootFolderId, rootUrl: `https://drive.google.com/drive/folders/${rootFolderId}`, failedPath: file.relative, foldersCreated, filesUploaded, bytesUploaded, message: "File upload failed; uploaded content was preserved for inspection." });
		filesUploaded += 1;
		bytesUploaded += file.size;
	}
	return providerEnvelope("google-workspace", "drive-folder-upload", "success", {
		ok: true,
		resourceType: "drive_folder_upload",
		adapter: "official_cli",
		operationClass: "mutating_network",
		mutating: true,
		data: { rootFolderId, rootUrl: `https://drive.google.com/drive/folders/${rootFolderId}`, name: rootName, parentId: String(parentId), foldersCreated, filesUploaded, bytesUploaded },
	});
}

function callGoogleWorkspace(operation, args = {}, parsed = null) {
	const safeOperations = ["status", "drive-about", "drive-list", "drive-get", "drive-permissions", "docs-get", "gmail-profile", "gmail-labels", "gmail-messages", "gmail-message", "gmail-threads", "gmail-thread", "calendar-list", "calendar-get", "calendar-events", "calendar-event", "calendar-freebusy"];
	const mutating = {
		"drive-create": ["drive", "files", "create"], "drive-update": ["drive", "files", "update"], "drive-copy": ["drive", "files", "copy"], "drive-delete": ["drive", "files", "delete"], "drive-trash": ["drive", "files", "update"], "drive-untrash": ["drive", "files", "update"], "drive-folder-upload": ["drive", "files", "create", "--upload", "<validated-local-path>"], "drive-permission-create": ["drive", "permissions", "create"], "drive-permission-delete": ["drive", "permissions", "delete"],
		"gmail-send": ["gmail", "users", "messages", "send"], "gmail-draft-create": ["gmail", "users", "drafts", "create"], "gmail-draft-send": ["gmail", "users", "drafts", "send"], "gmail-draft-delete": ["gmail", "users", "drafts", "delete"], "gmail-modify": ["gmail", "users", "messages", "modify"], "gmail-trash": ["gmail", "users", "messages", "trash"], "gmail-delete": ["gmail", "users", "messages", "delete"],
		"calendar-event-create": ["calendar", "events", "insert"], "calendar-event-update": ["calendar", "events", "update"], "calendar-event-delete": ["calendar", "events", "delete"],
	};
	const known = [...safeOperations, ...Object.keys(mutating)];
	if (operation === "drive-folder-upload") {
		if (!parsed?.opts?.["confirm-mutating"]) return gwsApproval(operation, mutating[operation]);
		return googleWorkspaceFolderUpload(args);
	}
	if (mutating[operation]) {
		if (!parsed?.opts?.["confirm-mutating"]) return gwsApproval(operation, mutating[operation]);
		const params = args.params && typeof args.params === "object" && !Array.isArray(args.params) ? { ...args.params } : {};
		if (operation.startsWith("gmail-") && !params.userId) params.userId = "me";
		const body = args.body;
		if (body !== undefined && (body === null || typeof body !== "object" || Array.isArray(body))) return providerError("google-workspace", operation, "invalid_request_body", { required: ["body: JSON object"] });
		const cliArgs = [...mutating[operation], ...gwsParams(params)];
		if (body !== undefined) cliArgs.push("--json", JSON.stringify(body));
		if (parsed?.opts?.["dry-run"]) cliArgs.push("--dry-run");
		return providerResult("google-workspace", operation, "google_workspace_mutation", runProviderCli(gwsCommand() || "gws", cliArgs, { timeout: 60_000 }), { operationClass: "mutating_network", mutating: true });
	}
	if (!safeOperations.includes(operation)) return unsupportedOperation("google-workspace", operation, known);
	const gws = gwsCommand();
	if (!gws) return providerUnavailable("google-workspace", "gws", operation);
	if (operation === "status") {
		const auth = runProviderCli(gws, ["auth", "status"], { timeout: 15_000 });
		const authData = auth.json || {};
		return providerEnvelope("google-workspace", operation, auth.ok ? "success" : "error", {
			ok: Boolean(auth.ok),
			adapter: "official_cli",
			resourceType: "cli_auth_readiness",
			data: {
				account: authData.user || null,
				authenticated: Boolean(authData.token_valid),
				persistentSession: Boolean(authData.has_refresh_token),
				scopeCount: Number(authData.scope_count) || 0,
				config: { files: filePresence([path.join(os.homedir(), ".config", "gws")]), valuesPrinted: false },
			},
			cli: { name: "gws", installed: true, valuesPrinted: false },
		});
	}
	const driveFields = "files(id,name,mimeType,modifiedTime,size,owners(emailAddress,displayName),parents,shared,trashed)";
	const fileId = requiredArg(args, ["fileId", "file_id", "id"]);
	const documentId = requiredArg(args, ["documentId", "document_id", "id"]);
	const messageId = requiredArg(args, ["messageId", "message_id", "id"]);
	const threadId = requiredArg(args, ["threadId", "thread_id", "id"]);
	const calendarId = requiredArg(args, ["calendarId", "calendar_id", "calendar", "id"]);
	const eventId = requiredArg(args, ["eventId", "event_id"]);
	if (operation === "drive-about") return providerResult("google-workspace", operation, "drive_about", runProviderCli(gws, ["drive", "about", "get", ...gwsParams({ fields: "user,storageQuota" })], { timeout: 30_000 }));
	if (operation === "drive-list") return providerResult("google-workspace", operation, "drive_files", runProviderCli(gws, ["drive", "files", "list", ...gwsParams({ pageSize: Math.max(1, Math.min(Number(args.limit) || 20, 1000)), q: args.query || args.q, orderBy: args.orderBy || args.sort, fields: driveFields })], { timeout: 30_000 }));
	if (operation === "drive-get") {
		if (!fileId) return providerError("google-workspace", operation, "missing_required_arg", { required: ["fileId|file_id|id"] });
		return providerResult("google-workspace", operation, "drive_file", runProviderCli(gws, ["drive", "files", "get", ...gwsParams({ fileId, fields: "id,name,mimeType,modifiedTime,size,owners(emailAddress,displayName),parents,shared,description,createdTime" })], { timeout: 30_000 }));
	}
	if (operation === "drive-permissions") {
		if (!fileId) return providerError("google-workspace", operation, "missing_required_arg", { required: ["fileId|file_id|id"] });
		return providerResult("google-workspace", operation, "drive_permissions", runProviderCli(gws, ["drive", "permissions", "list", ...gwsParams({ fileId })], { timeout: 30_000 }));
	}
	if (operation === "docs-get") {
		if (!documentId) return providerError("google-workspace", operation, "missing_required_arg", { required: ["documentId|document_id|id"] });
		return providerResult("google-workspace", operation, "google_document", runProviderCli(gws, ["docs", "documents", "get", ...gwsParams({ documentId })], { timeout: 30_000 }));
	}
	if (operation === "gmail-profile") return googleWorkspaceMetadataResult(operation, "gmail_profile", ["gmail", "users", "getProfile", ...gwsParams({ userId: "me" })]);
	if (operation === "gmail-labels") return googleWorkspaceMetadataResult(operation, "gmail_labels", ["gmail", "users", "labels", "list", ...gwsParams({ userId: "me" })]);
	if (operation === "gmail-messages") return googleWorkspaceMetadataResult(operation, "gmail_messages", ["gmail", "users", "messages", "list", ...gwsParams({ userId: "me", maxResults: Math.max(1, Math.min(Number(args.limit) || 20, 500)), q: args.query || args.q, labelIds: args.labelIds || args.label })]);
	if (operation === "gmail-message") {
		if (!messageId) return providerError("google-workspace", operation, "missing_required_arg", { required: ["messageId|message_id|id"] });
		const includeContent = args.includeContent === true;
		return googleWorkspaceMetadataResult(operation, "gmail_message", ["gmail", "users", "messages", "get", ...gwsParams({ userId: "me", id: messageId, format: includeContent ? "full" : "metadata", metadataHeaders: ["From", "To", "Subject", "Date"] })], includeContent);
	}
	if (operation === "gmail-threads") return googleWorkspaceMetadataResult(operation, "gmail_threads", ["gmail", "users", "threads", "list", ...gwsParams({ userId: "me", maxResults: Math.max(1, Math.min(Number(args.limit) || 20, 500)), q: args.query || args.q })]);
	if (operation === "gmail-thread") {
		if (!threadId) return providerError("google-workspace", operation, "missing_required_arg", { required: ["threadId|thread_id|id"] });
		const includeContent = args.includeContent === true;
		return googleWorkspaceMetadataResult(operation, "gmail_thread", ["gmail", "users", "threads", "get", ...gwsParams({ userId: "me", id: threadId, format: includeContent ? "full" : "metadata" })], includeContent);
	}
	if (operation === "calendar-list") return providerResult("google-workspace", operation, "calendar_list", runProviderCli(gws, ["calendar", "calendarList", "list", ...gwsParams({})], { timeout: 30_000 }));
	if (operation === "calendar-get") {
		if (!calendarId) return providerError("google-workspace", operation, "missing_required_arg", { required: ["calendarId|calendar_id|id"] });
		return providerResult("google-workspace", operation, "calendar", runProviderCli(gws, ["calendar", "calendars", "get", ...gwsParams({ calendarId })], { timeout: 30_000 }));
	}
	if (operation === "calendar-events") {
		if (!calendarId) return providerError("google-workspace", operation, "missing_required_arg", { required: ["calendarId|calendar_id|id"] });
		return providerResult("google-workspace", operation, "calendar_events", runProviderCli(gws, ["calendar", "events", "list", ...gwsParams({ calendarId, maxResults: Math.max(1, Math.min(Number(args.limit) || 20, 250)), timeMin: args.timeMin, timeMax: args.timeMax, q: args.query || args.q, singleEvents: true })], { timeout: 30_000 }));
	}
	if (operation === "calendar-event") {
		if (!calendarId || !eventId) return providerError("google-workspace", operation, "missing_required_arg", { required: ["calendarId|calendar_id|id", "eventId|event_id"] });
		return providerResult("google-workspace", operation, "calendar_event", runProviderCli(gws, ["calendar", "events", "get", ...gwsParams({ calendarId, eventId })], { timeout: 30_000 }));
	}
	if (operation === "calendar-freebusy") return providerResult("google-workspace", operation, "calendar_freebusy", runProviderCli(gws, ["calendar", "freebusy", "query", "--json", JSON.stringify(args.body || { timeMin: args.timeMin, timeMax: args.timeMax, items: args.items || [] }), "--format", "json"], { timeout: 30_000 }));
}

function parseSentryInfo(stdout) {
	const text = String(stdout || "");
	const scopes = [];
	let inScopes = false;
	const info = {
		server: null,
		defaultOrganization: null,
		defaultProject: null,
		authentication: { method: null, user: null, scopes, valuesPrinted: false },
	};
	for (const line of text.split(/\r?\n/)) {
		const trimmed = line.trim();
		if (!trimmed) continue;
		if (trimmed.startsWith("Sentry Server:")) info.server = trimmed.slice("Sentry Server:".length).trim() || null;
		else if (trimmed.startsWith("Default Organization:")) info.defaultOrganization = trimmed.slice("Default Organization:".length).trim() || null;
		else if (trimmed.startsWith("Default Project:")) info.defaultProject = trimmed.slice("Default Project:".length).trim() || null;
		else if (trimmed.startsWith("Method:")) {
			const method = trimmed.slice("Method:".length).trim();
			info.authentication.method = /^Auth Token$/i.test(method) ? "configured" : method || null;
		}
		else if (trimmed.startsWith("User:")) info.authentication.user = trimmed.slice("User:".length).trim() || null;
		else if (trimmed === "Scopes:") inScopes = true;
		else if (inScopes && trimmed.startsWith("- ")) scopes.push(trimmed.slice(2).trim());
		else if (inScopes) inScopes = false;
	}
	return info;
}

function sentryApproval(operation, cliArgs, operationClass = "mutating_network") {
	return providerEnvelope("sentry", operation, "approval_required", {
		ok: false,
		resourceType: "sentry_operation",
		adapter: "official_cli",
		operationClass,
		mutating: true,
		required: ["--confirm-mutating", "--reason <non-empty>"],
		command: "sentry-cli",
		argv: redactArgv(cliArgs),
		message: "Sentry mutating/auth/upload operation is represented but not executed without explicit Toolbelt approval.",
	});
}

function callSentry(operation, args = {}) {
	const safeOperations = ["status", "organizations-list", "projects-list", "releases-list", "releases-get", "issues-list", "deploys-list"];
	const mutating = { "releases-create": ["releases", "new"], "releases-delete": ["releases", "delete"], "releases-finalize": ["releases", "finalize"], "deploys-create": ["deploys", "new"], "issues-update": ["issues", "update"], "send-event": ["send-event"], "upload-dif": ["debug-files", "upload"], "upload-sourcemaps": ["sourcemaps", "upload"], login: ["login"], logout: ["logout"] };
	const known = [...safeOperations, ...Object.keys(mutating)];
	if (mutating[operation]) return sentryApproval(operation, mutating[operation], operation === "login" || operation === "logout" ? "auth_mutation" : "mutating_network");
	if (!safeOperations.includes(operation)) return unsupportedOperation("sentry", operation, known);
	const releaseVersion = operation === "releases-get" ? requiredArg(args, ["version", "release"]) : undefined;
	if (operation === "releases-get" && !releaseVersion) return providerError("sentry", operation, "missing_required_arg", { required: ["version|release"] });
	if (!commandExists("sentry-cli")) return providerUnavailable("sentry", "sentry-cli", operation);
	if (operation === "status") {
		const result = runProviderCli("sentry-cli", ["info", "--log-level=error"], { timeout: 30_000 });
		if (result.ok) result.json = parseSentryInfo(result.stdout || "");
		delete result.stdout;
		return providerResult("sentry", operation, "auth_status", result);
	}
	const orgProject = (cliArgs) => { optionalString(args, "org", cliArgs, "--org"); optionalString(args, "project", cliArgs, "--project"); return cliArgs; };
	if (operation === "organizations-list") return providerResult("sentry", operation, "organizations", runProviderCli("sentry-cli", ["organizations", "list", "--log-level=error"], { timeout: 30_000 }));
	if (operation === "projects-list") return providerResult("sentry", operation, "projects", runProviderCli("sentry-cli", orgProject(["projects", "list", "--log-level=error"]), { timeout: 30_000 }));
	if (operation === "releases-list") return providerResult("sentry", operation, "releases", runProviderCli("sentry-cli", orgProject(["releases", "list", "--log-level=error"]), { timeout: 30_000 }));
	if (operation === "releases-get") {
		return providerResult("sentry", operation, "release", runProviderCli("sentry-cli", orgProject(["releases", "info", releaseVersion, "--log-level=error"]), { timeout: 30_000 }));
	}
	if (operation === "issues-list") return providerResult("sentry", operation, "issues", runProviderCli("sentry-cli", orgProject(["issues", "list", "--log-level=error"]), { timeout: 30_000 }));
	if (operation === "deploys-list") return providerResult("sentry", operation, "deploys", runProviderCli("sentry-cli", orgProject(["deploys", "list", "--log-level=error"]), { timeout: 30_000 }));
}

function tailscaleHostSummary(peer) {
	return {
		hostName: peer.HostName || null,
		dnsName: peer.DNSName || null,
		os: peer.OS || null,
		online: Boolean(peer.Online),
		active: Boolean(peer.Active),
		exitNode: Boolean(peer.ExitNode),
		exitNodeOption: Boolean(peer.ExitNodeOption),
		lastSeen: peer.LastSeen || null,
	};
}

function summarizeTailscaleStatus(status) {
	const peers = status && status.Peer && typeof status.Peer === "object" ? Object.values(status.Peer) : [];
	const self = status && status.Self && typeof status.Self === "object" ? status.Self : {};
	return {
		backendState: status ? status.BackendState || null : null,
		tun: status ? Boolean(status.TUN) : false,
		magicDNSSuffix: status ? status.MagicDNSSuffix || null : null,
		currentTailnet: status ? status.CurrentTailnet ? { name: status.CurrentTailnet.Name || null, magicDNSSuffix: status.CurrentTailnet.MagicDNSSuffix || null } : null : null,
		self: tailscaleHostSummary(self),
		peers: { total: peers.length, online: peers.filter((peer) => peer && peer.Online).length, active: peers.filter((peer) => peer && peer.Active).length },
	};
}

function summarizeTailscaleDevices(status, limit) {
	const peers = status && status.Peer && typeof status.Peer === "object" ? Object.values(status.Peer) : [];
	return peers.slice(0, Math.max(1, Math.min(Number(limit) || 100, 1000))).map(tailscaleHostSummary);
}

function tailscaleApproval(operation, cliArgs) {
	return providerEnvelope("tailscale", operation, "approval_required", {
		ok: false,
		resourceType: "tailscale_operation",
		adapter: "official_cli",
		operationClass: "mutating_network_config",
		mutating: true,
		required: ["--confirm-mutating", "--reason <non-empty>"],
		command: "tailscale",
		argv: redactArgv(cliArgs),
		message: "Tailscale network/auth/exposure operation is represented but not executed without explicit Toolbelt approval.",
	});
}

function sanitizeTailscaleJson(value) {
	if (Array.isArray(value)) return value.map(sanitizeTailscaleJson);
	if (!value || typeof value !== "object") return value;
	const out = {};
	for (const [key, child] of Object.entries(value)) {
		if (["TailscaleIPs", "Addrs", "PeerAPIURL", "Endpoints"].includes(key)) continue;
		out[key] = sanitizeTailscaleJson(child);
	}
	return out;
}

function callTailscale(operation, args = {}) {
	const safeOperations = ["status", "devices", "whois", "ping", "netcheck", "cert"];
	const mutating = { up: ["up"], down: ["down"], set: ["set"], funnel: ["funnel"], serve: ["serve"], logout: ["logout"] };
	const blocked = { debug: ["debug"], certify: ["certify"] };
	const known = [...safeOperations, ...Object.keys(mutating), ...Object.keys(blocked)];
	if (mutating[operation]) return tailscaleApproval(operation, mutating[operation]);
	if (blocked[operation]) return providerEnvelope("tailscale", operation, "blocked_operation", { ok: false, resourceType: "tailscale_operation", adapter: "official_cli", operationClass: "blocked_internal_or_cert", mutating: true, command: "tailscale", argv: redactArgv(blocked[operation]) });
	if (!safeOperations.includes(operation)) return unsupportedOperation("tailscale", operation, known);
	if (!commandExists("tailscale")) return providerUnavailable("tailscale", "tailscale", operation);
	if (operation === "status" || operation === "devices") {
		const result = runProviderCli("tailscale", ["status", "--json"], { timeout: 15_000 });
		const raw = result.json;
		result.json = operation === "devices" ? summarizeTailscaleDevices(raw, args.limit) : summarizeTailscaleStatus(raw);
		delete result.stdout;
		return providerResult("tailscale", operation, operation === "devices" ? "tailnet_peer_summaries" : "tailnet_status", result);
	}
	if (operation === "whois") {
		const target = requiredArg(args, ["ip", "target"]);
		if (!target) return providerError("tailscale", operation, "missing_required_arg", { required: ["ip|target"] });
		const result = runProviderCli("tailscale", ["whois", target, "--json"], { timeout: 15_000 });
		result.json = sanitizeTailscaleJson(result.json);
		delete result.stdout;
		return providerResult("tailscale", operation, "tailscale_peer_whois", result);
	}
	if (operation === "ping") {
		const target = requiredArg(args, ["target", "host", "ip"]);
		if (!target) return providerError("tailscale", operation, "missing_required_arg", { required: ["target|host|ip"] });
		const result = runProviderCli("tailscale", ["ping", "--c", "3", "--json", target], { timeout: 15_000 });
		if (!result.json && result.stdout) result.json = parseJsonLines(result.stdout).map(sanitizeTailscaleJson);
		else result.json = sanitizeTailscaleJson(result.json);
		delete result.stdout;
		return providerResult("tailscale", operation, "tailscale_ping", result);
	}
	if (operation === "netcheck") {
		const result = runProviderCli("tailscale", ["netcheck", "--json"], { timeout: 30_000 });
		result.json = sanitizeTailscaleJson(result.json);
		delete result.stdout;
		return providerResult("tailscale", operation, "tailscale_netcheck", result);
	}
	if (operation === "cert") {
		const domain = requiredArg(args, ["domain", "name"]);
		if (!domain) return providerError("tailscale", operation, "missing_required_arg", { required: ["domain|name"] });
		return providerResult("tailscale", operation, "tailscale_cert", runProviderCli("tailscale", ["cert", domain], { timeout: 15_000 }));
	}
}

function pixellabPath() {
	return process.env.PIXELLAB_CLI_PATH || path.join(CODE_ROOT, "generated", "pixellab", "pixellab");
}

function callPixellab(operation, args) {
	const cli = pixellabPath();
	const safeOperations = ["status", "balance", "llms-txt", "characters-list", "characters-get", "characters-zip", "objects-list", "objects-get", "job-get", "tilesets-list", "tileset-get", "isometric-tiles-list", "isometric-tile-get", "tiles-pro-get"];
	const safeAliases = ["get-balance", "balance-get", "llms", "llms.txt", "list-characters", "characters", "get-characters", "character-get", "get-character", "characters/{character_id}", "characters-id-get", "character-zip", "download-character", "characters/{character_id}/zip", "characters-zip-get", "list-objects", "objects", "get-objects", "object-get", "get-object", "objects/{object_id}", "objects-id-get", "background-job-get", "background-jobs-get", "get-background-job", "background-jobs/{job_id}", "list-tilesets", "tilesets-list-get", "get-tilesets", "tilesets-get", "get-tileset", "tilesets/{tileset_id}", "tilesets-id-get", "list-isometric-tiles", "isometric-tiles-list-get", "get-isometric-tiles", "isometric-tiles-get", "get-isometric-tile", "isometric-tiles/{tile_id}", "isometric-tiles-id-get", "get-tiles-pro", "tiles-pro/{tile_id}", "tiles-pro-id-get"];
	const mutatingOperations = ["animate-character", "animate-object", "animate-with-skeleton", "animate-with-text", "animate-with-text-v2", "animate-with-text-v3", "characters-animations", "characters-tags", "create-character-pro", "create-character-state", "create-character-v3", "create-character-with-4-directions", "create-character-with-8-directions", "create-image-bitforge", "create-image-pixen", "create-image-pixflux", "create-isometric-tile", "create-object-state", "create-object-with-4-directions", "create-tiles-pro", "create-tileset", "create-tileset-sidescroller", "edit-animation-v2", "edit-image", "edit-images-v2", "estimate-skeleton", "generate-8-rotations-v2", "generate-8-rotations-v3", "generate-image-v2", "generate-ui-v2", "generate-with-style-v2", "image-to-pixelart", "inpaint", "inpaint-v3", "interpolation-v2", "map-objects", "objects-create", "objects-dismiss-review", "objects-select-frames", "objects-tags", "remove-background", "resize", "rotate", "tilesets", "tilesets-sidescroller", "transfer-outfit-v2"];
	const mutatingAliases = ["post-animate-character", "post-animate-object", "post-animate-with-skeleton", "post-animate-with-text", "post-animate-with-text-v2", "post-animate-with-text-v3", "create-character-animation", "post-characters-animations", "character-tags", "update-character-tags", "patch-characters-character_id-tags", "post-create-character-pro", "post-create-character-state", "post-create-character-v3", "post-create-character-with-4-directions", "post-create-character-with-8-directions", "post-create-image-bitforge", "post-create-image-pixen", "post-create-image-pixflux", "post-create-isometric-tile", "post-create-object-state", "post-create-object-with-4-directions", "post-create-tiles-pro", "post-create-tileset", "post-create-tileset-sidescroller", "post-edit-animation-v2", "post-edit-image", "post-edit-images-v2", "post-estimate-skeleton", "post-generate-8-rotations-v2", "post-generate-8-rotations-v3", "post-generate-image-v2", "post-generate-ui-v2", "post-generate-with-style-v2", "post-image-to-pixelart", "post-inpaint", "post-inpaint-v3", "post-interpolation-v2", "post-map-objects", "objects-create", "create-object", "post-objects", "dismiss-review", "object-dismiss-review", "post-objects-object_id-dismiss-review", "select-frames", "object-select-frames", "post-objects-object_id-select-frames", "object-tags", "update-object-tags", "patch-objects-object_id-tags", "post-remove-background", "post-resize", "post-rotate", "post-tilesets", "post-tilesets-sidescroller", "post-transfer-outfit-v2"];
	const blockedOperations = ["characters-delete", "objects-delete"];
	const blockedAliases = ["character-delete", "delete-character", "characters/{character_id}", "delete-characters-character_id", "object-delete", "delete-object", "objects/{object_id}", "delete-objects-object_id"];
	const isSafe = safeOperations.includes(operation) || safeAliases.includes(operation);
	const isMutating = mutatingOperations.includes(operation) || mutatingAliases.includes(operation);
	const isBlocked = blockedOperations.includes(operation) || blockedAliases.includes(operation);
	const known = [...safeOperations, ...safeAliases, ...mutatingOperations, ...mutatingAliases, ...blockedOperations, ...blockedAliases];
	if (!known.includes(operation)) return unsupportedOperation("pixellab", operation, known);
	if (!commandExists(cli)) return providerUnavailable("pixellab", cli, operation);
	const cliArgs = [operation, "--json"];
	const forward = (name, flag) => {
		if (args[name] !== undefined && args[name] !== null && String(args[name]).trim()) cliArgs.push(flag || `--${name}`, String(args[name]).trim());
	};
	forward("id", "--id");
	forward("character_id", "--character_id");
	forward("characterId", "--characterId");
	forward("object_id", "--object_id");
	forward("objectId", "--objectId");
	forward("tile_id", "--tile_id");
	forward("tileId", "--tileId");
	forward("tileset_id", "--tileset_id");
	forward("tilesetId", "--tilesetId");
	forward("job_id", "--job_id");
	forward("jobId", "--jobId");
	forward("limit", "--limit");
	if (isMutating || isBlocked) cliArgs.push("--args", JSON.stringify(args || {}));
	const result = runProviderCli(cli, cliArgs, { timeout: 45_000 });
	const payload = result.json || {};
	if (payload.status === "approval_required" || payload.status === "blocked_operation") {
		return providerEnvelope("pixellab", operation, payload.status, {
			ok: false,
			resourceType: payload.resourceType || "pixellab_resource",
			adapter: "generated_cli",
			operationClass: payload.policy && payload.policy.operationClass ? payload.policy.operationClass : (payload.status === "blocked_operation" ? "blocked_delete" : "mutating_network"),
			mutating: true,
			data: payload,
			cli: result,
		});
	}
	if (payload.status && payload.status !== "success") {
		return providerEnvelope("pixellab", operation, payload.status, {
			ok: false,
			resourceType: payload.resourceType || "pixellab_resource",
			adapter: "generated_cli",
			operationClass: isSafe ? "read_only_network" : "mutating_network",
			mutating: !isSafe,
			data: payload,
			cli: result,
		});
	}
	return providerResult("pixellab", operation, payload.resourceType || "pixellab_resource", result, { adapter: "generated_cli", operationClass: operation === "status" ? "read_only" : "read_only_network" });
}

function runwarePath() {
	return process.env.RUNWARE_CLI_PATH || path.join(CODE_ROOT, "generated", "runware", "runware");
}

function youtubePath() {
	return process.env.YOUTUBE_CLI_PATH || path.join(CODE_ROOT, "generated", "youtube", "youtube");
}

function callRunware(operation, args) {
	const cli = runwarePath();
	const readOnlyOps = {
		status: ["status"],
		"auth-status": ["auth", "status"],
		coverage: ["coverage"],
		"task-helpers": ["task", "helpers"],
	};
	const stagedOps = {
		"image-generate": ["image", "generate"],
		"image-inference": ["image", "inference"],
		"image-photo-maker": ["image", "photo-maker"],
		"photo-maker-generate": ["photo-maker", "generate"],
		"image-upload": ["image", "upload"],
		"image-upscale": ["image", "upscale"],
		"image-background-removal": ["image", "background-removal"],
		"image-remove-background": ["image", "remove-background"],
		"image-caption": ["image", "caption"],
		"image-controlnet-preprocess": ["image", "controlnet-preprocess"],
		"image-preprocess": ["image", "preprocess"],
		"image-vectorize": ["image", "vectorize"],
		"prompt-enhance": ["prompt", "enhance"],
		"models-upload": ["models", "upload"],
		"model-upload": ["model", "upload"],
		"video-generate": ["video", "generate"],
		"video-inference": ["video", "inference"],
		"video-caption": ["video", "caption"],
		"video-video-caption": ["video", "video-caption"],
		"video-upscale": ["video", "upscale"],
		"video-video-upscale": ["video", "video-upscale"],
		"video-background-removal": ["video", "background-removal"],
		"video-remove-background": ["video", "remove-background"],
		"audio-generate": ["audio", "generate"],
		"audio-inference": ["audio", "inference"],
		"text-generate": ["text", "generate"],
		"text-inference": ["text", "inference"],
		"3d-generate": ["3d", "generate"],
		"3d-inference": ["3d", "inference"],
		"media-storage": ["media", "storage"],
	};
	const known = ["models-search", "task-response", "task-details", ...Object.keys(readOnlyOps), ...Object.keys(stagedOps)];
	if (!known.includes(operation)) return unsupportedOperation("runware", operation, known);
	if (!commandExists(cli)) return providerUnavailable("runware", cli, operation);
	const cliArgs = [];
	const forward = (name, flag) => {
		if (args[name] !== undefined && args[name] !== null && String(args[name]).trim()) cliArgs.push(flag || `--${name}`, String(args[name]).trim());
	};
	if (readOnlyOps[operation]) {
		cliArgs.push(...readOnlyOps[operation]);
	} else if (operation === "models-search") {
		if (!process.env.RUNWARE_API_KEY) return providerUnavailable("runware", cli, operation);
		cliArgs.push("models", "search");
		forward("query", "--query");
		if (Array.isArray(args.tag)) args.tag.slice(0, 10).forEach((tag) => { if (String(tag).trim()) cliArgs.push("--tag", String(tag).trim()); });
		else forward("tag", "--tag");
		["category", "type", "architecture", "conditioning", "visibility", "limit", "offset", "timeout"].forEach((name) => forward(name, `--${name}`));
	} else if (operation === "task-response") {
		if (!process.env.RUNWARE_API_KEY) return providerUnavailable("runware", cli, operation);
		const taskUuid = requiredArg(args, ["task_uuid", "taskUuid", "taskUUID", "id"]);
		if (!taskUuid) return providerError("runware", operation, "missing_required_arg", { required: ["task_uuid|taskUuid|taskUUID|id"] });
		cliArgs.push("task", "response", taskUuid);
		if (args.number_results !== undefined && args.number_results !== null) cliArgs.push("--number-results", String(args.number_results));
		if (args.numberResults !== undefined && args.numberResults !== null) cliArgs.push("--number-results", String(args.numberResults));
		forward("timeout", "--timeout");
	} else if (operation === "task-details") {
		if (!process.env.RUNWARE_API_KEY) return providerUnavailable("runware", cli, operation);
		const taskUuid = requiredArg(args, ["task_uuid", "taskUuid", "taskUUID", "id"]);
		if (!taskUuid) return providerError("runware", operation, "missing_required_arg", { required: ["task_uuid|taskUuid|taskUUID|id"] });
		cliArgs.push("task", "details", taskUuid);
		forward("timeout", "--timeout");
	} else if (stagedOps[operation]) {
		cliArgs.push(...stagedOps[operation]);
		cliArgs.push("--args", JSON.stringify(args || {}));
	}
	if (["models-search", "task-response", "task-details"].includes(operation) && Object.keys(args || {}).length) cliArgs.push("--args", JSON.stringify(args || {}));
	const result = runProviderCli(cli, cliArgs, { timeout: 120_000 });
	if (result.json && result.json.ok === false) {
		const errorText = String(result.json.error || "");
		const status = errorText.startsWith("approval_required") ? "approval_required" : (errorText.startsWith("blocked") ? "blocked_operation" : "error");
		return providerEnvelope("runware", operation, status, {
			ok: false,
			resourceType: result.json.detail && result.json.detail.taskType ? result.json.detail.taskType : "runware_resource",
			adapter: "generated_cli",
			operationClass: status === "blocked_operation" ? "blocked_model_write" : (status === "approval_required" ? "mutating_network" : (operation === "status" ? "read_only" : "read_only_network")),
			mutating: status === "approval_required" || status === "blocked_operation",
			data: result.json,
			cli: result,
		});
	}
	return providerResult("runware", operation, operation === "status" || operation === "auth-status" ? "auth_status" : "runware_resource", result, { adapter: "generated_cli", operationClass: readOnlyOps[operation] ? "read_only" : "read_only_network" });
}

function callYoutube(operation, args = {}, parsed = null) {
	const cli = youtubePath();
	const mutatingOperations = ["auth-login", "auth-refresh"];
	const known = ["status", "auth-help", ...mutatingOperations, "videos-get", "search", "playlists-mine", "playlist-find", "playlist-items", "extraction-playlist", "latest-extraction", "captions-list"];
	if (!known.includes(operation)) return unsupportedOperation("youtube", operation, known);
	if (!commandExists(cli)) return providerUnavailable("youtube", cli, operation);
	if (mutatingOperations.includes(operation)) {
		const reason = String(parsed && parsed.opts.reason || "").trim();
		if (!parsed || parsed.opts["confirm-mutating"] !== true || !reason) {
			return providerEnvelope("youtube", operation, "approval_required", {
				ok: false,
				resourceType: "youtube_auth_operation",
				adapter: "generated_cli",
				operationClass: "local_write_network_auth",
				mutating: true,
				required: ["--confirm-mutating", "--reason <non-empty>"],
				message: "YouTube auth operations perform network OAuth and write local credential files; explicit Toolbelt approval is required.",
			});
		}
	}
	if (operation === "videos-get" && !requiredArg(args, ["ids", "id", "videoId", "url"])) return providerError("youtube", operation, "missing_required_arg", { required: ["ids|id|videoId|url"] });
	if (operation === "captions-list" && !requiredArg(args, ["id", "videoId", "url"])) return providerError("youtube", operation, "missing_required_arg", { required: ["id|videoId|url"] });
	if (operation === "search" && !requiredArg(args, ["query", "q"])) return providerError("youtube", operation, "missing_required_arg", { required: ["query|q"] });
	if (operation === "playlist-find" && !requiredArg(args, ["title", "playlistTitle", "name"])) return providerError("youtube", operation, "missing_required_arg", { required: ["title|playlistTitle|name"] });
	if (operation === "playlist-items" && !requiredArg(args, ["playlistId", "playlist_id", "id"])) return providerError("youtube", operation, "missing_required_arg", { required: ["playlistId|playlist_id|id"] });
	const result = runProviderCli(cli, [operation, "--json", "--args", JSON.stringify(args || {})], { timeout: 120_000 });
	if (result.json && result.json.ok === false) {
		const status = String(result.json.status || "error");
		return providerEnvelope("youtube", operation, status, {
			ok: false,
			resourceType: result.json.resourceType || "youtube_resource",
			adapter: "generated_cli",
			operationClass: mutatingOperations.includes(operation) ? "local_write_network_auth" : (operation === "status" || operation === "auth-help" ? "read_only" : "read_only_network"),
			mutating: mutatingOperations.includes(operation),
			data: result.json.data || null,
			cli: result,
		});
	}
	return providerResult("youtube", operation, operation === "status" || operation === "auth-help" ? "auth_status" : "youtube_resource", result, { adapter: "generated_cli", operationClass: mutatingOperations.includes(operation) ? "local_write_network_auth" : (operation === "status" || operation === "auth-help" ? "read_only" : "read_only_network"), mutating: mutatingOperations.includes(operation) });
}

function callPortalBg(operation, args, parsed) {
	const cli = portalPath();
	const dbPath = path.join(os.homedir(), ".portal", "portal.db");
	if (operation === "detail") {
		const url = requiredArg(args, ["url", "listingUrl"]);
		if (!url) return providerError("portal-bg", operation, "missing_required_arg", { required: ["url|listingUrl"] });
		if (!isPortalListingUrl(url)) return providerError("portal-bg", operation, "invalid_arg", { arg: "url", expected: "https://www.portal.example/obiava-..." });
	}
	if (operation === "sync") {
		const reason = String((parsed && parsed.opts.reason) || "").trim();
		if (!parsed || parsed.opts["confirm-mutating"] !== true || !reason) {
			return providerEnvelope("portal-bg", operation, "approval_required", {
				ok: false,
				operationClass: "local_write_network",
				mutating: true,
				required: ["--confirm-mutating", "--reason <non-empty>"],
				message: "portal-bg sync hits portal.example and writes the local SQLite cache; explicit mutating approval and reason are required.",
			});
		}
	}
	if (!commandExists(cli)) return providerUnavailable("portal-bg", cli, operation);
	if (operation === "status") {
		return providerCompositeResult("portal-bg", operation, "cli_status", {
			help: runProviderCli(cli, ["--help"]),
			database: { ok: true, path: dbPath, exists: fs.existsSync(dbPath), valuesPrinted: false },
		}, { adapter: "local_cli" });
	}
	if (operation === "cities") {
		const result = runProviderCli(cli, ["cities"]);
		result.json = parsePortalCities(result.stdout || result.stderr);
		return providerResult("portal-bg", operation, "cities", result, { adapter: "local_cli" });
	}
	if (operation === "local" || operation === "stats") {
		const cliArgs = [operation, "--json"];
		addPortalSearchFlags(cliArgs, args, { pages: 1 });
		const result = applyResultLimit(runProviderCli(cli, cliArgs), args.limit);
		if (operation === "stats" && !result.json) result.json = parsePortalStats(result.stdout || result.stderr);
		return providerResult("portal-bg", operation, operation === "local" ? "local_listings" : "market_stats", result, { adapter: "local_cli" });
	}
	if (operation === "search") {
		const cliArgs = ["search", "--json"];
		addPortalSearchFlags(cliArgs, args, { pages: 1 });
		return providerResult("portal-bg", operation, "live_listings", applyResultLimit(runProviderCli(cli, cliArgs, { timeout: 120_000 }), args.limit), { adapter: "local_cli", operationClass: "read_only_network" });
	}
	if (operation === "detail") {
		const url = requiredArg(args, ["url", "listingUrl"]);
		if (!url) return providerError("portal-bg", operation, "missing_required_arg", { required: ["url|listingUrl"] });
		if (!isPortalListingUrl(url)) return providerError("portal-bg", operation, "invalid_arg", { arg: "url", expected: "https://www.portal.example/obiava-..." });
		return providerResult("portal-bg", operation, "listing_detail", runProviderCli(cli, ["detail", url, "--json"], { timeout: 60_000 }), { adapter: "local_cli", operationClass: "read_only_network" });
	}
	if (operation === "sync") {
		const city = requiredArg(args, ["city"]);
		if (!city) return providerError("portal-bg", operation, "missing_required_arg", { required: ["city"], operationClass: "local_write_network", mutating: true });
		const cliArgs = ["sync", "--json"];
		addPortalSearchFlags(cliArgs, args, { pages: 1 });
		const result = runProviderCli(cli, cliArgs, { timeout: 180_000 });
		if (!result.json) result.json = parsePortalSync(result.stdout || result.stderr);
		return providerResult("portal-bg", operation, "sync_result", result, { adapter: "local_cli", operationClass: "local_write_network", mutating: true });
	}
	return unsupportedOperation("portal-bg", operation, ["status", "cities", "local", "stats", "search", "detail", "sync"]);
}

function studioPath() {
	return process.env.STUDIO_CLI_PATH || path.join(CODE_ROOT, "generated", "studio", "studio");
}

function vpsPath() {
	return path.join(CODE_ROOT, "generated", "vps", "vps");
}

/**
 * VPS host generated-CLI adapter. No official VPS host CLI exists, so this
 * bridges the generated REST v1 CLI. VPSHOST_API_KEY lives in the Toolbelt
 * .env and is read by the CLI only — never returned, never logged.
 * Mutations (power state, snapshots, firewall, DNS, billing) are represented
 * and gated; the generated CLI refuses to execute them regardless.
 */
function callVPS host(operation, args = {}, parsed = null) {
	const cli = vpsPath();
	const safeOperations = ["status", "vps-list", "vps-get", "vps-metrics", "vps-backups", "vps-snapshot", "vps-actions", "vps-datacenters", "vps-templates", "vps-plans", "firewall-list", "firewall-get", "domains-list", "domains-get", "domains-availability", "dns-records", "dns-snapshots", "billing-subscriptions", "billing-catalog", "billing-orders"];
	const mutatingOperations = ["vps-start", "vps-stop", "vps-restart", "vps-recreate", "vps-setup", "vps-hostname-set", "vps-root-password-set", "vps-nameservers-set", "vps-snapshot-create", "vps-snapshot-restore", "vps-snapshot-delete", "vps-backup-restore", "vps-backup-delete", "firewall-create", "firewall-delete", "firewall-activate", "firewall-deactivate", "firewall-rule-create", "firewall-rule-update", "firewall-rule-delete", "domains-purchase", "domains-renew", "domains-nameservers-set", "domains-privacy-enable", "domains-privacy-disable", "domains-lock", "domains-unlock", "dns-record-set", "dns-record-delete", "dns-snapshot-restore", "billing-order-create", "billing-subscription-cancel"];
	const known = [...safeOperations, ...mutatingOperations];
	if (!known.includes(operation)) return unsupportedOperation("vps", operation, known);
	if (!commandExists(cli)) return providerUnavailable("vps", cli, operation);
	const mutating = mutatingOperations.includes(operation);
	if (mutating) {
		const reason = parsed && typeof parsed.opts.reason === "string" ? parsed.opts.reason.trim() : "";
		if (!parsed || parsed.opts["confirm-mutating"] !== true || !reason) {
			return providerEnvelope("vps", operation, "approval_required", {
				ok: false,
				operationClass: "external_write",
				mutating: true,
				required: ["--confirm-mutating", "--reason <non-empty>"],
				message: "VPS host VPS power/snapshot/firewall/DNS/billing changes require explicit mutating approval and reason.",
			});
		}
	}
	const result = runProviderCli(cli, [operation, "--args", JSON.stringify(args)], { timeout: 45_000 });
	return providerResult("vps", operation, "vps_resource", result, {
		adapter: "generated_cli",
		operationClass: mutating ? "external_write" : "read_only_network",
		mutating,
	});
}

function callStudio(operation, args = {}, parsed = null) {
	const cli = studioPath();
	const safeOperations = ["status", "intelligence-status", "intelligence-get", "opportunity-list", "opportunity-get", "cost-summary"];
	const mutatingOperations = ["intelligence-start", "opportunity-update"];
	const known = [...safeOperations, ...mutatingOperations];
	if (!known.includes(operation)) return unsupportedOperation("studio", operation, known);
	if (!commandExists(cli)) return providerUnavailable("studio", cli, operation);
	const mutating = mutatingOperations.includes(operation);
	if (mutating) {
		const reason = parsed && typeof parsed.opts.reason === "string" ? parsed.opts.reason.trim() : "";
		if (!parsed || parsed.opts["confirm-mutating"] !== true || !reason) {
			return providerEnvelope("studio", operation, "approval_required", {
				ok: false,
				operationClass: "external_write",
				mutating: true,
				required: ["--confirm-mutating", "--reason <non-empty>"],
				message: "Starting an intelligence run or changing opportunity state requires explicit mutating approval and reason.",
			});
		}
	}
	const result = runProviderCli(cli, [operation, "--args", JSON.stringify(args)], { timeout: 40_000 });
	return providerResult("studio", operation, result.json && result.json.resourceType ? result.json.resourceType : "studio_resource", result, {
		adapter: "generated_cli",
		operationClass: mutating ? "external_write" : "read_only_network",
		mutating,
	});
}

function pallyRoot() {
	return process.env.PALLY_ROOT || path.join(os.homedir(), "projects", "polymarket-trading-bot");
}

function pallyPython() {
	const venvPython = path.join(pallyRoot(), ".venv", "bin", "python");
	return fs.existsSync(venvPython) ? venvPython : "python3";
}

function pallyRun(args, options = {}) {
	return runProviderCli(pallyPython(), ["-m", "pally_app", ...args], { cwd: pallyRoot(), timeout: options.timeout || 60_000 });
}

function pallyFileJson(relativePath) {
	const file = path.join(pallyRoot(), relativePath);
	if (!fs.existsSync(file)) return { ok: false, path: file, exists: false, valuesPrinted: false };
	try {
		return { ok: true, path: file, exists: true, json: JSON.parse(fs.readFileSync(file, "utf8")), valuesPrinted: false };
	} catch (error) {
		return { ok: false, path: file, exists: true, error: String(error && error.message || error), valuesPrinted: false };
	}
}

function callPally(operation, args = {}, parsed = null) {
	const root = pallyRoot();
	const known = ["status", "help", "doctor", "readiness", "dashboard", "live-boundary", "account-readonly", "manual", "demo-dry-run", "shadow-live", "export-bundle"];
	if (!fs.existsSync(root)) return providerError("pally", operation, "unavailable", { root, message: "Pally project root not found" });
	if (operation === "status") {
		return providerCompositeResult("pally", operation, "pally_status", {
			git: runProviderCli("git", ["status", "--short", "--branch"], { cwd: root, timeout: 15_000 }),
			help: pallyRun(["--help"], { timeout: 20_000 }),
			paperDoctor: runProviderCli("python3", ["scripts/doctor.py", "--mode", "paper", "--json"], { cwd: root, timeout: 20_000 }),
			demoDoctor: runProviderCli("python3", ["scripts/doctor.py", "--mode", "demo", "--json"], { cwd: root, timeout: 20_000 }),
			readiness: pallyFileJson("reports/readiness_gate.json"),
		}, { adapter: "local_cli", operationClass: "read_only" });
	}
	if (operation === "help") return providerResult("pally", operation, "cli_help", pallyRun(["--help"], { timeout: 20_000 }), { adapter: "local_cli" });
	if (operation === "doctor") {
		const mode = String(args.mode || "paper").trim().toLowerCase();
		if (!["paper", "demo", "real"].includes(mode)) return providerError("pally", operation, "invalid_arg", { arg: "mode", allowed: ["paper", "demo", "real"] });
		return providerResult("pally", operation, "doctor", runProviderCli("python3", ["scripts/doctor.py", "--mode", mode, "--json"], { cwd: root, timeout: 20_000 }), { adapter: "local_cli" });
	}
	if (operation === "readiness") {
		return providerEnvelope("pally", operation, "success", { resourceType: "readiness_report", adapter: "local_file", data: pallyFileJson("reports/readiness_gate.json"), root, valuesPrinted: false });
	}
	if (operation === "dashboard") {
		const cliArgs = ["watch-dashboard", "--format", "json", "--once"];
		if (args.events_jsonl || args.eventsJsonl) cliArgs.push("--events-jsonl", String(args.events_jsonl || args.eventsJsonl));
		if (args.engine_report || args.engineReport) cliArgs.push("--engine-report", String(args.engine_report || args.engineReport));
		cliArgs.push("--readiness-report", String(args.readiness_report || args.readinessReport || "reports/readiness_gate.json"));
		return providerResult("pally", operation, "dashboard", pallyRun(cliArgs, { timeout: 30_000 }), { adapter: "local_cli" });
	}
	if (operation === "live-boundary") return providerResult("pally", operation, "live_boundary", pallyRun(["live-boundary-check", "--json"], { timeout: 20_000 }), { adapter: "local_cli" });
	if (operation === "account-readonly") return providerResult("pally", operation, "account_readonly", pallyRun(["account-readonly-check", "--json"], { timeout: 30_000 }), { adapter: "local_cli", operationClass: "read_only_network_optional" });
	if (operation === "manual") {
		const manual = path.join(root, "docs", "pally_operations_manual.html");
		return providerEnvelope("pally", operation, fs.existsSync(manual) ? "success" : "missing", { ok: fs.existsSync(manual), resourceType: "manual", adapter: "local_file", path: manual, exists: fs.existsSync(manual), valuesPrinted: false });
	}
	if (operation === "demo-dry-run" || operation === "shadow-live" || operation === "export-bundle") {
		const reason = String((parsed && parsed.opts.reason) || "").trim();
		if (!parsed || parsed.opts["confirm-mutating"] !== true || !reason) {
			return providerEnvelope("pally", operation, "approval_required", { ok: false, operationClass: "local_write", mutating: true, required: ["--confirm-mutating", "--reason <non-empty>"], message: "Pally operation writes local run/export artifacts; explicit mutating approval and reason are required." });
		}
		if (operation === "demo-dry-run") return providerResult("pally", operation, "demo_run", pallyRun(["public-paper-daemon", "--dry-run", "--once", "--out-dir", String(args.out_dir || args.outDir || "runs/toolbelt-demo-dry-run")], { timeout: 60_000 }), { adapter: "local_cli", operationClass: "local_write", mutating: true });
		if (operation === "shadow-live") {
			const cliArgs = ["shadow-live"];
			if (args.once !== false) cliArgs.push("--once");
			if (args.acknowledgePublicNetwork || args.acknowledged_public_network || args.iUnderstandPublicNetwork) cliArgs.push("--i-understand-public-network");
			if (args.out_dir || args.outDir) cliArgs.push("--out-dir", String(args.out_dir || args.outDir));
			if (args.limit) cliArgs.push("--limit", String(args.limit));
			if (args.max_requests || args.maxRequests) cliArgs.push("--max-requests", String(args.max_requests || args.maxRequests));
			if (args.iterations) cliArgs.push("--iterations", String(args.iterations));
			if (args.interval_seconds || args.intervalSeconds) cliArgs.push("--interval-seconds", String(args.interval_seconds || args.intervalSeconds));
			if (args.starting_cash || args.startingCash) cliArgs.push("--starting-cash", String(args.starting_cash || args.startingCash));
			const slugs = Array.isArray(args.market_slug) ? args.market_slug : Array.isArray(args.marketSlug) ? args.marketSlug : (args.market_slug || args.marketSlug ? [args.market_slug || args.marketSlug] : []);
			for (const slug of slugs) cliArgs.push("--market-slug", String(slug));
			const opClass = cliArgs.includes("--i-understand-public-network") ? "local_write_network" : "local_write";
			return providerResult("pally", operation, "shadow_live", pallyRun(cliArgs, { timeout: 120_000 }), { adapter: "local_cli", operationClass: opClass, mutating: true });
		}
		return providerResult("pally", operation, "export_bundle", runProviderCli("bash", ["scripts/export_run_bundle.sh", "--mode", String(args.mode || "demo")], { cwd: root, timeout: 120_000 }), { adapter: "local_cli", operationClass: "local_write", mutating: true });
	}
	return unsupportedOperation("pally", operation, known);
}

function audibleCliPath() {
	const local = path.join(os.homedir(), ".local", "bin", "audible");
	if (commandExists(local)) return local;
	return "audible";
}

function audibleProfileArgs(args = {}) {
	const profile = requiredArg(args, ["profile"]);
	if (!profile) return [];
	if (!/^[A-Za-z0-9_.-]{1,64}$/.test(profile)) return null;
	return ["-P", profile];
}

function audibleManualApproval(operation, command, message) {
	return providerEnvelope("audible", operation, "approval_required", {
		ok: false,
		resourceType: "audible_operation",
		adapter: "official_cli",
		operationClass: "auth_or_local_write_network",
		mutating: true,
		message,
		manualCommand: command,
		valuesPrinted: false,
		policy: { secretValuesAccepted: false, activationBytesPrinted: false, authTokensPrinted: false },
	});
}

function callAudible(operation, args = {}) {
	const cli = audibleCliPath();
	const safeOperations = ["status", "profiles", "library-list"];
	const mutating = ["quickstart", "download", "library-export", "decrypt"];
	const blocked = ["activation-bytes"];
	const known = [...safeOperations, ...mutating, ...blocked];
	if (!known.includes(operation)) return unsupportedOperation("audible", operation, known);
	if (!commandExists(cli)) return providerUnavailable("audible", cli, operation);

	const configDir = path.join(os.homedir(), ".audible");
	const configFile = path.join(configDir, "config.toml");
	const authFiles = fs.existsSync(configDir) ? fs.readdirSync(configDir).filter((name) => name.endsWith(".auth")) : [];
	const profileArgs = audibleProfileArgs(args);
	if (profileArgs === null) return providerError("audible", operation, "invalid_arg", { arg: "profile", expected: "1-64 chars: letters, numbers, dot, underscore, dash" });

	if (operation === "activation-bytes") {
		return providerEnvelope("audible", operation, "blocked_operation", {
			ok: false,
			resourceType: "audible_secret",
			adapter: "official_cli",
			operationClass: "secret_output_blocked",
			mutating: false,
			message: "activation-bytes prints an account decryption secret; run it manually only if needed and never paste the value into Pi chat or Toolbelt.",
			valuesPrinted: false,
		});
	}
	if (operation === "quickstart") return audibleManualApproval(operation, "audible quickstart", "Interactive Audible authentication must run in the operator's terminal so credentials/tokens stay outside Pi and Toolbelt logs.");
	if (operation === "download") return audibleManualApproval(operation, "audible download --help", "Audible downloads perform network and local write operations; use explicit manual commands after choosing profile/marketplace and output directory.");
	if (operation === "library-export") return audibleManualApproval(operation, "audible library export --format json --output /home/operator/audiobooks/audible/metadata/library.json", "Library export writes local metadata and may reveal library contents; run after explicit profile/marketplace selection.");
	if (operation === "decrypt") return audibleManualApproval(operation, "ffmpeg ...", "Decrypt/convert needs activation bytes or per-title AAXC keys; Toolbelt must not accept or print those secrets.");

	if (operation === "status") {
		const version = runProviderCli(cli, ["--version"], { timeout: 15_000 });
		const profiles = fs.existsSync(configFile) ? runProviderCli(cli, ["manage", "profile", "list"], { timeout: 15_000 }) : null;
		return providerCompositeResult("audible", operation, "cli_auth_readiness", {
			version,
			config: { ok: true, exists: fs.existsSync(configFile), dir: configDir, authFileCount: authFiles.length, valuesPrinted: false },
			profiles: profiles || { ok: true, skipped: "no_config_file", valuesPrinted: false },
		}, { adapter: "official_cli" });
	}
	if (operation === "profiles") {
		if (!fs.existsSync(configFile)) return providerError("audible", operation, "not_authenticated", { message: "Run audible quickstart manually first.", config: { exists: false, valuesPrinted: false } });
		return providerResult("audible", operation, "profiles", runProviderCli(cli, ["manage", "profile", "list"], { timeout: 15_000 }), { adapter: "official_cli" });
	}
	if (operation === "library-list") {
		if (!fs.existsSync(configFile)) return providerError("audible", operation, "not_authenticated", { message: "Run audible quickstart manually first.", config: { exists: false, valuesPrinted: false } });
		const cliArgs = [...profileArgs, "library", "list"];
		optionalString(args, "startDate", cliArgs, "--start-date");
		optionalString(args, "endDate", cliArgs, "--end-date");
		if (args.resolvePodcasts) cliArgs.push("--resolve-podcasts");
		return providerResult("audible", operation, "library_items", runProviderCli(cli, cliArgs, { timeout: 60_000 }), { adapter: "official_cli", operationClass: "read_only_network" });
	}
	return unsupportedOperation("audible", operation, known);
}

function notebooklmCliPath() {
	const local = path.join(os.homedir(), ".local", "bin", "notebooklm");
	if (commandExists(local)) return local;
	return "notebooklm";
}

function notebooklmId(value, name = "id") {
	if (!value) return null;
	const id = String(value).trim();
	if (!/^[A-Za-z0-9_-]{3,80}$/.test(id)) return { error: providerError("notebooklm", null, "invalid_arg", { arg: name, expected: "3-80 chars: letters, numbers, underscore, dash" }) };
	return id;
}

function notebooklmOutputPath(value) {
	const output = String(value || "").trim();
	if (!output) return null;
	if (containsSecretValue(output) || /[?&](token|key|secret|password)=/i.test(output)) return { error: providerError("notebooklm", null, "invalid_arg", { arg: "outputPath", expected: "non-secret local path" }) };
	return output;
}

function notebooklmApproval(operation, cliArgs, message) {
	return providerEnvelope("notebooklm", operation, "approval_required", {
		ok: false,
		resourceType: "notebooklm_operation",
		adapter: "unofficial_cli",
		operationClass: "local_write_or_network_generation",
		mutating: true,
		required: ["--confirm-mutating", "--reason <non-empty>"],
		message,
		command: "notebooklm",
		argv: redactArgv(cliArgs),
		valuesPrinted: false,
		policy: { secretValuesAccepted: false, authTokensPrinted: false },
	});
}

function requireNotebooklmApproval(operation, cliArgs, parsed) {
	const reason = String(parsed && parsed.opts.reason || "").trim();
	if (!parsed || parsed.opts["confirm-mutating"] !== true || !reason) {
		return notebooklmApproval(operation, cliArgs, "NotebookLM notebook/source creation, artifact generation, and downloads can write local files or create remote artifacts; explicit Toolbelt approval is required.");
	}
	return null;
}

function notebooklmAddNotebookArg(cliArgs, args) {
	const notebook = notebooklmId(requiredArg(args, ["notebook", "notebookId"]), "notebook");
	if (notebook && notebook.error) return notebook.error;
	if (notebook) cliArgs.push("--notebook", notebook);
	return null;
}

function callNotebooklm(operation, args = {}, parsed = null) {
	const cli = notebooklmCliPath();
	const safeOperations = ["status", "list", "source-list", "source-wait", "source-fulltext", "source-guide", "artifact-list", "artifact-wait", "ask", "metadata"];
	const mutatingOperations = ["create", "source-add", "generate-report", "generate-audio", "generate-slide-deck", "generate-infographic", "generate-quiz", "generate-flashcards", "generate-mind-map", "generate-video", "download-report", "download-audio", "download-slide-deck", "download-infographic", "download-quiz", "download-flashcards", "download-mind-map", "download-video"];
	const blockedOperations = ["delete", "source-delete", "artifact-delete"];
	const known = [...safeOperations, ...mutatingOperations, ...blockedOperations];
	if (!known.includes(operation)) return unsupportedOperation("notebooklm", operation, known);
	if (!commandExists(cli)) return providerUnavailable("notebooklm", cli, operation);

	if (blockedOperations.includes(operation)) {
		return providerEnvelope("notebooklm", operation, "blocked_operation", {
			ok: false,
			resourceType: "notebooklm_operation",
			adapter: "unofficial_cli",
			operationClass: "destructive_remote_delete_blocked",
			mutating: true,
			message: "NotebookLM delete operations are blocked through Toolbelt. Run manually only after explicit review.",
			valuesPrinted: false,
		});
	}

	if (operation === "status") {
		const storage = path.join(os.homedir(), ".notebooklm", "storage_state.json");
		return providerCompositeResult("notebooklm", operation, "cli_auth_readiness", {
			version: runProviderCli(cli, ["--version"], { timeout: 15_000 }),
			auth: runProviderCli(cli, ["auth", "check"], { timeout: 60_000 }),
			storage: { ok: true, path: storage, exists: fs.existsSync(storage), valuesPrinted: false },
			context: runProviderCli(cli, ["status"], { timeout: 60_000 }),
		}, { adapter: "unofficial_cli" });
	}
	if (operation === "list") return providerResult("notebooklm", operation, "notebooks", runProviderCli(cli, ["list", "--json"], { timeout: 90_000 }), { adapter: "unofficial_cli", operationClass: "read_only_network" });

	const cliArgs = [];
	const notebookArgError = notebooklmAddNotebookArg(cliArgs, args);
	if (notebookArgError) return notebookArgError;

	if (operation === "source-list") return providerResult("notebooklm", operation, "sources", runProviderCli(cli, ["source", "list", ...cliArgs, "--json"], { timeout: 90_000 }), { adapter: "unofficial_cli", operationClass: "read_only_network" });
	if (operation === "artifact-list") return providerResult("notebooklm", operation, "artifacts", runProviderCli(cli, ["artifact", "list", ...cliArgs, "--json"], { timeout: 90_000 }), { adapter: "unofficial_cli", operationClass: "read_only_network" });
	if (operation === "metadata") return providerResult("notebooklm", operation, "metadata", runProviderCli(cli, ["metadata", ...cliArgs, "--json"], { timeout: 90_000 }), { adapter: "unofficial_cli", operationClass: "read_only_network" });
	if (operation === "ask") {
		const query = requiredArg(args, ["query", "question"]);
		if (!query) return providerError("notebooklm", operation, "missing_required_arg", { required: ["query|question"] });
		return providerResult("notebooklm", operation, "answer", runProviderCli(cli, ["ask", query, ...cliArgs, "--json"], { timeout: 180_000 }), { adapter: "unofficial_cli", operationClass: "read_only_network" });
	}
	if (operation === "source-wait" || operation === "source-fulltext" || operation === "source-guide" || operation === "artifact-wait") {
		const id = notebooklmId(requiredArg(args, ["id", "sourceId", "artifactId"]), "id");
		if (!id) return providerError("notebooklm", operation, "missing_required_arg", { required: ["id"] });
		if (id.error) return id.error;
		const group = operation.startsWith("source-") ? "source" : "artifact";
		const sub = operation.replace(/^source-/, "").replace(/^artifact-/, "");
		const waitArgs = [group, sub, id, ...cliArgs];
		if (operation.endsWith("wait")) waitArgs.push("--timeout", boundedLimit(args.timeout, 300, 1800));
		waitArgs.push("--json");
		return providerResult("notebooklm", operation, operation.replace("-", "_"), runProviderCli(cli, waitArgs, { timeout: Math.max(60_000, (Number(args.timeout) || 300) * 1000 + 15_000) }), { adapter: "unofficial_cli", operationClass: "read_only_network" });
	}

	let finalArgs = null;
	if (operation === "create") {
		const title = requiredArg(args, ["title", "name"]);
		if (!title) return providerError("notebooklm", operation, "missing_required_arg", { required: ["title|name"] });
		finalArgs = ["create", title, "--json"];
	} else if (operation === "source-add") {
		const content = requiredArg(args, ["content", "path", "url", "text"]);
		if (!content) return providerError("notebooklm", operation, "missing_required_arg", { required: ["content|path|url|text"] });
		finalArgs = ["source", "add", content, ...cliArgs];
		optionalString(args, "type", finalArgs, "--type");
		optionalString(args, "title", finalArgs, "--title");
		finalArgs.push("--json");
	} else if (operation.startsWith("generate-")) {
		const type = operation.slice("generate-".length);
		const description = requiredArg(args, ["description", "prompt", "instructions"]);
		finalArgs = ["generate", type, ...cliArgs];
		optionalString(args, "format", finalArgs, "--format");
		optionalString(args, "length", finalArgs, "--length");
		optionalString(args, "language", finalArgs, "--language");
		if (args.wait) finalArgs.push("--wait"); else finalArgs.push("--no-wait");
		finalArgs.push("--retry", boundedLimit(args.retry, 2, 10), "--json");
		if (description) finalArgs.push(description);
	} else if (operation.startsWith("download-")) {
		const type = operation.slice("download-".length);
		const output = notebooklmOutputPath(requiredArg(args, ["outputPath", "output", "path"]));
		if (output && output.error) return output.error;
		finalArgs = ["download", type, ...cliArgs];
		const artifact = notebooklmId(requiredArg(args, ["artifact", "artifactId"]), "artifact");
		if (artifact && artifact.error) return artifact.error;
		if (artifact) finalArgs.push("--artifact", artifact);
		optionalString(args, "format", finalArgs, "--format");
		if (args.all) finalArgs.push("--all");
		if (args.force !== false) finalArgs.push("--force");
		finalArgs.push("--json");
		if (output) finalArgs.push(output);
	}
	if (!finalArgs) return unsupportedOperation("notebooklm", operation, known);
	const approval = requireNotebooklmApproval(operation, finalArgs, parsed);
	if (approval) return approval;
	return providerResult("notebooklm", operation, "notebooklm_result", runProviderCli(cli, finalArgs, { timeout: operation.startsWith("download-") ? 600_000 : 300_000 }), { adapter: "unofficial_cli", operationClass: "local_write_or_network_generation", mutating: true });
}

function stitchPath() {
	return process.env.STITCH_CLI_PATH || path.join(CODE_ROOT, "generated", "stitch", "stitch");
}

function stitchApproval(operation, cliArgs) {
	return providerEnvelope("stitch", operation, "approval_required", {
		ok: false,
		resourceType: "stitch_operation",
		adapter: "generated_cli",
		operationClass: operation === "init" ? "local_write" : "mutating_network_generation",
		mutating: true,
		required: ["--confirm-mutating", "--reason <non-empty>"],
		command: stitchPath(),
		argv: redactArgv(cliArgs),
		message: operation === "init"
			? "Stitch init writes a project-local .stitch workspace; explicit Toolbelt approval is required."
			: "Stitch generation creates remote Stitch project/screen artifacts and writes local outputs; explicit Toolbelt approval is required.",
	});
}

function addStitchArg(cliArgs, args, sourceName, flagName) {
	const value = args[sourceName];
	if (value !== undefined && value !== null && String(value).trim()) cliArgs.push(flagName, String(value).trim());
}

function callStitch(operation, args = {}, parsed) {
	const cli = stitchPath();
	const safeOperations = ["status", "list-tools", "list-projects"];
	const mutatingOperations = ["init", "generate", "batch"];
	const known = [...safeOperations, ...mutatingOperations];
	if (!known.includes(operation)) return unsupportedOperation("stitch", operation, known);
	if (!commandExists(cli)) return providerUnavailable("stitch", cli, operation);

	const cliArgs = [operation, "--json"];
	addStitchArg(cliArgs, args, "cwd", "--cwd");
	addStitchArg(cliArgs, args, "projectId", "--project-id");
	addStitchArg(cliArgs, args, "project_id", "--project-id");
	addStitchArg(cliArgs, args, "projectTitle", "--project-title");
	addStitchArg(cliArgs, args, "project_title", "--project-title");
	addStitchArg(cliArgs, args, "designFile", "--design-file");
	addStitchArg(cliArgs, args, "design_file", "--design-file");
	addStitchArg(cliArgs, args, "promptFile", "--prompt-file");
	addStitchArg(cliArgs, args, "prompt_file", "--prompt-file");
	addStitchArg(cliArgs, args, "prompt", "--prompt");
	addStitchArg(cliArgs, args, "device", "--device");
	addStitchArg(cliArgs, args, "outputDir", "--output-dir");
	addStitchArg(cliArgs, args, "output_dir", "--output-dir");
	addStitchArg(cliArgs, args, "assetId", "--asset-id");
	addStitchArg(cliArgs, args, "asset_id", "--asset-id");
	addStitchArg(cliArgs, args, "slug", "--slug");
	addStitchArg(cliArgs, args, "manifest", "--manifest");
	addStitchArg(cliArgs, args, "phase", "--phase");
	addStitchArg(cliArgs, args, "board", "--board");
	addStitchArg(cliArgs, args, "limit", "--limit");
	if (args.force === true) cliArgs.push("--force");
	if (args.includeGenerated === true || args.include_generated === true) cliArgs.push("--include-generated");
	if (args.continueOnError === true || args.continue_on_error === true) cliArgs.push("--continue-on-error");
	if (args.dryRun === true || args.dry_run === true) cliArgs.push("--dry-run");

	if (mutatingOperations.includes(operation)) {
		const reason = String(parsed && parsed.opts.reason || "").trim();
		if (!parsed || parsed.opts["confirm-mutating"] !== true || !reason) return stitchApproval(operation, cliArgs);
	}

	const cwd = args.cwd && String(args.cwd).trim() ? path.resolve(String(args.cwd).trim()) : process.cwd();
	const spawnCwd = fs.existsSync(cwd) ? cwd : process.cwd();
	const result = runProviderCli(cli, cliArgs, { cwd: spawnCwd, timeout: operation === "batch" ? 43_200_000 : (operation === "generate" ? 420_000 : 90_000) });
	return providerResult("stitch", operation, operation === "status" ? "auth_status" : (operation === "generate" ? "stitch_screen" : (operation === "batch" ? "stitch_batch" : "stitch_resource")), result, { adapter: "generated_cli", operationClass: mutatingOperations.includes(operation) ? (operation === "init" ? "local_write" : "mutating_network_generation") : "read_only_network", mutating: mutatingOperations.includes(operation) });
}

function callClaudeCode(operation) {
	const known = ["status"];
	if (!known.includes(operation)) return unsupportedOperation("claude-code", operation, known);
	const installed = commandExists("claude");
	const version = installed ? runProviderCli("claude", ["--version"], { timeout: 20_000 }) : { ok: false, skipped: true };
	const authStatus = installed ? runProviderCli("env", ["-u", "ANTHROPIC_API_KEY", "claude", "auth", "status"], { timeout: 20_000 }) : { ok: false, skipped: true };
	const authJson = authStatus.json && typeof authStatus.json === "object" && !Array.isArray(authStatus.json) ? authStatus.json : {};
	const usesSubscription = authStatus.ok && authJson.authMethod === "claude.ai" && Boolean(authJson.subscriptionType);
	return providerEnvelope("claude-code", operation, installed && usesSubscription ? "success" : (installed ? "auth_not_subscription" : "unavailable"), {
		ok: installed && usesSubscription,
		resourceType: "native_harness_status",
		adapter: "official_cli",
		cli: { name: "claude", installed, valuesPrinted: false },
		version,
		auth: {
			loggedIn: authJson.loggedIn === true,
			authMethod: authJson.authMethod || null,
			apiProvider: authJson.apiProvider || null,
			email: authJson.email || null,
			subscriptionType: authJson.subscriptionType || null,
			usesSubscription,
			checkedWithAnthropicEnvUnset: true,
		},
		checks: {
			anthropicEnvPresent: Boolean(process.env.ANTHROPIC_API_KEY),
			delegateRemovesAnthropicEnv: true,
		},
		nativeDelegateModel: "native/claude-cli",
	});
}

function callAntigravity(operation) {
	const known = ["status"];
	if (!known.includes(operation)) return unsupportedOperation("antigravity", operation, known);
	const cli = path.join(os.homedir(), ".local", "bin", "agy");
	const installed = commandExists(cli);
	const version = installed ? runProviderCli(cli, ["--version"], { timeout: 20_000 }) : { ok: false, skipped: true };
	return providerEnvelope("antigravity", operation, installed ? "success" : "unavailable", {
		ok: installed,
		resourceType: "native_harness_status",
		adapter: "official_cli",
		cli: { name: cli, installed, valuesPrinted: false },
		version,
		files: filePresence([
			path.join(os.homedir(), ".gemini", "antigravity-cli", "settings.json"),
			path.join(os.homedir(), ".gemini", "antigravity-cli", "log"),
		]),
		nativeDelegateModel: "native/agy",
	});
}

function editDistance(left, right) {
	const a = String(left || "");
	const b = String(right || "");
	const row = Array.from({ length: b.length + 1 }, (_, index) => index);
	for (let i = 1; i <= a.length; i++) {
		let previous = row[0];
		row[0] = i;
		for (let j = 1; j <= b.length; j++) {
			const current = row[j];
			row[j] = Math.min(row[j] + 1, row[j - 1] + 1, previous + (a[i - 1] === b[j - 1] ? 0 : 1));
			previous = current;
		}
	}
	return row[b.length];
}

function suggestOperations(operation, allowed) {
	const requested = String(operation || "").toLowerCase();
	return [...new Set((allowed || []).map(String))]
		.map((candidate) => {
			const canonical = candidate.toLowerCase();
			const prefixBonus = canonical.startsWith(requested) || requested.startsWith(canonical) ? -3 : 0;
			const tokenBonus = canonical.split("-").some((token) => requested.includes(token) || token.includes(requested)) ? -1 : 0;
			return { candidate, score: editDistance(requested, canonical) + prefixBonus + tokenBonus };
		})
		.sort((a, b) => a.score - b.score || a.candidate.localeCompare(b.candidate))
		.slice(0, 5)
		.map(({ candidate }) => candidate);
}

function unsupportedOperation(provider, operation, allowed) {
	const suggestions = suggestOperations(operation, allowed);
	const hint = suggestions.length > 0 ? ` Try: ${suggestions.join(", ")}.` : "";
	return providerError(provider, operation, "unsupported_operation", {
		allowed,
		suggestions,
		message: `Unsupported operation "${operation}".${hint} Use discover for the full canonical operation list.`,
	});
}


// Args a mutating operation should not forward to the provider CLI: they are
// Toolbelt's own routing/approval inputs, not the provider's flags.
const TOOLBELT_ARG_KEYS = new Set(["account", "project", "profile", "reason", "confirmMutating", "confirm_mutating", "target"]);

function kebab(key) {
	return String(key).replace(/([a-z0-9])([A-Z])/g, "$1-$2").replace(/_/g, "-").toLowerCase();
}

/** Project an args object onto conventional CLI flags. */
function projectArgsToFlags(args) {
	const out = [];
	for (const [key, value] of Object.entries(args || {})) {
		if (TOOLBELT_ARG_KEYS.has(key) || value === undefined || value === null) continue;
		const flag = `--${kebab(key)}`;
		if (value === true) out.push(flag);
		else if (value === false) continue;
		else if (Array.isArray(value)) for (const item of value) out.push(flag, String(item));
		else out.push(flag, String(value));
	}
	return out;
}

/**
 * Execute an operation the adapter only described. Approval envelopes already
 * carry the provider command and its subcommand path, so rather than refusing a
 * mutation the dispatcher completes it. Replaces the approval gate the operator asked
 * to remove.
 */
function executeDescribedOperation(canonical, operation, args, envelope) {
	const command = typeof envelope.command === "string" ? envelope.command : null;
	const argv = Array.isArray(envelope.argv) ? envelope.argv.map(String) : null;
	if (!command || !argv || argv.length === 0) return null;
	if (argv.some((part) => part.startsWith("<"))) return null; // placeholder, not a real path
	if (!commandExists(command)) return providerUnavailable(canonical, command, operation);
	const cliArgs = [...argv, ...projectArgsToFlags(args)];
	const secretFlag = secretFlagInArgv(cliArgs);
	if (secretFlag) {
		return providerError(canonical, operation, "secret_value_in_argv_rejected", {
			flag: secretFlag,
			message: "Secret values must not travel in argv. Use the provider's own file/stdin mechanism.",
		});
	}
	const result = runProviderCli(command, cliArgs, { timeout: 180_000, keepStdout: true });
	return providerResult(canonical, operation, `${canonical}_mutation`, result, {
		operationClass: "mutating_network",
		mutating: true,
	});
}

// A `call` envelope that refuses an operation must not be the only way to reach
// it. When the adapter already knew the provider command and its subcommand
// path, hand back the exact `run` line that executes the same thing. Placeholder
// argv or a command that does not match the catalog CLI fabricates nothing.
function runAlternative(provider, result) {
	if (!result || typeof result !== "object") return null;
	const command = typeof result.command === "string" ? result.command : null;
	const argv = Array.isArray(result.argv) ? result.argv.map(String) : null;
	if (!command || !argv || argv.length === 0) return null;
	if (argv.some((part) => part.startsWith("<") || part === "...")) return null;
	const cli = resolveCli(catalogEntry(provider));
	if (!cli || cli.command !== command) return null;
	const quote = (value) => (/^[A-Za-z0-9._:/=@%+-]+$/.test(value) ? value : `'${value.replace(/'/g, "'\\''")}'`);
	return `pi-toolbelt run ${provider} -- ${argv.map(quote).join(" ")}`;
}

const CALL_REFUSAL_STATUSES = new Set(["approval_required", "blocked_operation", "unsupported_operation", "approved_mutation_not_implemented", "secure_secret_sink_required", "adapter_not_implemented"]);

function annotateCallRefusal(canonical, result) {
	if (!result || typeof result !== "object") return result;
	if (!CALL_REFUSAL_STATUSES.has(String(result.status || ""))) return result;
	const exact = canonical ? runAlternative(canonical, result) : null;
	if (exact) result.runAlternative = exact;
	else if (canonical) result.runAlternativeHint = `No structured alias maps this operation. The provider CLI is still reachable: \`pi-toolbelt menu ${canonical}\` then \`pi-toolbelt run ${canonical} -- <command> [flags]\`.`;
	return result;
}

function callInfisical(operation, args = {}) {
	const cli = "infisical";
	if (operation !== "status") return unsupportedOperation("infisical", operation, ["status"]);
	if (!commandExists(cli)) return providerUnavailable("infisical", cli, operation);
	const version = runProviderCli(cli, ["--version"], { timeout: 15_000 });
	let loginEmail = null;
	const configPath = path.join(os.homedir(), ".infisical", "infisical-config.json");
	try {
		const config = JSON.parse(fs.readFileSync(configPath, "utf8"));
		if (typeof config.loggedInUserEmail === "string" && config.loggedInUserEmail.includes("@")) loginEmail = config.loggedInUserEmail;
	} catch {}
	const linked = [];
	try {
		for (const entry of fs.readdirSync(path.join(os.homedir(), "projects"), { withFileTypes: true })) {
			if (!entry.isDirectory()) continue;
			const linkPath = path.join(os.homedir(), "projects", entry.name, ".infisical.json");
			if (!fs.existsSync(linkPath)) continue;
			try {
				const link = JSON.parse(fs.readFileSync(linkPath, "utf8"));
				linked.push({ project: entry.name, workspaceId: link.workspaceId || null });
			} catch {}
		}
	} catch {}
	return providerEnvelope("infisical", operation, "success", {
		ok: true,
		cli: { name: cli, installed: true, version: String(version.stdout || "").trim().split(/\r?\n/).pop() || null, valuesPrinted: false },
		info: {
			loggedIn: loginEmail !== null,
			loginEmail,
			configPath,
			linkedProjects: linked,
			serviceTokenEnvVarPresent: Boolean(process.env.INFISICAL_TOKEN),
			valuesPrinted: false,
			canonicalKeyStore: true,
		},
	});
}

async function callProvider(provider, operation, args, parsed) {
	const canonical = canonicalProviderId(provider);
	const routing = resolveAccountContext(canonical, parsed, args);
	if (routing.error) return routing.error;
	const catalog = PROVIDER_CATALOG.find((item) => item.id === canonical);
	const mutating = Boolean(catalog && Array.isArray(catalog.mutatingOperations) && catalog.mutatingOperations.includes(operation));
	// The approvalCapable allowlist is gone. It refused confirmed mutations for
	// ten providers whose adapters had no execution path, which is what made
	// Supabase mutations unreachable even after explicit approval.
	const confirmed = Boolean(parsed && parsed.opts["confirm-mutating"] === true);
	ACTIVE_ACCOUNT_CONTEXT = routing.context;
	let result;
	try {
		const missingReadId = operation.endsWith("-get") && !requiredArg(args, ["id", "domainId", "emailId", "broadcastId", "contactId", "templateId"]);
		// Was `&& !mutating`, which skipped the proof precisely where a wrong
		// account does damage. Mutations now verify; reads still skip when a
		// required id is absent and the call cannot reach the provider anyway.
		const identityRequired = operation !== "status" && !missingReadId;
		const identity = identityRequired ? verifyActiveAccountIdentity(routing.context) : { ok: true, observedIdentity: null };
		if (!identity.ok) {
			result = providerError(canonical, operation, identity.reason || "account_identity_unavailable", { account: routing.context.alias, expectedIdentity: routing.context.expectedIdentity, observedIdentity: identity.observedIdentity, message: "The selected official CLI profile did not prove the bound account identity." });
		} else if (canonical === "vercel") result = callVercel(operation, args, confirmed);
		else if (canonical === "railway") result = callRailway(operation, args);
		else if (canonical === "supabase") result = await callSupabase(operation, args, parsed);
		else if (canonical === "github") result = callGithub(operation, args);
		else if (canonical === "stripe") result = callStripe(operation, args);
		else if (canonical === "resend") result = callResend(operation, args, parsed);
		else if (canonical === "audible") result = callAudible(operation, args);
		else if (canonical === "notebooklm") result = callNotebooklm(operation, args, parsed);
		else if (canonical === "google-workspace") result = callGoogleWorkspace(operation, args, parsed);
		else if (canonical === "sentry") result = callSentry(operation, args);
		else if (canonical === "tailscale") result = callTailscale(operation, args);
		else if (canonical === "pixellab") result = callPixellab(operation, args);
		else if (canonical === "runware") result = callRunware(operation, args);
		else if (canonical === "youtube") result = callYoutube(operation, args, parsed);
		else if (canonical === "stitch") result = callStitch(operation, args, parsed);
		else if (canonical === "portal-bg") result = callPortalBg(operation, args, parsed);
		else if (canonical === "pally") result = callPally(operation, args, parsed);
		else if (canonical === "studio") result = callStudio(operation, args, parsed);
		else if (canonical === "vps") result = callVPS host(operation, args, parsed);
		else if (canonical === "infisical") result = callInfisical(operation, args);
		else if (canonical === "claude-code") result = callClaudeCode(operation);
		else if (canonical === "antigravity") result = callAntigravity(operation);
		else if (canonical === "media-hub") result = mediaHub.callMediaHub(operation, args, { parsed, spawn: runProviderCli, exists: commandExists, result: providerResult, error: providerError, unavailable: providerUnavailable, unsupported: unsupportedOperation });
		else if (!result) result = providerError(canonical || null, operation || null, "adapter_not_implemented", { message: "No provider adapter is implemented for this provider yet." });
	} finally {
		ACTIVE_ACCOUNT_CONTEXT = null;
	}
	// An adapter that only described the operation now gets completed here.
	if (result && typeof result === "object" && result.status === "approval_required") {
		const executed = executeDescribedOperation(canonical, operation, args, result);
		if (executed) result = executed;
	}
	// Anything still refusing the structured alias names the exact passthrough
	// that reaches the CLI instead of leaving the capability hidden.
	result = annotateCallRefusal(canonical, result);
	if (routing.context && result && typeof result === "object") {
		result.routing = { account: routing.context.alias, profile: routing.context.profile, project: routing.context.project, source: routing.context.source, credentialsStoredByToolbelt: false, valuesPrinted: false };
	}
	return result;
}

// ---------------------------------------------------------------------------
// Capability index: providers / menu / run / refresh-surface
//
// `call` keeps the curated named operations. These commands expose whatever
// the provider CLI itself can do, so no capability is reachable only by
// bypassing Toolbelt.
// ---------------------------------------------------------------------------

const IDENTITY_CACHE_FILE = path.join(DATA_DIR, "identity-cache.json");
const IDENTITY_TTL_MS = Number(process.env.PI_TOOLBELT_IDENTITY_TTL_MS) || 600_000;
const MENU_INLINE_TOKEN_BUDGET = Number(process.env.PI_TOOLBELT_MENU_BUDGET) || 2000;

function catalogEntry(provider) {
	return PROVIDER_CATALOG.find((item) => item.id === canonicalProviderId(provider)) || null;
}

// Catalog `cli` may carry prefix args ("npx neonctl", "python3 -m pally_app").
function resolveCli(entry) {
	if (!entry || !entry.cli) return null;
	const parts = String(entry.cli).trim().split(/\s+/);
	return { command: parts[0], prefix: parts.slice(1) };
}

// Secrets must never transit argv, where they are visible to `ps` and to any
// process-tree reader. Rejected here rather than redacted after the fact.
function secretFlagInArgv(argv) {
	for (let i = 0; i < argv.length; i++) {
		const arg = String(argv[i]);
		if (!arg.startsWith("-")) continue;
		const [name, inline] = arg.split("=", 2);
		if (!SECRET_NAME_RE.test(name.replace(/^-+/, "")) && !/^-{1,2}(p|pw|pwd|pass)$/i.test(name)) continue;
		const next = argv[i + 1];
		const carriesValue = inline !== undefined || (next !== undefined && !String(next).startsWith("-"));
		if (carriesValue) return name;
	}
	return null;
}

function readIdentityCache() {
	return readJson(IDENTITY_CACHE_FILE, {});
}

function cachedIdentity(context) {
	if (!context) return null;
	const entry = readIdentityCache()[`${context.provider}:${context.profile}`];
	if (!entry || typeof entry.verifiedAt !== "number") return null;
	return Date.now() - entry.verifiedAt <= IDENTITY_TTL_MS ? entry : null;
}

function storeIdentity(context, observedIdentity) {
	if (!context) return;
	const cache = readIdentityCache();
	cache[`${context.provider}:${context.profile}`] = { observedIdentity, verifiedAt: Date.now() };
	writeJson(IDENTITY_CACHE_FILE, cache);
}

// Identity is proved before anything that changes state, and the result is
// cached briefly so the proof does not double the latency of every call.
function ensureVerifiedIdentity(context, cwd = undefined) {
	if (!context) return { ok: true, observedIdentity: null, source: "no_account_context" };
	const cached = cachedIdentity(context);
	if (cached) {
		// The cache is keyed by provider:profile, but two aliases can share a
		// profile with different expectedIdentity pins. Re-check the pin against
		// the cached observation instead of trusting the cache blindly.
		if (context.expectedIdentity) {
			const expected = [].concat(context.expectedIdentity).map((value) => String(value).toLowerCase());
			const observedList = String(cached.observedIdentity || "").split(",").filter(Boolean);
			const ok = observedList.length > 0 && observedList.some((id) => expected.includes(id.toLowerCase()));
			if (!ok) return { ok: false, observedIdentity: cached.observedIdentity, source: "cache" };
		}
		return { ok: true, observedIdentity: cached.observedIdentity, source: "cache" };
	}
	const identity = verifyActiveAccountIdentity(context, cwd);
	if (identity.ok) storeIdentity(context, identity.observedIdentity);
	return { ...identity, source: "probe" };
}

function providerSurface(provider) {
	const canonical = canonicalProviderId(provider);
	// The id becomes a file name under data/surface. Anything outside a plain
	// provider slug would let `menu ../../x` read arbitrary JSON, so reject it
	// before it reaches the read rather than sanitizing afterwards.
	if (!/^[a-z0-9][a-z0-9-]*$/.test(canonical)) return null;
	return surfaceLib.readSurface(CATALOG_DIR, canonical);
}

const POLICY_CACHE = new Map();
function providerPolicy(provider) {
	const canonical = canonicalProviderId(provider);
	if (!POLICY_CACHE.has(canonical)) POLICY_CACHE.set(canonical, policyLib.readPolicy(CATALOG_DIR, canonical));
	return POLICY_CACHE.get(canonical);
}

function classifierFor(provider) {
	const policy = providerPolicy(provider);
	return (argv, leaf) => policyLib.classify(policy, argv, leaf).class;
}

function allSurfaces() {
	return PROVIDER_CATALOG
		.map((entry) => ({ provider: entry.id, surface: providerSurface(entry.id) }))
		.filter((row) => row.surface);
}

function cmdFind(parsed) {
	const query = [parsed.opts.query, ...parsed.positional.slice(1)].filter((value) => typeof value === "string" && value.trim()).join(" ").trim();
	if (!query) return { ok: false, error: "find_requires_a_query", hint: 'pi-toolbelt find "deployment logs"' };
	const only = parsed.opts.provider ? canonicalProviderId(parsed.opts.provider) : null;
	const surfaces = allSurfaces().filter((row) => !only || row.provider === only);
	const hits = surfaceLib.searchSurfaces(surfaces, query, { limit: Number(parsed.opts.limit) || 15 });
	const text = surfaceLib.renderSearch(hits, query, (provider, argv, leaf) => classifierFor(provider)(argv, leaf));
	if (!parsed.flags.json) return text;
	return {
		ok: hits.length > 0,
		schemaVersion: 1,
		query,
		text,
		matches: hits.map(({ provider, leaf }) => ({ provider, command: leaf.cmd, flags: leaf.flags, description: leaf.desc || null, operationClass: classifierFor(provider)(leaf.cmd.split(" "), leaf) })),
	};
}

function cmdProviders(parsed) {
	const registry = readAccountRegistry();
	const wantAll = parsed.opts.all === true;
	const rows = [];
	for (const entry of PROVIDER_CATALOG) {
		const cli = resolveCli(entry);
		const surface = providerSurface(entry.id);
		// Installed means the binary resolves on disk/PATH. A cached surface only
		// proves the walker once ran; treating it as installed reported CLIs as
		// present after they were uninstalled, so the two are tracked separately.
		const installed = Boolean(cli && commandExists(cli.command));
		if (!installed && !wantAll) continue;
		const accounts = Object.entries(registry.accounts)
			.filter(([, account]) => account && canonicalProviderId(account.provider) === entry.id && account.enabled !== false)
			.map(([alias]) => alias);
		rows.push({ id: entry.id, cli: cli ? cli.command : null, installed, surface: Boolean(surface), commands: surface ? surface.leafCount : null, accounts });
	}
	if (parsed.flags.json) {
		return { ok: true, schemaVersion: 1, providers: rows, text: renderProviders(rows), hint: "pi-toolbelt menu <provider> loads that provider's command menu.", valuesPrinted: false };
	}
	return renderProviders(rows);
}

// The rendered menu IS the answer for these commands, so it travels in `text`
// where a consumer can pass it through verbatim instead of summarising it away.
function renderProviders(rows) {
	const lines = [`# ${rows.length} provider CLIs available`, "# menu: pi-toolbelt menu <provider> [group]", ""];
	for (const row of rows) {
		const parts = [row.id];
		parts.push(row.installed ? "installed" : "not installed");
		if (row.commands) parts.push(`${row.commands} cmds`);
		else if (row.surface) parts.push("surface cached");
		else parts.push("no surface (run refresh-surface)");
		if (row.accounts.length > 0) parts.push(`accounts: ${row.accounts.join(",")}`);
		lines.push(parts.join("  |  "));
	}
	return lines.join("\n");
}

function cmdMenu(parsed) {
	const provider = canonicalProviderId(parsed.opts.provider || parsed.positional[1] || "");
	if (!provider) return { ok: false, error: "menu_requires_provider", hint: "pi-toolbelt providers" };
	if (!/^[a-z0-9][a-z0-9-]*$/.test(provider)) return { ok: false, error: "unknown_provider", provider: null, hint: "pi-toolbelt providers" };
	// Catalog membership is checked before the surface lookup: a provider Toolbelt
	// does not register has no surface to generate, so `refresh-surface` would
	// answer `unknown_provider` anyway. Catalog members without a surface still
	// report `surface_not_generated` below.
	if (!PROVIDER_CATALOG.some((entry) => entry.id === provider)) {
		return { ok: false, error: "unknown_provider", provider, hint: "pi-toolbelt providers" };
	}
	const group = parsed.opts.group || parsed.positional[2] || null;
	const surface = providerSurface(provider);
	if (!surface) {
		return { ok: false, provider, error: "surface_not_generated", hint: `pi-toolbelt refresh-surface ${provider}` };
	}
	const stale = surfaceLib.isStale(surface);
	if (group) {
		const text = surfaceLib.renderMenu(surface, { group: String(group), provider, classify: classifierFor(provider) });
		if (!text) {
			const groups = [...surfaceLib.groupCounts(surface).keys()].sort();
			return { ok: false, provider, error: "unknown_group", group: String(group), groups };
		}
		return parsed.flags.json ? { ok: true, provider, group: String(group), stale, menu: text, text } : text;
	}
	const full = surfaceLib.renderMenu(surface, { provider, classify: classifierFor(provider) });
	const inline = surfaceLib.estimateTokens(full) <= MENU_INLINE_TOKEN_BUDGET;
	const text = inline ? full : surfaceLib.renderGroupIndex(surface);
	if (parsed.flags.json) {
		return { ok: true, provider, mode: inline ? "full" : "group_index", commands: surface.leafCount, stale, menu: text, text };
	}
	return stale ? `${text}\n\n# note: ${surface.cli} has been updated since this menu was generated; run refresh-surface ${provider}` : text;
}

function cmdRefreshSurface(parsed) {
	const requested = canonicalProviderId(parsed.opts.provider || parsed.positional[1] || "");
	const targets = requested
		? PROVIDER_CATALOG.filter((entry) => entry.id === requested)
		: PROVIDER_CATALOG.filter((entry) => String(entry.status).startsWith("implemented"));
	if (targets.length === 0) return { ok: false, error: "unknown_provider", provider: requested || null };
	const results = [];
	for (const entry of targets) {
		const cli = resolveCli(entry);
		if (!cli || !commandExists(cli.command)) {
			results.push({ provider: entry.id, status: "cli_not_installed" });
			continue;
		}
		try {
			let surface = surfaceLib.walkCli(cli.command, { prefix: cli.prefix });
			// Generated CLIs take "<operation> --args <json>" and expose no help
			// tree, so their menu comes from the operation lists in the catalog.
			if (surface.leafCount <= 1) {
				const derived = catalogDerivedSurface(entry, cli, surface);
				if (derived) surface = derived;
			}
			// A surface whose grammar was hand-verified against the generated
			// CLI's own dispatch (runware, stitch) is a better authority than the
			// catalog: that CLI derives nothing from --help, and the catalog lists
			// hyphen-joined names it does not accept ("video-upscale" against the
			// verified "video video-upscale" two-token form). Refresh re-stamps
			// only the CLI provenance and keeps the verified leaves.
			const existing = surfaceLib.readSurface(CATALOG_DIR, entry.id);
			if (existing && existing.source === "generated_cli_source") {
				surface = {
					...existing,
					cli: surface.cli,
					cliVersion: surface.cliVersion,
					cliPath: surface.cliPath,
					cliMtimeMs: surface.cliMtimeMs,
					generatedAt: surface.generatedAt,
				};
			}
			surfaceLib.writeSurface(CATALOG_DIR, entry.id, surface);
			results.push({ provider: entry.id, status: "generated", commands: surface.leafCount, cliVersion: surface.cliVersion, menuCost: surfaceLib.estimateTokens(surfaceLib.renderMenu(surface)) });
		} catch (error) {
			results.push({ provider: entry.id, status: "walk_failed", errorClass: error && error.code ? String(error.code) : "exception" });
		}
	}
	return { ok: results.some((row) => row.status === "generated"), schemaVersion: 1, results, valuesPrinted: false };
}

function catalogDerivedSurface(entry, cli, walked) {
	const classes = [
		["safeOperations", "read"],
		["mutatingOperations", "mutate"],
		// The catalog's legacy "blocked" bucket has no policy class: CLASSES is
		// read/mutate/destructive/sensitive, and only the advisory label decides
		// how the agent talks about the command. "sensitive" is that mapping.
		["blockedOperations", "sensitive"],
	];
	const leaves = [];
	for (const [key, operationClass] of classes) {
		for (const operation of entry[key] || []) {
			leaves.push({ cmd: String(operation), flags: ["args"], class: operationClass, desc: null });
		}
	}
	if (leaves.length === 0) return null;
	leaves.sort((a, b) => a.cmd.localeCompare(b.cmd));
	return {
		...walked,
		source: "provider_catalog",
		note: "Operations take a single --args JSON object.",
		leafCount: leaves.length,
		leaves,
	};
}

function runEnvelope(provider, command, fields) {
	return redact({ ok: false, schemaVersion: 1, provider, command, valuesPrinted: false, policy: { secretValuesAccepted: false, valuesPrinted: false }, ...fields });
}

// Failure output is for an LLM that must fix the call on the next try, so it
// names the concrete correction. The provider's own message is usually the
// best correction available; the menu supplies what the provider omits.
const HARNESS_NOISE = /<claude-code-hint\b[^>]*\/?>/g;

function providerMessage(stderr) {
	const text = String(stderr || "").replace(HARNESS_NOISE, "").trim();
	if (!text) return null;
	const line = text.split(/\r?\n/).map((value) => value.trim()).filter(Boolean)
		.find((value) => /^(error|err|fatal)\b/i.test(value)) || text.split(/\r?\n/).map((v) => v.trim()).filter(Boolean)[0];
	return line ? line.replace(/^(error|err|fatal)\s*:?\s*/i, "") : null;
}

function failureHint(surface, providerArgv, result, provider) {
	const stderr = String(result.stderr || "");
	const leaf = surfaceLib.findLeaf(surface, providerArgv);
	const parts = [];

	const unknownFlag = /unknown (?:flag|option|shorthand)[:\s]+(--?[\w-]+)/i.exec(stderr);
	if (unknownFlag && leaf) {
		parts.push(`${unknownFlag[1]} is not valid for "${leaf.cmd}". Valid flags: ${leaf.flags.map((flag) => `--${flag}`).join(" ") || "(none)"}.`);
	} else {
		const message = providerMessage(stderr);
		if (message) parts.push(message);
		// Descriptions carry the usage signature ("[url] Displays the logs...")
		// which is the only place a required positional argument shows up.
		const positional = leaf && /^\[[^\]]+\]|^<[^>]+>/.exec(String(leaf.desc || ""));
		if (positional) parts.push(`"${leaf.cmd}" takes a positional argument ${positional[0]}.`);
	}

	if (!leaf && surface) {
		const words = policyLib.commandWords(providerArgv);
		const suggestions = suggestOperations(words.join(" "), surface.leaves.map((item) => item.cmd));
		parts.push(`"${words.join(" ")}" is not a command in this CLI. Closest: ${suggestions.join(", ")}.`);
	}

	// A provider flag that shares a name with a Toolbelt flag is a common trap:
	// Toolbelt's --project picks the account, the CLI's picks its own project.
	const suggestedFlag = /(?:specify|use|pass|with)\s+(?:a\s+\w+\s+with\s+)?[`'"]?(--[a-z][\w-]*)/i.exec(stderr.replace(HARNESS_NOISE, ""));
	if (suggestedFlag && ["--project", "--scope", "--target", "--reason"].includes(suggestedFlag[1])) {
		parts.push(`${suggestedFlag[1]} here is ${provider}'s own flag: put it after "--", e.g. run ${provider} -- ${policyLib.commandWords(providerArgv).join(" ")} ${suggestedFlag[1]} <value>.`);
	}

	if (parts.length === 0 && leaf && leaf.flags.length > 0) {
		parts.push(`Flags available for "${leaf.cmd}": ${leaf.flags.map((flag) => `--${flag}`).join(" ")}.`);
	}
	return parts.length > 0 ? parts.join(" ") : null;
}

function cmdRun(parsed) {
	const startedAt = Date.now();
	// Two call shapes: `run <provider> -- cmd...` (positional provider) and
	// `run --provider <p> -- cmd...` (flag provider, used by the Pi extension).
	// In the second, the command starts one slot earlier.
	const provider = canonicalProviderId(parsed.opts.provider || parsed.positional[1] || "");
	const providerArgv = parsed.positional.slice(parsed.opts.provider ? 1 : 2).map(String);
	if (!provider) return runEnvelope(null, null, { status: "run_requires_provider", hint: "pi-toolbelt providers" });
	const entry = catalogEntry(provider);
	const cli = resolveCli(entry);
	if (!entry || !cli) return runEnvelope(provider, null, { status: "unknown_provider", hint: "pi-toolbelt providers" });
	if (providerArgv.length === 0) return runEnvelope(provider, null, { status: "run_requires_command", hint: `pi-toolbelt menu ${provider}` });
	// Redact before the string is ever used: it lands in output AND the ledger,
	// and `redact()` alone misses a space-separated "--password <value>" pair.
	const command = redactArgv(providerArgv).join(" ");

	// Everything after `--` is the provider's argv, including flags whose names
	// collide with Toolbelt's own (--account, --timeout-ms, ...). Rejecting them
	// broke passthrough for CLIs that legitimately define the same flag, so a
	// collision is noted but the command still runs verbatim.
	const TOOLBELT_FLAG_NAMES = new Set(["--agent", "--confirm-mutating", "--confirm-destructive", "--reason", "--account", "--allow-unlisted", "--timeout-ms", "--deadline-ms", "--stdin-file", "--cwd"]);
	const collidingFlags = providerArgv.map((arg) => String(arg).split("=")[0]).filter((name) => TOOLBELT_FLAG_NAMES.has(name));

	const secretFlag = secretFlagInArgv(providerArgv);
	if (secretFlag) {
		return runEnvelope(provider, command, {
			status: "secret_value_in_argv_rejected",
			flag: secretFlag,
			message: "Secret values must not travel in argv. Use the provider's own file/stdin mechanism (for example an --env-file or a config the CLI reads itself).",
		});
	}
	if (!commandExists(cli.command)) return runEnvelope(provider, command, { status: "cli_not_installed", cli: entry.cli });

	const surface = providerSurface(provider);
	// The menu is a cache, not an authority. A command whose first word is not
	// indexed still runs: the surface can lag the CLI, generated CLIs expose no
	// help tree, and paths/IDs/URLs are never enumerable. The mismatch travels
	// as a note so the caller knows the menu is behind, not as a refusal.
	const words = policyLib.commandWords(providerArgv);
	const firstWord = words[0];
	const unlistedCommand = Boolean(surface) && firstWord !== undefined && !surface.leaves.some((leaf) => leaf.cmd.split(" ")[0] === firstWord);
	const unlistedNote = unlistedCommand
		? `"${words.join(" ")}" is not in the cached menu for ${provider}; it was still passed to ${cli.command}. Closest menu entries: ${suggestOperations(words.join(" "), surface.leaves.map((leaf) => leaf.cmd)).join(", ")}.`
		: null;
	const policy = policyLib.readPolicy(CATALOG_DIR, provider);
	const verdict = policyLib.classify(policy, providerArgv, surfaceLib.findLeaf(surface, providerArgv));
	const confirmed = parsed.opts["confirm-mutating"] === true;
	const reason = String(parsed.opts.reason || "").trim();

	// Approval gating removed at the operator's instruction: classification is advisory
	// now. The class still travels in the envelope so the agent knows to ask him
	// in chat before a mutating or destructive command — the check is a
	// conversation, not a refusal.

	const routing = resolveAccountContext(provider, parsed, parseArgsObject(parsed));
	if (routing.error) return routing.error;
	// A provider-level profile/config flag after `--` would silently replace the
	// bound account. Refuse the mismatch instead of letting the CLI run as a
	// different login than the one selected and probed.
	const overrideConflict = accountOverrideConflict(routing.context, cli.command, providerArgv);
	if (overrideConflict) return runEnvelope(provider, command, overrideConflict);

	const cwd = parsed.opts.cwd ? resolveExecutionCwd(parsed.opts.cwd) : { path: undefined };
	if (cwd.error) return runEnvelope(provider, command, cwd.error);

	// Git has one dangerous default: it runs in whatever directory Toolbelt was
	// started from. Require an explicit --cwd or the user's own -C so a status,
	// push or reset can never land in the wrong repository. Version/help reads
	// are cwd-independent.
	if (provider === "git" && !cwd.path && !gitHasDashC(providerArgv) && !gitCwdIndependent(providerArgv)) {
		return runEnvelope(provider, command, {
			status: "git_cwd_required",
			message: "git runs where Toolbelt was started unless you point it somewhere. Pass Toolbelt --cwd <repo> before \"--\", or git's own -C <repo> inside the command.",
			hint: "pi-toolbelt run git --cwd /path/to/repo -- status",
		});
	}

	// Local stdin file: read it here so the value never has to travel in argv or
	// appear in output/ledger. Only the fact that stdin was supplied is reported.
	const stdin = parsed.opts["stdin-file"] ? readStdinFile(parsed.opts["stdin-file"]) : { data: undefined };
	if (stdin.error) return runEnvelope(provider, command, stdin.error);
	// A provider may echo the bytes it was handed on stdin — whole, partial or
	// transformed — so no raw output from a stdin run is provable: stdout and
	// stderr could carry those bytes back, and a hint built from them would
	// repeat them. Withhold the body and the derived hint, say why, and keep
	// every execution fact. A sanitizer on top changes nothing, because the
	// payload it produced is withheld as well.
	const stdinFileUsed = stdin.data !== undefined;
	const stdinOutputSuppressedReason = "raw output withheld: a --stdin-file was supplied and the provider may echo those bytes";

	const cliArgs = [...cli.prefix, ...providerArgv];
	if (parsed.opts["dry-run"] === true && policy.dryRunFlag && !providerArgv.includes(policy.dryRunFlag)) cliArgs.push(policy.dryRunFlag);
	if (parsed.opts["dry-run"] === true && !policy.dryRunFlag) {
		return runEnvelope(provider, command, { status: "dry_run_unsupported", message: `${cli.command} exposes no dry-run flag in its policy; run the read equivalent instead.` });
	}

	// `--deadline-ms` covers preflight (account identity probes) plus execution,
	// exactly as `call` does. Nothing resets it mid-run.
	const requestedDeadline = Number(parsed.opts["deadline-ms"]);
	if (Number.isFinite(requestedDeadline)) {
		if (requestedDeadline <= Date.now()) {
			return runEnvelope(provider, command, { status: "deadline_exceeded", message: `The run deadline (${requestedDeadline}) is already in the past.`, hint: `pi-toolbelt run ${provider} --deadline-ms ${Date.now() + 60_000} -- ${words.join(" ")}` });
		}
		ACTIVE_DEADLINE_MS = requestedDeadline;
	}

	// No --timeout-ms and no --deadline-ms means the caller set no budget at
	// all, so the run gets the full operation ceiling. The old 120 s default was
	// a hidden cap on work the caller never asked to bound; runProviderCli still
	// clamps to ACTIVE_DEADLINE_MS, so an explicit budget always wins.
	const runTimeoutMs = Number(parsed.opts["timeout-ms"]) || MAX_OPERATION_TIMEOUT_MS;

	ACTIVE_ACCOUNT_CONTEXT = routing.context;
	let result;
	let identity;
	try {
		// Wrangler proves identity on reads too: a bucket list against the wrong
		// Cloudflare account is silent damage, unlike other providers' reads.
		// The probe runs in the same cwd as execution so a repo-local config can
		// never make the probe pass while the command runs as another login.
		identity = verdict.class === "read" && !(routing.context && routing.context.provider === "wrangler") ? { ok: true, observedIdentity: null, source: "read_only" } : ensureVerifiedIdentity(routing.context, cwd.path);
		if (!identity.ok) {
			return runEnvelope(provider, command, {
				status: identity.reason || "account_identity_unavailable",
				account: routing.context ? routing.context.alias : null,
				expectedIdentity: routing.context ? routing.context.expectedIdentity : null,
				observedIdentity: identity.observedIdentity,
				message: "The bound provider account did not prove its identity, so the command was not run.",
			});
		}
		result = runProviderCli(cli.command, cliArgs, { timeout: runTimeoutMs, keepStdout: true, cwd: cwd.path, input: stdin.data });
	} finally {
		ACTIVE_ACCOUNT_CONTEXT = null;
		ACTIVE_DEADLINE_MS = null;
	}

	const sanitizer = policyLib.sanitizerFor(policy, providerArgv);
	if (sanitizer && result.jsonParsed) {
		result.json = policyLib.applySanitizer(sanitizer, result.json);
		result.stdout = undefined;
	} else if (sanitizer) {
		result.stdout = undefined;
		result.stderr = undefined;
	}

	return runEnvelope(provider, command, {
		ok: Boolean(result.ok),
		status: result.ok ? "success" : (result.timedOut ? "timeout" : (result.spawnError ? "spawn_failed" : (result.signal ? "signaled" : "provider_error"))),
		sanitized: sanitizer || undefined,
		operationClass: verdict.class,
		mutating: verdict.class !== "read",
		dryRun: parsed.opts["dry-run"] === true,
		cwd: cwd.path || null,
		stdinFileUsed: stdinFileUsed,
		// Only the fact of suppression plus its reason; the withheld body never
		// travels, and neither does anything derived from it.
		outputSuppressed: stdinFileUsed ? true : undefined,
		outputSuppressedReason: stdinFileUsed ? stdinOutputSuppressedReason : undefined,
		exitCode: result.exitCode,
		signal: result.signal || undefined,
		timeoutMs: runTimeoutMs,
		durationMs: Date.now() - startedAt,
		deadlineMs: Number.isFinite(requestedDeadline) ? requestedDeadline : null,
		menuChecked: Boolean(surface),
		menuNote: unlistedNote || undefined,
		flagCollisionNote: collidingFlags.length > 0 ? `${collidingFlags.join(", ")} also name Toolbelt flags; everything after \"--\" was passed to ${cli.command} verbatim.` : undefined,
		routing: routing.context ? { account: routing.context.alias, profile: routing.context.profile, source: routing.context.source, identityVerified: identity.observedIdentity, identitySource: identity.source } : null,
		data: stdinFileUsed ? undefined : (result.jsonParsed ? result.json : null),
		stdout: stdinFileUsed ? undefined : (result.jsonParsed ? undefined : result.stdout),
		stderr: stdinFileUsed ? undefined : (result.stderr || undefined),
		hint: stdinFileUsed || result.ok ? undefined : (failureHint(surface, providerArgv, result, provider) || undefined),
	});
}

// git accepts -C either as `-C<path>` or `-C <path>` and it may precede or
// follow the subcommand, so scan for both forms.
function gitHasDashC(argv) {
	return argv.some((arg) => String(arg) === "-C" || String(arg).startsWith("-C"));
}

function gitCwdIndependent(argv) {
	const first = String(argv[0] || "");
	return /^(?:--version|--help|-h|help|version)$/.test(first);
}

function resolveExecutionCwd(value) {
	const requested = String(value || "").trim();
	if (!requested) return { path: undefined };
	let resolved;
	try {
		resolved = fs.realpathSync(requested);
		if (!fs.statSync(resolved).isDirectory()) throw new Error("not_directory");
	} catch {
		return { error: { status: "cwd_not_directory", cwd: requested, message: "--cwd must name an existing directory; nothing was run." } };
	}
	return { path: resolved };
}

const STDIN_FILE_MAX_BYTES = 16 * 1024 * 1024;

function readStdinFile(value) {
	const requested = String(value || "").trim();
	if (!requested) return { data: undefined };
	let resolved;
	let stats;
	try {
		resolved = fs.realpathSync(requested);
		stats = fs.statSync(resolved);
		if (!stats.isFile()) throw new Error("not_file");
	} catch {
		return { error: { status: "stdin_file_unreadable", message: "--stdin-file must name an existing readable file; nothing was run." } };
	}
	if (stats.size > STDIN_FILE_MAX_BYTES) return { error: { status: "stdin_file_too_large", bytes: stats.size, maxBytes: STDIN_FILE_MAX_BYTES } };
	try {
		// Buffer, so binary payloads survive and no encoding turns a secret into
		// an argv-visible string. The path is not echoed; the bytes are not logged.
		return { data: fs.readFileSync(resolved) };
	} catch {
		return { error: { status: "stdin_file_unreadable" } };
	}
}

// Provider CLIs that carry their own account selector must not be allowed to
// override the account Toolbelt bound and just proved.
function accountOverrideConflict(context, cliCommand, argv) {
	if (!context) return null;
	const flagValue = (names) => {
		for (let i = 0; i < argv.length; i++) {
			const arg = String(argv[i]);
			const [name, inline] = arg.split("=", 2);
			if (!names.includes(name)) continue;
			if (inline !== undefined) return inline;
			const next = argv[i + 1];
			return next !== undefined && !String(next).startsWith("-") ? String(next) : true;
		}
		return undefined;
	};
	if (context.provider === "resend" && cliCommand === "resend") {
		const requested = flagValue(["--profile", "-p"]);
		if (requested !== undefined && requested !== context.profile) {
			return { status: "account_profile_mismatch", account: context.alias, boundProfile: context.profile, requestedProfile: requested === true ? null : requested, message: "The command selects a resend profile that is not the bound account profile; nothing was run." };
		}
	}
	if (context.provider === "vercel" && cliCommand === "vercel") {
		const boundConfig = path.join(os.homedir(), ".config", "pi-toolbelt", "accounts", "vercel", context.profile);
		const requestedConfig = flagValue(["--global-config", "-Q"]);
		if (requestedConfig !== undefined && requestedConfig !== true && path.resolve(String(requestedConfig)) !== path.resolve(boundConfig)) {
			return { status: "account_profile_mismatch", account: context.alias, boundProfile: context.profile, message: "The command selects a vercel global config that is not the bound account profile; nothing was run." };
		}
		const requestedScope = flagValue(["--scope", "-S"]);
		if (context.scope && requestedScope !== undefined && requestedScope !== context.scope) {
			return { status: "account_scope_mismatch", account: context.alias, boundScope: context.scope, requestedScope: requestedScope === true ? null : requestedScope, message: "The command selects a vercel scope that is not the bound account scope; nothing was run." };
		}
	}
	return null;
}

async function cmdCall(parsed) {
	const provider = String(parsed.opts.provider || parsed.positional[1] || "").trim().toLowerCase();
	const operation = String(parsed.opts.operation || parsed.opts.op || parsed.positional[2] || "status").trim();
	const args = parseArgsObject(parsed);
	ACTIVE_OPERATION_META = operationTimeoutMetadata(provider, operation, args);
	const requestedDeadline = Number(parsed.opts["deadline-ms"]);
	const latestDeadline = Date.now() + ACTIVE_OPERATION_META.extensionTimeoutMs;
	ACTIVE_DEADLINE_MS = Number.isFinite(requestedDeadline) ? Math.max(Date.now() + 1, Math.min(requestedDeadline, latestDeadline)) : latestDeadline;
	return callProvider(provider, operation, args, parsed);
}

async function main() {
	const startedAt = Date.now();
	const parsed = parseArgv(process.argv.slice(2));
	maybeReexecUnderVault(parsed); // SK6: may re-exec and exit before any provider runs
	const command = parsed.positional[0];
	if (hasSecretInput(parsed)) {
		ensureStorage();
		appendSecretRejectionLedger(startedAt);
		const rejected = { ok: false, error: "secret_like_input_rejected", valuesPrinted: false, valuesStored: false };
		output(rejected, parsed);
		process.exitCode = 2;
		return;
	}
	if (!command || command === "help" || command === "--help" || command === "-h" || parsed.opts.help) {
		output(help(), parsed);
		return;
	}
	if (!COMMANDS.includes(command)) {
		output({ ok: false, error: "unknown_command", command, commands: COMMANDS }, parsed);
		process.exitCode = 2;
		return;
	}
	ensureStorage();
	const handlers = {
		discover: cmdDiscover,
		status: cmdStatus,
		call: cmdCall,
		"operation-meta": cmdOperationMeta,
		accounts: cmdAccounts,
		links: cmdLinks,
		refresh: cmdDiscover,
		link: cmdLink,
		unlink: cmdUnlink,
		ledger: cmdLedger,
		"audit-secrets": cmdAuditSecrets,
		"catalog-check": cmdCatalogCheck,
		inventory: cmdInventory,
		generate: cmdGenerate,
		providers: cmdProviders,
		menu: cmdMenu,
		run: cmdRun,
		"refresh-surface": cmdRefreshSurface,
		find: cmdFind,
	};
	try {
		const result = await handlers[command](parsed);
		appendLedger(command, parsed, result, startedAt);
		output(result, parsed);
	} catch (error) {
		appendLedger(command, parsed, { ok: false, error: "internal_error" }, startedAt, error);
		throw error;
	}
}

main().catch((error) => {
	const message = error && typeof error.message === "string" ? redact(error.message) : "toolbelt_error";
	process.stderr.write(`${message}\n`);
	process.exitCode = 1;
});
